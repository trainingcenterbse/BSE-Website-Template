    },
    "var_d9dbfdff3d02": {
      "type": "variant",
      "label": "الرئيسية — Editorial Agenda",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');\n  .bse-editorial { font-family: 'Cairo', 'Inter', sans-serif; }\n  .bse-editorial .display { font-family: 'Cairo', 'Inter', sans-serif; letter-spacing: -0.04em; line-height: .98; }\n  .bse-editorial .hairline-grid {\n    background-image: linear-gradient(rgba(255,255,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.07) 1px, transparent 1px);\n    background-size: 64px 64px;\n    mask-image: linear-gradient(to bottom, black, transparent 86%);\n  }\n  .bse-editorial .hero-ring { position: absolute; border: 1px solid rgba(208,224,255,.22); border-radius: 9999px; pointer-events: none; }\n  .bse-editorial .hero-ring::after { content: ''; position: absolute; inset: 12%; border: 1px solid rgba(208,224,255,.12); border-radius: 9999px; }\n  .bse-editorial .ring-one { width: 720px; height: 720px; left: -190px; top: -260px; animation: bse-ring-drift 18s ease-in-out infinite alternate; }\n  .bse-editorial .ring-two { width: 480px; height: 480px; left: 90px; bottom: -230px; animation: bse-ring-drift 22s ease-in-out infinite alternate-reverse; }\n  .bse-editorial .ring-three { width: 170px; height: 170px; right: 9%; top: 15%; border-color: rgba(206,224,255,.32); animation: bse-ring-drift 14s ease-in-out infinite alternate; }\n  .bse-editorial .ring-three::after { inset: 16%; border-color: rgba(206,224,255,.24); }\n  .bse-editorial .seal-line { position: absolute; inset: 8px; border: 1px solid rgba(20,75,183,.42); border-radius: 9999px; }\n  .bse-editorial .seal-line::after { content: ''; position: absolute; inset: 9px; border: 1px solid rgba(20,75,183,.24); border-radius: 9999px; }\n  .bse-editorial .fallback { display: none; }\n  .bse-editorial .image-frame img[aria-hidden='true'] + .fallback { display: flex; }\n  .bse-editorial .agenda-rule { position: relative; }\n  .bse-editorial .agenda-rule::before { content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 3px; background: #1a5bd7; }\n  @keyframes bse-ring-drift { from { transform: translate3d(0,0,0) rotate(0deg); } to { transform: translate3d(18px,-12px,0) rotate(5deg); } }\n  @media (prefers-reduced-motion: reduce) { .bse-editorial .ring-one, .bse-editorial .ring-two, .bse-editorial .ring-three { animation: none; } }\n</style>\n<div class=\"bse-editorial min-h-screen bg-[#f7f9fd] text-[#18223d]\" data-kid=\"1\" data-name=\"editorial page container\" dir=\"rtl\" lang=\"ar\">\n    <div class=\"border-t-4 border-[#1a5bd7] bg-[#101a3d] text-white\" data-kid=\"1-1\" data-name=\"top utility bar\">\n        <div class=\"mx-auto flex max-w-[1160px] items-center justify-between gap-6 px-8 py-2 text-xs font-semibold tracking-wide text-[#d8e5ff]\" data-kid=\"1-1-1\" data-name=\"utility bar container\">\n            <span data-kid=\"1-1-1-1\" data-name=\"organization info text\">\n                جمعية المهندسين البحرينية · منذ 1972\n            </span>\n            <span class=\"hidden sm:inline text-white/65\" data-kid=\"1-1-1-2\" data-name=\"tagline text\">\n                مملكة البحرين · مجتمع هندسي يصنع أثرًا\n            </span>\n        </div>\n    </div>\n    <header class=\"sticky top-0 z-30 border-b border-[#dce5f2] bg-[#f7f9fd]/95 backdrop-blur-sm\" data-kid=\"1-2\" data-name=\"sticky navigation header\">\n        <div class=\"mx-auto flex max-w-[1160px] items-center justify-between gap-8 px-8 py-5\" data-kid=\"1-2-1\" data-name=\"nav layout container\">\n            <a class=\"flex items-center gap-3 text-[#12204a] no-underline\" data-kid=\"1-2-1-1\" data-name=\"brand logo and name link\" href=\"#top\">\n                <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"h-12 w-12 rounded-full object-contain\" data-kid=\"1-2-1-1-1\" data-name=\"bse logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                <span class=\"flex flex-col leading-tight\" data-kid=\"1-2-1-1-2\" data-name=\"brand name text group\">\n                    <span class=\"text-[15px] font-extrabold text-[#1354c7]\" data-kid=\"1-2-1-1-2-1\" data-name=\"brand name line one\">\n                        جمعية المهندسين\n                    </span>\n                    <span class=\"text-[15px] font-extrabold text-[#1354c7]\" data-kid=\"1-2-1-1-2-2\" data-name=\"brand name line two\">\n                        البحرينية\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"hidden items-center gap-8 text-[15px] font-semibold text-[#53617b] lg:flex\" data-kid=\"1-2-1-2\" data-name=\"main navigation menu\">\n                <a class=\"no-underline hover:text-[#1354c7]\" data-kid=\"1-2-1-2-1\" data-name=\"about us link\" href=\"#about\">\n                    عن الجمعية\n                </a>\n                <a class=\"no-underline hover:text-[#1354c7]\" data-kid=\"1-2-1-2-2\" data-name=\"services link\" href=\"#services\">\n                    ما نقدمه\n                </a>\n                <a class=\"no-underline hover:text-[#1354c7]\" data-kid=\"1-2-1-2-3\" data-name=\"agenda link\" href=\"#agenda\">\n                    الأجندة\n                </a>\n                <a class=\"no-underline hover:text-[#1354c7]\" data-kid=\"1-2-1-2-4\" data-name=\"media center link\" href=\"#media\">\n                    المركز الإعلامي\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-3\" data-name=\"cta and language toggle container\">\n                <button class=\"min-h-11 rounded-lg border border-[#cbd7ea] bg-transparent px-4 text-xs font-bold text-[#31415f] hover:border-[#1354c7] hover:text-[#1354c7]\" data-kid=\"1-2-1-3-1\" data-name=\"language switch button\" type=\"button\">\n                    AR\n                    <span class=\"mx-1 text-[#9aa7bd]\" data-kid=\"1-2-1-3-1-1\" data-name=\"language separator\">\n                        /\n                    </span>\n                    EN\n                </button>\n                <a class=\"hidden min-h-11 items-center rounded-lg bg-[#1354c7] px-5 text-sm font-bold text-white no-underline shadow-sm hover:bg-[#0e429e] sm:inline-flex\" data-kid=\"1-2-1-3-2\" data-name=\"membership center link\" href=\"#membership\">\n                    مركز العضوية\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-3\" data-name=\"main page content\" id=\"top\">\n        <section class=\"relative overflow-hidden bg-[#101a3d] text-white\" data-kid=\"1-3-1\" data-name=\"hero section\">\n            <div class=\"hairline-grid pointer-events-none absolute inset-0 opacity-60\" data-kid=\"1-3-1-1\" data-name=\"hairline background grid\">\n            </div>\n            <div class=\"hero-ring ring-one\" data-kid=\"1-3-1-2\" data-name=\"decorative drifting ring one\">\n            </div>\n            <div class=\"hero-ring ring-two\" data-kid=\"1-3-1-3\" data-name=\"decorative drifting ring two\">\n            </div>\n            <div class=\"hero-ring ring-three\" data-kid=\"1-3-1-4\" data-name=\"decorative drifting ring three\">\n            </div>\n            <div class=\"relative mx-auto grid max-w-[1160px] items-center gap-16 px-8 py-20 lg:grid-cols-[1fr_1.06fr] lg:gap-20 lg:py-24\" data-kid=\"1-3-1-5\" data-name=\"hero grid layout container\">\n                <div class=\"order-1 max-w-[560px]\" data-kid=\"1-3-1-5-1\" data-name=\"hero content column\">\n                    <div class=\"mb-7 inline-flex items-center gap-2 rounded-full border border-[#bdd2ff]/35 bg-[#d9e5ff]/10 px-4 py-2 text-xs font-bold text-[#d9e5ff]\" data-kid=\"1-3-1-5-1-1\" data-name=\"hero announcement label\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#8eb6ff]\" data-kid=\"1-3-1-5-1-1-1\" data-name=\"label bullet point\">\n                        </span>\n                        أجندة 2026 · صوت المهندس البحريني\n                    </div>\n                    <h1 class=\"display max-w-[560px] text-5xl font-bold text-white md:text-6xl\" data-kid=\"1-3-1-5-1-2\" data-name=\"hero headline\">\n                        نُهندس أثرًا\n                        <br data-kid=\"1-3-1-5-1-2-1\" data-name=\"headline line break\"/>\n                        <span class=\"text-[#a9c6ff]\" data-kid=\"1-3-1-5-1-2-2\" data-name=\"headline accent text\">\n                            يمتد إلى المستقبل\n                        </span>\n                    </h1>\n                    <p class=\"mt-7 max-w-[520px] text-lg leading-9 text-[#d6e0f3]\" data-kid=\"1-3-1-5-1-3\" data-name=\"hero description text\">\n                        جمعية مهنية تجمع مهندسي البحرين من مختلف التخصصات، وترفع مستوى المهنة، وتحوّل المعرفة والشراكات إلى أثرٍ هندسي مستدام.\n                    </p>\n                    <div class=\"mt-9 flex items-center gap-5\" data-kid=\"1-3-1-5-1-4\" data-name=\"hero cta container\">\n                        <a class=\"inline-flex min-h-12 items-center gap-3 rounded-lg bg-[#d7e5ff] px-6 text-[15px] font-extrabold text-[#10204d] no-underline hover:bg-white\" data-kid=\"1-3-1-5-1-4-1\" data-name=\"explore agenda button\" href=\"#agenda\">\n                            استكشف أجندة الجمعية\n                            <span aria-hidden=\"true\" class=\"text-lg\" data-kid=\"1-3-1-5-1-4-1-1\" data-name=\"explore agenda arrow\">\n                                ←\n                            </span>\n                        </a>\n                        <span class=\"text-sm font-semibold text-[#b9c8e3]\" data-kid=\"1-3-1-5-1-4-2\" data-name=\"founding year text\">\n                            منذ عام 1972\n                        </span>\n                    </div>\n                    <div class=\"mt-12 flex flex-wrap gap-x-8 gap-y-3 text-xs font-semibold text-[#9eb2d7]\" data-kid=\"1-3-1-5-1-5\" data-name=\"hero highlights container\">\n                        <span data-kid=\"1-3-1-5-1-5-1\" data-name=\"highlight one\">\n                            عضوية مهنية\n                        </span>\n                        <span data-kid=\"1-3-1-5-1-5-2\" data-name=\"highlight two\">\n                            تطوير مستمر\n                        </span>\n                        <span data-kid=\"1-3-1-5-1-5-3\" data-name=\"highlight three\">\n                            شراكات دولية\n                        </span>\n                    </div>\n                </div>\n                <div class=\"relative order-2 mx-auto w-full max-w-[520px] lg:mx-0\" data-kid=\"1-3-1-5-2\" data-name=\"hero image column\">\n                    <div class=\"relative overflow-hidden rounded-xl border border-[#b7ccf3]/45 bg-[#172552] p-3 shadow-[0_22px_54px_rgba(2,8,29,.35)]\" data-kid=\"1-3-1-5-2-1\" data-name=\"hero image frame\">\n                        <div class=\"relative h-[365px] overflow-hidden rounded-lg bg-[#16234b]\" data-kid=\"1-3-1-5-2-1-1\" data-name=\"hero image container\">\n                            <img alt=\"مشهد معماري من مملكة البحرين\" class=\"h-full w-full object-cover\" data-kid=\"1-3-1-5-2-1-1-1\" data-name=\"hero imagery\" decoding=\"async\" loading=\"lazy\" onerror=\"this.classList.add('hidden'); this.setAttribute('aria-hidden','true'); this.nextElementSibling.classList.remove('hidden');\" src=\"/api/local/images/src/assets/hero-skyline.jpg\"/>\n                            <div class=\"fallback absolute inset-0 flex-col items-center justify-center gap-4 bg-[#172552] text-center text-[#c6d7fa]\" data-dynamic=\"true\" data-kid=\"1-3-1-5-2-1-1-2\" data-name=\"hero image fallback\" data-reason=\"displayed by onerror script\">\n                                <img alt=\"\" aria-hidden=\"true\" class=\"h-16 w-16 opacity-85\" data-kid=\"1-3-1-5-2-1-1-2-1\" data-name=\"fallback logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                                <span class=\"