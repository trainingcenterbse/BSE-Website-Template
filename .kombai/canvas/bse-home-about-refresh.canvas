      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&display=swap');\n  :root {\n    --bse-navy: #071a43;\n    --bse-indigo: #163d91;\n    --bse-blue: #1769d7;\n    --bse-sky: #dcecff;\n    --bse-ink: #15233e;\n    --bse-muted: #64738e;\n    --bse-line: #d9e3f1;\n    --bse-soft: #f5f8fc;\n    --bse-teal: #0d3539;\n    --bse-teal-mid: #15575a;\n  }\n  .bse-ar { font-family: 'Cairo', 'Tajawal', 'Inter', sans-serif; }\n  .bse-en { font-family: 'Inter', 'Cairo', sans-serif; }\n  .emblem-ring { border: 1px solid rgba(184, 218, 255, .48); border-radius: 9999px; position: absolute; inset: 0; }\n  .emblem-ring-1 { animation: emblem-breathe 12s ease-in-out infinite; }\n  .emblem-ring-2 { inset: 11%; border-color: rgba(184, 218, 255, .72); animation: emblem-breathe 12s ease-in-out -4s infinite; }\n  .emblem-ring-3 { inset: 22%; border-color: rgba(255, 255, 255, .84); animation: emblem-breathe 12s ease-in-out -8s infinite; }\n  .emblem-orbit { position: absolute; inset: 8%; border: 1px dashed rgba(183, 219, 255, .45); border-radius: 9999px; transform: rotate(-18deg); animation: emblem-orbit 26s linear infinite; }\n  .emblem-dot { position: absolute; width: 8px; height: 8px; border-radius: 9999px; background: #c9e5ff; box-shadow: 0 0 0 5px rgba(201, 229, 255, .12); }\n  .emblem-dot-a { top: 7%; right: 31%; }\n  .emblem-dot-b { bottom: 18%; left: 10%; width: 6px; height: 6px; background: #7db6ff; }\n  .emblem-dot-c { top: 45%; left: -1%; width: 5px; height: 5px; background: #ffffff; }\n  .emblem-watermark { opacity: .22; pointer-events: none; }\n  .emblem-watermark .emblem-ring { border-color: rgba(23, 105, 215, .22); }\n  .emblem-watermark .emblem-ring-2 { border-color: rgba(23, 105, 215, .16); }\n  .emblem-watermark .emblem-ring-3 { border-color: rgba(23, 105, 215, .13); }\n  .emblem-watermark .emblem-orbit { border-color: rgba(23, 105, 215, .15); }\n  @keyframes emblem-breathe { 0%, 100% { transform: scale(1); opacity: .78; } 50% { transform: scale(1.025); opacity: 1; } }\n  @keyframes emblem-orbit { from { transform: rotate(-18deg); } to { transform: rotate(342deg); } }\n  @media (prefers-reduced-motion: reduce) {\n    .emblem-ring-1, .emblem-ring-2, .emblem-ring-3, .emblem-orbit { animation: none; }\n  }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"bse-ar min-h-screen bg-white text-[var(--bse-ink)] antialiased\" data-kid=\"1\" dir=\"rtl\">\n    <header class=\"relative z-30 border-b border-[var(--bse-line)] bg-white\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-[78px] max-w-[1160px] items-center justify-between gap-8 px-6 lg:px-0\" data-kid=\"1-1-1\">\n            <a aria-label=\"جمعية المهندسين البحرينية\" class=\"flex min-w-[210px] items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"h-12 w-12 rounded-full object-contain\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                <span class=\"leading-tight\" data-kid=\"1-1-1-1-2\">\n                    <span class=\"block text-[13px] font-extrabold tracking-[-.02em] text-[var(--bse-indigo)]\" data-kid=\"1-1-1-1-2-1\">\n                        جمعية المهندسين\n                    </span>\n                    <span class=\"block text-[13px] font-extrabold tracking-[-.02em] text-[var(--bse-indigo)]\" data-kid=\"1-1-1-1-2-2\">\n                        البحرينية\n                    </span>\n                    <span class=\"mt-0.5 block text-[9px] font-medium tracking-[.02em] text-[var(--bse-muted)] bse-en\" data-kid=\"1-1-1-1-2-3\" dir=\"ltr\">\n                        BAHRAIN SOCIETY OF ENGINEERS\n                    </span>\n                </span>\n            </a>\n            <nav aria-label=\"التنقل الرئيسي\" class=\"hidden items-center gap-8 text-sm font-semibold text-[var(--bse-muted)] lg:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"text-[var(--bse-indigo)]\" data-kid=\"1-1-1-2-1\" href=\"#about\">\n                    من نحن\n                </a>\n                <a class=\"hover:text-[var(--bse-indigo)]\" data-kid=\"1-1-1-2-2\" href=\"#agenda\">\n                    الفعاليات\n                </a>\n                <a class=\"hover:text-[var(--bse-indigo)]\" data-kid=\"1-1-1-2-3\" href=\"#learning\">\n                    التدريب\n                </a>\n                <a class=\"hover:text-[var(--bse-indigo)]\" data-kid=\"1-1-1-2-4\" href=\"#news\">\n                    المركز الإعلامي\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-3\">\n                <button aria-label=\"تغيير اللغة\" class=\"grid h-11 w-11 place-items-center rounded-lg border border-[var(--bse-line)] text-[var(--bse-muted)]\" data-kid=\"1-1-1-3-1\">\n                    <span class=\"bse-en text-xs font-bold\" data-kid=\"1-1-1-3-1-1\">\n                        EN\n                    </span>\n                </button>\n                <button aria-label=\"فتح القائمة\" class=\"grid h-11 w-11 place-items-center rounded-lg border border-[var(--bse-line)] text-[var(--bse-muted)] lg:hidden\" data-kid=\"1-1-1-3-2\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-3-2-1\" data-lucide=\"menu\">\n                    </i>\n                </button>\n                <a class=\"hidden rounded-lg bg-[var(--bse-indigo)] px-5 py-3 text-sm font-bold text-white shadow-[0_8px_20px_rgba(7,26,67,.15)] transition hover:bg-[var(--bse-navy)] sm:inline-flex\" data-kid=\"1-1-1-3-3\" href=\"#membership\">\n                    مركز العضوية\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"relative overflow-hidden bg-[var(--bse-navy)] text-white\" data-kid=\"1-2-1\">\n            <div class=\"absolute inset-0 bg-[radial-gradient(circle_at_76%_12%,rgba(73,143,235,.34),transparent_33%),linear-gradient(120deg,#071a43_0%,#0c2b68_52%,#163d91_100%)]\" data-kid=\"1-2-1-1\">\n            </div>\n            <div class=\"relative mx-auto grid min-h-[640px] max-w-[1160px] items-stretch lg:grid-cols-[.92fr_1.08fr]\" data-kid=\"1-2-1-2\">\n                <div class=\"relative order-2 flex flex-col justify-center px-6 py-16 lg:order-1 lg:px-0 lg:pl-14\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"mb-6 flex items-center gap-3 text-[12px] font-bold text-[#b9d8ff]\" data-kid=\"1-2-1-2-1-1\">\n                        <span class=\"h-px w-10 bg-[#8fc1ff]\" data-kid=\"1-2-1-2-1-1-1\">\n                        </span>\n                        <span data-kid=\"1-2-1-2-1-1-2\">\n                            منذ عام 1972 · مجتمع هندسي بحريني\n                        </span>\n                    </div>\n                    <h1 class=\"max-w-[600px] text-4xl font-extrabold leading-[1.1] tracking-[-.04em] text-white sm:text-5xl lg:text-[64px]\" data-kid=\"1-2-1-2-1-2\">\n                        نصنع أثرًا هندسيًا\n                        <br data-kid=\"1-2-1-2-1-2-1\"/>\n                        <span class=\"text-[#a8d0ff]\" data-kid=\"1-2-1-2-1-2-2\">\n                            يمتد إلى المستقبل.\n                        </span>\n                    </h1>\n                    <p class=\"mt-7 max-w-[540px] text-base leading-8 text-[#d6e5fb] sm:text-lg\" data-kid=\"1-2-1-2-1-3\">\n                        المنظمة المهنية التي تجمع مهندسي مملكة البحرين من مختلف التخصصات، وترعى مصالحهم، وترفع مستوى المهنة الهندسية لخدمة المجتمع.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-center gap-4\" data-kid=\"1-2-1-2-1-4\">\n                        <a class=\"inline-flex items-center gap-3 rounded-full bg-[#dcecff] px-6 py-3.5 text-sm font-extrabold text-[var(--bse-navy)] shadow-[0_12px_28px_rgba(0,0,0,.18)] transition hover:bg-white\" data-kid=\"1-2-1-2-1-4-1\" href=\"#about\">\n                            اكتشف الجمعية\n                            <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-4-1-1\" data-lucide=\"arrow-left\" data-name=\"arrow-left icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                            </i>\n                        </a>\n                        <span class=\"flex items-center gap-2 text-sm text-[#bad2f0]\" data-kid=\"1-2-1-2-1-4-2\">\n                            <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-4-2-1\" data-lucide=\"map-pin\" data-name=\"map-pin icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                            </i>\n                            مملكة البحرين\n                        </span>\n                    </div>\n                    <div class=\"mt-12 grid max-w-[600px] grid-cols-2 border-t border-white/20 pt-6 sm:grid-cols-4\" data-kid=\"1-2-1-2-1-5\">\n                        <div class=\"border-l border-white/15 px-3 first:pr-0 sm:px-4\" data-kid=\"1-2-1-2-1-5-1\">\n                            <div class=\"text-2xl font-extrabold text-white\" data-kid=\"1-2-1-2-1-5-1-1\">\n                                +5000\n                            </div>\n                            <div class=\"mt-1 text-xs text-[#b9cce7]\" data-kid=\"1-2-1-2-1-5-1-2\">\n                                عضو نشط\n                            </div>\n                        </div>\n                        <div class=\"border-l border-white/15 px-3 sm:px-4\" data-kid=\"1-2-1-2-1-5-2\">\n                            <div class=\"text-2xl font-extrabold text-white\" data-kid=\"1-2-1-2-1-5-2-1\">\n                                +50\n                            </div>\n                            <div class=\"mt-1 text-xs text-[#b9cce7]\" data-kid=\"1-2-1-2-1-5-2-2\">\n                                شريك استراتيجي\n                            </div>\n                        </div>\n                        <div class=\"border-l border-white/15 px-3 sm:px-4\" data-kid=\"1-2-1-2-1-5-3\">\n                            <div class=\"text-2xl font-extrabold text-white\" data-kid=\"1-2-1-2-1-5-3-1\">\n                                +200\n                            </div>\n                            <div class=\"mt-1 text-xs text-[#b9cce7]\" data-kid=\"1-2-1-2-1-5-3-2\">\n                                فعالية وبرنامج\n                            </div>\n                        </div>\n                        <div class=\"px-3 sm:px-4 sm:pl-0\" data-kid=\"1-2-1-2-1-5-4\">\n                            <div class=\"text-2xl font-extrabold text-white\" data-kid=\"1-2-1-2-1-5-4-1\">\n                                50\n                            </div>\n                            <div class=\"mt-1 text-xs text-[#b9cce7]\" data-kid=\"1-2-1-2-1-5-4-2\">\n                                سنة من الخبرة\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"relative order-1 min-h-[380px] overflow-hidden lg:order-2 lg:min-h-full\" data-kid=\"1-2-1-2-2\">\n                    <img alt=\"مشهد عمراني من مملكة البحرين\" class=\"absolute inset-0 h-full w-full object-cover opacity-80\" data-kid=\"1-2-1-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-skyline.jpg\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-l from-[var(--bse-navy)]/5 via-[var(--bse-navy)]/20 to-[var(--bse-navy)]/80\" data-kid=\"1-2-1-2-2-2\">\n                    </div>\n                    <div class=\"absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-[var(--bse-navy)] to-transparent lg:w-32\" data-kid=\"1-2-1-2-2-3\">\n                    </div>\n                    <div class=\"absolute inset-0 grid place-items-center\" data-kid=\"1-2-1-2-2-4\">\n                        <div class=\"relative h-[290px] w-[290px] sm:h-[350px] sm:w-[350px]\" data-kid=\"1-2-1-2-2-4-1\">\n                            <div class=\"emblem-ring emblem-ring-1\" data-kid=\"1-2-1-2-2-4-1-1\">\n                            </div>\n                            <div class=\"emblem-ring emblem-ring-2\" data-kid=\"1-2-1-2-2-4-1-2\">\n                            </div>\n                            <div class=\"emblem-ring emblem-ring-3\" data-kid=\"1-2-1-2-2-4-1-3\">\n                            </div>\n                            <div class=\"emblem-orbit\" data-kid=\"1-2-1-2-2-4-1-4\">\n                            </div>\n                            <span class=\"emblem-dot emblem-dot-a\" data-kid=\"1-2-1-2-2-4-1-5\">\n                            </span>\n                            <span class=\"emblem-dot emblem-dot-b\" data-kid=\"1-2-1-2-2-4-1-6\">\n                            </span>\n                            <span class=\"emblem-dot emblem-dot-c\" data-kid=\"1-2-1-2-2-4-1-7\">\n                            </span>\n                            <div class=\"absolute inset-[30%] grid place-items-center rounded-full border border-white/50 bg-white/95 p-3 shadow-[0_18px_60px_rgba(0,0,0,.28)]\" data-kid=\"1-2-1-2-2-4-1-8\">\n                                <img alt=\"الختم الرسمي لجمعية المهندسين البحرينية\" class=\"h-full w-full rounded-full object-contain\" data-kid=\"1-2-1-2-2-4-1-8-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                            </div>\n                            <div class=\"absolute -bottom-8 right-1/2 translate-x-1/2 whitespace-nowrap rounded-lg border border-white/25 bg-[var(--bse-navy)]/85 px-4 py-2 text-[11px] font-bold tracking-wide text-[#d8e9ff]\" data-kid=\"1-2-1-2-2-4-1-9\">\n                                هندسة · معرفة · مجتمع\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"absolute bottom-6 left-6 hidden items-center gap-3 text-xs text-white/75 sm:flex\" data-kid=\"1-2-1-2-2-5\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#b8ddff]\" data-kid=\"1-2-1-2-2-5-1\">\n                        </span>\n                        <span data-kid=\"1-2-1-2-2-5-2\">\n                            الختم الذي يجمعنا\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-white py-20 sm:py-24\" data-kid=\"1-2-2\" id=\"about\">\n            <div class=\"emblem-watermark absolute -left-32 bottom-[-150px] h-[430px] w-[430px]\" data-kid=\"1-2-2-1\">\n                <div class=\"emblem-ring emblem-ring-1\" data-kid=\"1-2-2-1-1\">\n                </div>\n                <div class=\"emblem-ring emblem-ring-2\" data-kid=\"1-2-2-1-2\">\n                </div>\n                <div class=\"emblem-ring emblem-ring-3\" data-kid=\"1-2-2-1-3\">\n                </div>\n                <div class=\"emblem-orbit\" data-kid=\"1-2-2-1-4\">\n                </div>\n            </div>\n            <div class=\"relative mx-auto grid max-w-[1120px] gap-12 px-6 lg:grid-cols-[.88fr_1.12fr] lg:items-center lg:px-0\" data-kid=\"1-2-2-2\">\n                <div class=\"relative overflow-hidden rounded-xl bg-[var(--bse-soft)] p-8 sm:p-10\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"absolute right-0 top-0 h-1 w-28 bg-[var(--bse-blue)]\" data-kid=\"1-2-2-2-1-1\">\n                    </div>\n                    <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-2-2-1-2\">\n                        <div data-kid=\"1-2-2-2-1-2-1\">\n                            <div class=\"text-xs font-extrabold tracking-[.16em] text-[var(--bse-blue)]\" data-kid=\"1-2-2-2-1-2-1-1\">\n                                هويتنا\n                            </div>\n                            <h2 class=\"mt-3 text-3xl font-extrabold leading-tight text-[var(--bse-ink)]\" data-kid=\"1-2-2-2-1-2-1-2\">\n                                من نحن\n                            </h2>\n                        </div>\n                        <div class=\"grid h-12 w-12 place-items-center rounded-full border border-[#bcd6f5] text-[var(--bse-blue)]\" data-kid=\"1-2-2-2-1-2-2\">\n                            <i class=\"h-5 w-5\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-2-1\" data-lucide=\"compass\" data-name=\"compass icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                            </i>\n                        </div>\n                    </div>\n                    <p class=\"mt-7 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-2-2-1-3\">\n                        جمعية مهنية تطوعية تعنى بشؤون قطاع المهندسين في البحرين وترعى مصالحهم وتسعى لتطوير قدراتهم من خلال برامجها الفنية والاجتماعية.\n                    </p>\n                    <div class=\"mt-8 grid grid-cols-3 divide-x divide-x-reverse divide-[var(--bse-line)] border-t border-[var(--bse-line)] pt-6\" data-kid=\"1-2-2-2-1-4\">\n                        <div class=\"pl-3\" data-kid=\"1-2-2-2-1-4-1\">\n                            <div class=\"text-xl font-extrabold text-[var(--bse-indigo)]\" data-kid=\"1-2-2-2-1-4-1-1\">\n                                1972\n                            </div>\n                            <div class=\"mt-1 text-xs text-[var(--bse-muted)]\" data-kid=\"1-2-2-2-1-4-1-2\">\n                                سنة التأسيس\n                            </div>\n                        </div>\n                        <div class=\"px-3\" data-kid=\"1-2-2-2-1-4-2\">\n                            <div class=\"text-xl font-extrabold text-[var(--bse-indigo)]\" data-kid=\"1-2-2-2-1-4-2-1\">\n                                6\n                            </div>\n                            <div class=\"mt-1 text-xs text-[var(--bse-muted)]\" data-kid=\"1-2-2-2-1-4-2-2\">\n                                لجان تخصصية\n                            </div>\n                        </div>\n                        <div class=\"pr-3\" data-kid=\"1-2-2-2-1-4-3\">\n                            <div class=\"text-xl font-extrabold text-[var(--bse-indigo)]\" data-kid=\"1-2-2-2-1-4-3-1\">\n                                ∞\n                            </div>\n                            <div class=\"mt-1 text-xs text-[var(--bse-muted)]\" data-kid=\"1-2-2-2-1-4-3-2\">\n                                فرص للتعاون\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"lg:pr-8\" data-kid=\"1-2-2-2-2\">\n                    <div class=\"mb-5 flex items-center gap-3 text-xs font-bold text-[var(--bse-blue)]\" data-kid=\"1-2-2-2-2-1\">\n                        <span class=\"h-px w-10 bg-[var(--bse-blue)]\" data-kid=\"1-2-2-2-2-1-1\">\n                        </span>\n                        <span data-kid=\"1-2-2-2-2-1-2\">\n                            نحو مهنة أكثر تأثيرًا\n                        </span>\n                    </div>\n                    <h2 class=\"max-w-[620px] text-3xl font-extrabold leading-[1.2] tracking-[-.03em] text-[var(--bse-ink)] sm:text-5xl\" data-kid=\"1-2-2-2-2-2\">\n                        نربط خبرة المهندس\n                        <br data-kid=\"1-2-2-2-2-2-1\"/>\n                        <span class=\"text-[var(--bse-indigo)]\" data-kid=\"1-2-2-2-2-2-2\">\n                            بحاجة المجتمع.\n                        </span>\n                    </h2>\n                    <p class=\"mt-6 max-w-[590px] text-lg leading-9 text-[var(--bse-muted)]\" data-kid=\"1-2-2-2-2-3\">\n                        منذ تأسيسها، تعمل الجمعية كحلقة وصل بين المهندسين والجهات المهنية والتعليمية، وتحوّل المعرفة والشراكات إلى أثر مستدام في مملكة البحرين.\n                    </p>\n                    <a class=\"mt-8 inline-flex items-center gap-3 rounded-lg border border-[var(--bse-indigo)] px-5 py-3 text-sm font-bold text-[var(--bse-indigo)] transition hover:bg-[var(--bse-indigo)] hover:text-white\" data-kid=\"1-2-2-2-2-4\" href=\"#agenda\">\n                        شاهد ما نقدمه\n                        <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2-4-1\" data-lucide=\"arrow-left\" data-name=\"arrow-left icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-[var(--bse-line)] bg-[var(--bse-soft)] py-16 sm:py-20\" data-kid=\"1-2-3\" id=\"agenda\">\n            <div class=\"mx-auto max-w-[1120px] px-6 lg:px-0\" data-kid=\"1-2-3-1\">\n                <div class=\"flex flex-col justify-between gap-5 sm:flex-row sm:items-end\" data-kid=\"1-2-3-1-1\">\n                    <div data-kid=\"1-2-3-1-1-1\">\n                        <div class=\"text-xs font-extrabold tracking-[.16em] text-[var(--bse-blue)]\" data-kid=\"1-2-3-1-1-1-1\">\n                            على أجندة الجمعية\n                        </div>\n                        <h2 class=\"mt-3 text-3xl font-extrabold text-[var(--bse-ink)]\" data-kid=\"1-2-3-1-1-1-2\">\n                            موعدنا القادم\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[420px] text-sm leading-7 text-[var(--bse-muted)]\" data-kid=\"1-2-3-1-1-2\">\n                        لقاءات تجمع الخبرة، وتفتح مساحات جديدة للتعلّم والتعاون بين المهندسين.\n                    </p>\n                </div>\n                <article class=\"mt-9 grid overflow-hidden rounded-xl border border-[var(--bse-line)] bg-white shadow-[0_10px_35px_rgba(21,35,62,.06)] lg:grid-cols-[260px_1fr_190px]\" data-kid=\"1-2-3-1-2\">\n                    <div class=\"relative min-h-[180px] overflow-hidden\" data-kid=\"1-2-3-1-2-1\">\n                        <img alt=\"فعالية هندسية في جمعية المهندسين البحرينية\" class=\"absolute inset-0 h-full w-full object-cover\" data-kid=\"1-2-3-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-conference.jpg\"/>\n                        <div class=\"absolute inset-0 bg-[var(--bse-navy)]/35\" data-kid=\"1-2-3-1-2-1-2\">\n                        </div>\n                        <div class=\"absolute right-5 top-5 rounded-lg bg-white px-4 py-3 text-center shadow-lg\" data-kid=\"1-2-3-1-2-1-3\">\n                            <div class=\"text-2xl font-extrabold leading-none text-[var(--bse-indigo)]\" data-kid=\"1-2-3-1-2-1-3-1\">\n                                27\n                            </div>\n                            <div class=\"mt-1 text-[11px] font-semibold text-[var(--bse-muted)]\" data-kid=\"1-2-3-1-2-1-3-2\">\n                                أبريل\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col justify-center p-7 sm:p-9\" data-kid=\"1-2-3-1-2-2\">\n                        <div class=\"mb-3 flex flex-wrap items-center gap-3 text-xs font-bold text-[var(--bse-blue)]\" data-kid=\"1-2-3-1-2-2-1\">\n                            <span class=\"rounded-full bg-[#e7f1ff] px-3 py-1\" data-kid=\"1-2-3-1-2-2-1-1\">\n                                احتفال سنوي\n                            </span>\n                            <span class=\"flex items-center gap-1.5 text-[var(--bse-muted)]\" data-kid=\"1-2-3-1-2-2-1-2\">\n                                <i class=\"h-3.5 w-3.5\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-1-2-1\" data-lucide=\"map-pin\" data-name=\"map-pin icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                                </i>\n                                مقر الجمعية · الجفير\n                            </span>\n                        </div>\n                        <h3 class=\"text-2xl font-extrabold leading-tight text-[var(--bse-ink)] sm:text-3xl\" data-kid=\"1-2-3-1-2-2-2\">\n                            يوم المهندس البحريني\n                        </h3>\n                        <p class=\"mt-3 max-w-[560px] text-sm leading-7 text-[var(--bse-muted)]\" data-kid=\"1-2-3-1-2-2-3\">\n                            احتفاء بالمهندسين المتميزين والمشاريع الريادية التي تسهم في نهضة المملكة، بحضور أعضاء الجمعية وشركائها.\n                        </p>\n                    </div>\n                    <div class=\"flex items-center border-t border-[var(--bse-line)] p-7 lg:border-r lg:border-t-0\" data-kid=\"1-2-3-1-2-3\">\n                        <a class=\"inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[var(--bse-indigo)] px-4 py-3 text-sm font-bold text-white transition hover:bg-[var(--bse-navy)]\" data-kid=\"1-2-3-1-2-3-1\" href=\"#contact\">\n                            عرض تفاصيل الفعالية\n                            <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-3-1-1\" data-lucide=\"arrow-left\" data-name=\"arrow-left icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                            </i>\n                        </a>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section class=\"bg-white py-16 sm:py-20\" data-kid=\"1-2-4\" id=\"news\">\n            <div class=\"mx-auto max-w-[1120px] px-6 lg:px-0\" data-kid=\"1-2-4-1\">\n                <div class=\"grid gap-8 lg:grid-cols-[1.1fr_.9fr]\" data-kid=\"1-2-4-1-1\">\n                    <article class=\"relative overflow-hidden rounded-xl bg-[var(--bse-navy)] p-8 text-white sm:p-10\" data-kid=\"1-2-4-1-1-1\">\n                        <div class=\"absolute bottom-0 left-0 h-44 w-44 rounded-full border border-white/10\" data-kid=\"1-2-4-1-1-1-1\">\n                        </div>\n                        <div class=\"absolute bottom-8 left-8 h-28 w-28 rounded-full border border-white/10\" data-kid=\"1-2-4-1-1-1-2\">\n                        </div>\n                        <div class=\"relative\" data-kid=\"1-2-4-1-1-1-3\">\n                            <div class=\"text-xs font-extrabold tracking-[.16em] text-[#9fcaff]\" data-kid=\"1-2-4-1-1-1-3-1\">\n                                المركز الإعلامي\n                            </div>\n                            <h2 class=\"mt-4 max-w-[520px] text-3xl font-extrabold leading-tight\" data-kid=\"1-2-4-1-1-1-3-2\">\n                                أفكار هندسية، أخبار الجمعية، وأثر يتسع.\n                            </h2>\n                            <p class=\"mt-5 max-w-[500px] text-sm leading-7 text-[#c7d7ee]\" data-kid=\"1-2-4-1-1-1-3-3\">\n                                نشارك آخر أخبار الجمعية، ومقالات المهندسين، والموضوعات التي ترسم ملامح القطاع الهندسي في المملكة والمنطقة.\n                            </p>\n                            <div class=\"mt-8 flex flex-wrap gap-2 text-xs font-bold text-[#d7e8ff]\" data-kid=\"1-2-4-1-1-1-3-4\">\n                                <span class=\"rounded-lg border border-white/20 px-3 py-2\" data-kid=\"1-2-4-1-1-1-3-4-1\">\n                                    استدامة\n                                </span>\n                                <span class=\"rounded-lg border border-white/20 px-3 py-2\" data-kid=\"1-2-4-1-1-1-3-4-2\">\n                                    تقنية\n                                </span>\n                                <span class=\"rounded-lg border border-white/20 px-3 py-2\" data-kid=\"1-2-4-1-1-1-3-4-3\">\n                                    إدارة مشاريع\n                                </span>\n                            </div>\n                        </div>\n                    </article>\n                    <article class=\"overflow-hidden rounded-xl border border-[var(--bse-line)] bg-[var(--bse-soft)]\" data-kid=\"1-2-4-1-1-2\" id=\"learning\">\n                        <div class=\"relative h-44 overflow-hidden\" data-kid=\"1-2-4-1-1-2-1\">\n                            <img alt=\"قاعة التدريب الهندسي\" class=\"h-full w-full object-cover\" data-kid=\"1-2-4-1-1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-training.jpg\"/>\n                            <div class=\"absolute inset-0 bg-[var(--bse-navy)]/30\" data-kid=\"1-2-4-1-1-2-1-2\">\n                            </div>\n                            <span class=\"absolute right-5 top-5 rounded-lg bg-white px-3 py-1 text-xs font-bold text-[var(--bse-indigo)]\" data-kid=\"1-2-4-1-1-2-1-3\">\n                                مركز التدريب\n                            </span>\n                        </div>\n                        <div class=\"p-7\" data-kid=\"1-2-4-1-1-2-2\">\n                            <h2 class=\"text-2xl font-extrabold text-[var(--bse-ink)]\" data-kid=\"1-2-4-1-1-2-2-1\">\n                                تعلم يواكب المهنة\n                            </h2>\n                            <p class=\"mt-3 text-sm leading-7 text-[var(--bse-muted)]\" data-kid=\"1-2-4-1-1-2-2-2\">\n                                برامج معتمدة، مدربون خبراء، ومسارات عملية تساعد المهندس على التطور بثقة.\n                            </p>\n                            <a class=\"mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-[var(--bse-indigo)]\" data-kid=\"1-2-4-1-1-2-2-3\" href=\"#membership\">\n                                استعرض البرامج\n                                <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-4-1-1-2-2-3-1\" data-lucide=\"arrow-left\" data-name=\"arrow-left icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                                </i>\n                            </a>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[var(--bse-teal)] py-20 text-white sm:py-24\" data-kid=\"1-2-5\" id=\"membership\">\n            <div class=\"emblem-watermark absolute -left-10 top-[-110px] h-[420px] w-[420px]\" data-kid=\"1-2-5-1\">\n                <div class=\"emblem-ring emblem-ring-1\" data-kid=\"1-2-5-1-1\">\n                </div>\n                <div class=\"emblem-ring emblem-ring-2\" data-kid=\"1-2-5-1-2\">\n                </div>\n                <div class=\"emblem-ring emblem-ring-3\" data-kid=\"1-2-5-1-3\">\n                </div>\n                <div class=\"emblem-orbit\" data-kid=\"1-2-5-1-4\">\n                </div>\n            </div>\n            <div class=\"relative mx-auto flex max-w-[900px] flex-col items-center px-6 text-center\" data-kid=\"1-2-5-2\">\n                <div class=\"text-xs font-extrabold tracking-[.18em] text-[#a7d9d2]\" data-kid=\"1-2-5-2-1\">\n                    عضوية الجمعية\n                </div>\n                <h2 class=\"mt-4 text-3xl font-extrabold leading-tight sm:text-5xl\" data-kid=\"1-2-5-2-2\">\n                    كن جزءًا من الدائرة.\n                </h2>\n                <p class=\"mt-5 max-w-[620px] text-base leading-8 text-[#c7e3df]\" data-kid=\"1-2-5-2-3\">\n                    عضوية تمنحك حضور الفعاليات، وخصومات الدورات، والوصول إلى شبكة مهنية واسعة داخل البحرين وخارجها.\n                </p>\n                <a class=\"mt-8 inline-flex items-center gap-3 rounded-lg bg-white px-6 py-3.5 text-sm font-extrabold text-[var(--bse-teal)] transition hover:bg-[#d8f2ed]\" data-kid=\"1-2-5-2-4\" href=\"#contact\">\n                    تعرّف على مزايا العضوية\n                    <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-2-5-2-4-1\" data-lucide=\"arrow-left\" data-name=\"arrow-left icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                    </i>\n                </a>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#06132e] text-white\" data-kid=\"1-3\" id=\"contact\">\n        <div class=\"mx-auto grid max-w-[1120px] gap-10 px-6 py-12 lg:grid-cols-[1.25fr_.75fr_.85fr] lg:px-0\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1\">\n                    <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"h-12 w-12 rounded-full object-contain\" data-kid=\"1-3-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                    <div data-kid=\"1-3-1-1-1-2\">\n                        <div class=\"font-extrabold\" data-kid=\"1-3-1-1-1-2-1\">\n                            جمعية المهندسين البحرينية\n                        </div>\n                        <div class=\"mt-1 text-xs text-[#a7b8d2]\" data-kid=\"1-3-1-1-1-2-2\">\n                            معًا نرتقي بالمهنة الهندسية\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mt-6 max-w-[360px] text-sm leading-7 text-[#a7b8d2]\" data-kid=\"1-3-1-1-2\">\n                    منذ عام 1972، نعمل على تمكين المهندسين وبناء جسور التعاون لخدمة البحرين.\n                </p>\n            </div>\n            <div data-kid=\"1-3-1-2\">\n                <div class=\"mb-4 text-sm font-extrabold text-[#dbeaff]\" data-kid=\"1-3-1-2-1\">\n                    روابط سريعة\n                </div>\n                <div class=\"space-y-3 text-sm text-[#a7b8d2]\" data-kid=\"1-3-1-2-2\">\n                    <a class=\"block hover:text-white\" data-kid=\"1-3-1-2-2-1\" href=\"#about\">\n                        من نحن\n                    </a>\n                    <a class=\"block hover:text-white\" data-kid=\"1-3-1-2-2-2\" href=\"#agenda\">\n                        الفعاليات\n                    </a>\n                    <a class=\"block hover:text-white\" data-kid=\"1-3-1-2-2-3\" href=\"#learning\">\n                        مركز التدريب\n                    </a>\n                </div>\n            </div>\n            <div data-kid=\"1-3-1-3\">\n                <div class=\"mb-4 text-sm font-extrabold text-[#dbeaff]\" data-kid=\"1-3-1-3-1\">\n                    تواصل معنا\n                </div>\n                <div class=\"space-y-3 text-sm text-[#a7b8d2]\" data-kid=\"1-3-1-3-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-3-2-1\">\n                        <i class=\"h-4 w-4 text-[#8fc1ff]\" data-dynamic=\"true\" data-kid=\"1-3-1-3-2-1-1\" data-lucide=\"map-pin\" data-name=\"map-pin icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                        </i>\n                        الجفير، مملكة البحرين\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-3-2-2\">\n                        <i class=\"h-4 w-4 text-[#8fc1ff]\" data-dynamic=\"true\" data-kid=\"1-3-1-3-2-2-1\" data-lucide=\"phone\" data-name=\"phone icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                        </i>\n                        <span data-kid=\"1-3-1-3-2-2-2\" dir=\"ltr\">\n                            +973 1772 7100\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-3-1-3-2-3\">\n                        <i class=\"h-4 w-4 text-[#8fc1ff]\" data-dynamic=\"true\" data-kid=\"1-3-1-3-2-3-1\" data-lucide=\"mail\" data-name=\"mail icon\" data-reason=\"icon replaced/initialized by lucide script\">\n                        </i>\n                        <span data-kid=\"1-3-1-3-2-3-2\" dir=\"ltr\">\n                            info@bse.bh\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"border-t border-white/10\" data-kid=\"1-3-2\">\n            <div class=\"mx-auto flex max-w-[1120px] flex-col gap-2 px-6 py-5 text-xs text-[#7f92af] sm:flex-row sm:items-center sm:justify-between lg:px-0\" data-kid=\"1-3-2-1\">\n                <span data-kid=\"1-3-2-1-1\">\n                    © جمعية المهندسين البحرينية · جميع الحقوق محفوظة\n                </span>\n                <span class=\"bse-en\" data-kid=\"1-3-2-1-2\" dir=\"ltr\">\n                    Bahrain Society of Engineers · Since 1972\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    lucide.createIcons();\n</script>\n",
