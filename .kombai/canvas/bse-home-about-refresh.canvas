xtElementSibling.classList.remove('hidden');\" src=\"/api/local/images/src/assets/hero-award.jpg\"/>\n                            <div class=\"fallback absolute inset-0 flex-col items-center justify-center gap-3 bg-[#172552] text-center text-[#c6d7fa]\" data-dynamic=\"true\" data-kid=\"1-3-6-1-2-1-1-2\" data-name=\"media fallback\" data-reason=\"displayed by onerror script\">\n                                <img alt=\"\" aria-hidden=\"true\" class=\"h-14 w-14\" data-kid=\"1-3-6-1-2-1-1-2-1\" data-name=\"fallback logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                                <span class=\"text-sm font-bold\" data-kid=\"1-3-6-1-2-1-1-2-2\" data-name=\"fallback text\">\n                                    المادة الإعلامية غير متاحة\n                                </span>\n                            </div>\n                            <div class=\"absolute inset-0 bg-gradient-to-t from-[#101a3d] via-[#101a3d]/25 to-transparent\" data-kid=\"1-3-6-1-2-1-1-3\" data-name=\"media overlay\">\n                            </div>\n                            <div class=\"absolute bottom-6 right-6 left-6\" data-kid=\"1-3-6-1-2-1-1-4\" data-name=\"media content\">\n                                <p class=\"text-xs font-bold text-[#a9c6ff]\" data-kid=\"1-3-6-1-2-1-1-4-1\" data-name=\"media date tag\">\n                                    خبر رئيسي · 06 يونيو 2026\n                                </p>\n                                <h3 class=\"mt-2 text-2xl font-extrabold leading-tight\" data-kid=\"1-3-6-1-2-1-1-4-2\" data-name=\"media title\">\n                                    الجمعية توقّع شراكة لدعم الاستدامة الهندسية\n                                </h3>\n                                <p class=\"mt-3 text-sm leading-7 text-white/75\" data-kid=\"1-3-6-1-2-1-1-4-3\" data-name=\"media description\">\n                                    اتفاقية جديدة لتعزيز الممارسات المستدامة وتأهيل المهندسين في مجالا