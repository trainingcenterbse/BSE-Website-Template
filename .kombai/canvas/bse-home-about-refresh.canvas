      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');\n\n  html { scroll-behavior: smooth; }\n  body {\n    margin: 0;\n    background: #fafaf8;\n    color: #292827;\n    font-family: 'Cairo', 'Inter', 'Tajawal', system-ui, sans-serif;\n  }\n  .seal-ring {\n    transform-box: fill-box;\n    transform-origin: center;\n    stroke-dasharray: 12 20;\n    animation: ring-drift 16s linear infinite;\n  }\n  .seal-ring-slow {\n    animation-duration: 24s;\n    animation-direction: reverse;\n  }\n  .watermark-ring {\n    transform-box: fill-box;\n    transform-origin: center;\n    animation: watermark-breathe 14s ease-in-out infinite;\n  }\n  @keyframes ring-drift {\n    from { transform: rotate(0deg); stroke-dashoffset: 0; }\n    to { transform: rotate(360deg); stroke-dashoffset: -160; }\n  }\n  @keyframes watermark-breathe {\n    0%, 100% { opacity: .26; transform: scale(1); }\n    50% { opacity: .48; transform: scale(1.03); }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    html { scroll-behavior: auto; }\n    .seal-ring, .watermark-ring { animation: none; }\n  }\n</style>\n<div class=\"min-h-screen overflow-hidden bg-[#fafaf8] text-[#292827]\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\" lang=\"ar\">\n    <section class=\"relative isolate overflow-hidden bg-[#11182d] text-white\" data-kid=\"1-1\" data-name=\"hero section\">\n        <img alt=\"أفق مدينة المنامة ليلًا\" class=\"absolute inset-0 h-full w-full object-cover object-center opacity-30\" data-kid=\"1-1-1\" data-name=\"hero skyline background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-skyline.jpg\"/>\n        <div class=\"absolute inset-0 bg-[#11182d]/80\" data-kid=\"1-1-2\" data-name=\"hero image overlay\">\n        </div>\n        <div class=\"absolute inset-x-0 top-0 h-px bg-[#9bb8ff]/70\" data-kid=\"1-1-3\" data-name=\"hero top border line\">\n        </div>\n        <header class=\"relative z-20 mx-auto max-w-[1180px] px-6 pt-5 lg:px-10\" data-kid=\"1-1-4\" data-name=\"header container\">\n            <div class=\"flex items-center justify-between border-b border-white/15 pb-4\" data-kid=\"1-1-4-1\" data-name=\"header content wrapper\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-4-1-1\" data-name=\"logo and title area\">\n                    <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"h-12 w-12 rounded-full border border-white/30 bg-white/95 object-contain p-1\" data-kid=\"1-1-4-1-1-1\" data-name=\"BSE logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                    <div class=\"leading-tight\" data-kid=\"1-1-4-1-1-2\" data-name=\"organisation names wrapper\">\n                        <p class=\"text-sm font-bold text-white\" data-kid=\"1-1-4-1-1-2-1\" data-name=\"organisation name arabic\">\n                            جمعية المهندسين البحرينية\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-white/55\" data-kid=\"1-1-4-1-1-2-2\" data-name=\"organisation name english\">\n                            Bahrain Society of Engineers\n                        </p>\n                    </div>\n                </div>\n                <nav aria-label=\"التنقل الرئيسي\" class=\"hidden items-center gap-8 text-sm font-semibold text-white/65 lg:flex\" data-kid=\"1-1-4-1-2\" data-name=\"main navigation bar\">\n                    <span class=\"text-white\" data-kid=\"1-1-4-1-2-1\" data-name=\"navigation link main\">\n                        الرئيسية\n                    </span>\n                    <span data-kid=\"1-1-4-1-2-2\" data-name=\"navigation link about\">\n                        عن الجمعية\n                    </span>\n                    <span data-kid=\"1-1-4-1-2-3\" data-name=\"navigation link events\">\n                        الفعاليات\n                    </span>\n                    <span data-kid=\"1-1-4-1-2-4\" data-name=\"navigation link training\">\n                        مركز التدريب\n                    </span>\n                    <span data-kid=\"1-1-4-1-2-5\" data-name=\"navigation link contact\">\n                        تواصل معنا\n                    </span>\n                </nav>\n                <div class=\"flex items-center gap-4 text-xs font-semibold text-white/70\" data-kid=\"1-1-4-1-3\" data-name=\"language and foundation meta\">\n                    <span class=\"border-l border-white/20 pl-4\" data-kid=\"1-1-4-1-3-1\" data-name=\"language switch\">\n                        EN\n                    </span>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-1-4-1-3-2\" data-name=\"foundation year text\">\n                        منذ 1972\n                    </span>\n                </div>\n            </div>\n        </header>\n        <div class=\"pointer-events-none absolute -start-[190px] top-[90px] z-10 h-[690px] w-[690px] opacity-70 sm:-start-[110px] lg:-start-[45px]\" data-kid=\"1-1-5\" data-name=\"hero decorative circles container\">\n            <svg aria-hidden=\"true\" class=\"h-full w-full\" data-kid=\"1-1-5-1\" data-name=\"decorative circle svg\" viewbox=\"0 0 690 690\">\n                <circle class=\"seal-ring seal-ring-slow\" cx=\"345\" cy=\"345\" fill=\"none\" r=\"310\" stroke=\"#c9d7ff\" stroke-opacity=\".26\" stroke-width=\"1\">\n                </circle>\n                <circle class=\"seal-ring\" cx=\"345\" cy=\"345\" fill=\"none\" r=\"258\" stroke=\"#9bb8ff\" stroke-opacity=\".34\" stroke-width=\"1.2\">\n                </circle>\n                <circle cx=\"345\" cy=\"345\" fill=\"none\" r=\"210\" stroke=\"#dce6ff\" stroke-dasharray=\"2 16\" stroke-opacity=\".2\" stroke-width=\"1\">\n                </circle>\n            </svg>\n        </div>\n        <div class=\"relative z-10 mx-auto grid min-h-[650px] max-w-[1180px] items-center gap-12 px-6 pb-20 pt-20 lg:grid-cols-2 lg:gap-20 lg:px-10 lg:pb-24 lg:pt-24\" data-kid=\"1-1-6\" data-name=\"hero content grid\">\n            <div class=\"max-w-[600px]\" data-kid=\"1-1-6-1\" data-name=\"hero text content column\">\n                <p class=\"mb-5 text-sm font-bold tracking-[0.12em] text-[#c9d7ff]\" data-kid=\"1-1-6-1-1\" data-name=\"hero subheadline tag\">\n                    المهنة · المجتمع · الأثر\n                </p>\n                <h1 class=\"max-w-[620px] text-[clamp(2.8rem,5.5vw,5.6rem)] font-bold leading-[1.02] tracking-[-0.04em] text-white\" data-kid=\"1-1-6-1-2\" data-name=\"hero main headline\">\n                    نصنع أثرًا\n                    <br data-kid=\"1-1-6-1-2-1\" data-name=\"headline line break\"/>\n                    <span class=\"text-[#b9caff]\" data-kid=\"1-1-6-1-2-2\" data-name=\"hero headline emphasis\">\n                        هندسيًا يدوم.\n                    </span>\n                </h1>\n                <p class=\"mt-7 max-w-[570px] text-lg leading-9 text-white/72 lg:text-xl\" data-kid=\"1-1-6-1-3\" data-name=\"hero description text\">\n                    جمعية مهنية تجمع مهندسي البحرين من مختلف التخصصات، وترفع مستوى المهنة بالمعرفة والشراكة وخدمة المجتمع.\n                </p>\n                <div class=\"mt-8 flex flex-wrap items-center gap-5\" data-kid=\"1-1-6-1-4\" data-name=\"hero meta information\">\n                    <span class=\"border-s border-white/30 pe-5 text-sm font-semibold text-white/80\" data-kid=\"1-1-6-1-4-1\" data-name=\"meta info label\">\n                        جمعية تطوعية وطنية\n                    </span>\n                    <span class=\"text-sm text-white/55\" data-kid=\"1-1-6-1-4-2\" data-name=\"meta info value\">\n                        مملكة البحرين\n                    </span>\n                </div>\n                <a class=\"mt-10 inline-flex min-h-12 items-center gap-3 rounded-full bg-[#d8e2ff] px-6 py-3 text-sm font-bold text-[#11182d] shadow-[0_10px_28px_rgba(0,0,0,.2)] transition-colors hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#d8e2ff]\" data-kid=\"1-1-6-1-5\" data-name=\"call to action button\" href=\"#about\">\n                    اكتشف الجمعية\n                    <span aria-hidden=\"true\" class=\"text-lg leading-none\" data-kid=\"1-1-6-1-5-1\" data-name=\"button arrow icon\">\n                        ←\n                    </span>\n                </a>\n            </div>\n            <div class=\"relative flex min-h-[360px] items-center justify-center lg:min-h-[470px]\" data-kid=\"1-1-6-2\" data-name=\"hero image column\">\n                <div class=\"relative h-[330px] w-[330px] sm:h-[410px] sm:w-[410px] lg:h-[470px] lg:w-[470px]\" data-kid=\"1-1-6-2-1\" data-name=\"hero badge container\">\n                    <svg aria-hidden=\"true\" class=\"absolute inset-0 h-full w-full\" data-kid=\"1-1-6-2-1-1\" data-name=\"badge decorative circle svg\" viewbox=\"0 0 470 470\">\n                        <circle class=\"seal-ring-slow\" cx=\"235\" cy=\"235\" fill=\"none\" r=\"218\" stroke=\"#c9d7ff\" stroke-opacity=\".35\" stroke-width=\"1\">\n                        </circle>\n                        <circle class=\"seal-ring\" cx=\"235\" cy=\"235\" fill=\"none\" r=\"184\" stroke=\"#9bb8ff\" stroke-opacity=\".58\" stroke-width=\"1.5\">\n                        </circle>\n                        <circle cx=\"235\" cy=\"235\" fill=\"none\" r=\"157\" stroke=\"#eef3ff\" stroke-dasharray=\"3 14\" stroke-opacity=\".25\" stroke-width=\"1\">\n                        </circle>\n                    </svg>\n                    <div class=\"absolute inset-[54px] rounded-full border border-white/25 bg-white/[0.06] p-4 backdrop-blur-[2px] sm:inset-[62px] lg:inset-[74px]\" data-kid=\"1-1-6-2-1-2\" data-name=\"badge inner circle\">\n                        <div class=\"flex h-full w-full items-center justify-center rounded-full border border-white/40 bg-white/95 p-5 shadow-[0_25px_80px_rgba(0,0,0,.35)] sm:p-7\" data-kid=\"1-1-6-2-1-2-1\" data-name=\"badge image wrapper\">\n                            <img alt=\"الختم الرسمي لجمعية المهندسين البحرينية\" class=\"h-full w-full rounded-full object-contain\" data-kid=\"1-1-6-2-1-2-1-1\" data-name=\"badge logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                        </div>\n                    </div>\n                    <div class=\"absolute -bottom-1 end-1/2 translate-x-1/2 rounded-full border border-white/20 bg-[#11182d]/90 px-4 py-2 text-xs font-semibold text-white/75 backdrop-blur-sm\" data-kid=\"1-1-6-2-1-3\" data-name=\"badge caption\">\n                        ختم الجمعية · 1972\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section class=\"relative overflow-hidden border-b border-[#e8e4dd] bg-[#fafaf8]\" data-kid=\"1-2\" data-name=\"news and events section\" id=\"pulse\">\n        <div aria-hidden=\"true\" class=\"pointer-events-none absolute -top-[250px] end-[10%] h-[560px] w-[560px] opacity-[0.09]\" data-kid=\"1-2-1\" data-name=\"decorative watermark container\">\n            <svg class=\"h-full w-full\" data-kid=\"1-2-1-1\" data-name=\"watermark svg\" viewbox=\"0 0 560 560\">\n                <circle class=\"watermark-ring\" cx=\"280\" cy=\"280\" fill=\"none\" r=\"250\" stroke=\"#1b1938\" stroke-width=\"1\">\n                </circle>\n                <circle cx=\"280\" cy=\"280\" fill=\"none\" r=\"198\" stroke=\"#1b1938\" stroke-width=\"1\">\n                </circle>\n                <circle cx=\"280\" cy=\"280\" fill=\"none\" r=\"148\" stroke=\"#1b1938\" stroke-dasharray=\"2 13\" stroke-width=\"1\">\n                </circle>\n            </svg>\n        </div>\n        <div class=\"relative mx-auto max-w-[1180px] px-6 py-10 lg:px-10 lg:py-12\" data-kid=\"1-2-2\" data-name=\"section content wrapper\">\n            <div class=\"flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between\" data-kid=\"1-2-2-1\" data-name=\"section header wrapper\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"header text area\">\n                    <p class=\"text-xs font-bold tracking-[0.14em] text-[#1d61d8]\" data-kid=\"1-2-2-1-1-1\" data-name=\"section eyebrow\">\n                        نبض الجمعية\n                    </p>\n                    <h2 class=\"mt-2 text-2xl font-bold tracking-[-0.02em] text-[#1b1938] lg:text-3xl\" data-kid=\"1-2-2-1-1-2\" data-name=\"section headline\">\n                        خطوتك التالية تبدأ هنا\n                    </h2>\n                </div>\n                <p class=\"max-w-md text-sm leading-7 text-[#73706d]\" data-kid=\"1-2-2-1-2\" data-name=\"section description\">\n                    أهم ما يحدث الآن في مجتمع المهندسين — في لمحة واحدة، دون ازدحام.\n                </p>\n            </div>\n            <div class=\"mt-8 grid border-y border-[#e8e4dd] md:grid-cols-3\" data-kid=\"1-2-2-2\" data-name=\"news card grid\">\n                <div class=\"py-6 md:pe-8\" data-kid=\"1-2-2-2-1\" data-name=\"news card one\">\n                    <p class=\"text-xs font-bold text-[#1d61d8]\" data-kid=\"1-2-2-2-1-1\" data-name=\"card category\">\n                        الفعالية القادمة · 27 أبريل\n                    </p>\n                    <h3 class=\"mt-2 text-lg font-bold text-[#292827]\" data-kid=\"1-2-2-2-1-2\" data-name=\"card title\">\n                        يوم المهندس البحريني\n                    </h3>\n                    <p class=\"mt-1 text-sm text-[#73706d]\" data-kid=\"1-2-2-2-1-3\" data-name=\"card subtitle\">\n                        مقر الجمعية · احتفال سنوي\n                    </p>\n                    <span class=\"mt-4 inline-flex text-sm font-bold text-[#1b1938]\" data-kid=\"1-2-2-2-1-4\" data-name=\"card action link\">\n                        التفاصيل\n                        <span aria-hidden=\"true\" class=\"me-2\" data-kid=\"1-2-2-2-1-4-1\" data-name=\"card action icon\">\n                            ←\n 