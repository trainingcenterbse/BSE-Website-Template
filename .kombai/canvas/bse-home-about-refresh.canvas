        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');\n\n  :root {\n    --bse-navy: #071936;\n    --bse-navy-2: #0b2859;\n    --bse-blue: #176fe5;\n    --bse-blue-soft: #eaf2ff;\n    --bse-ice: #f6f9fd;\n    --bse-ink: #16233c;\n    --bse-muted: #617089;\n    --bse-line: #dbe5f2;\n    --bse-gold: #d7b46a;\n  }\n\n  .bse-page {\n    font-family: 'Cairo', 'Inter', system-ui, sans-serif;\n    color: var(--bse-ink);\n    background: #ffffff;\n    direction: rtl;\n    overflow: hidden;\n  }\n  .bse-page h1,\n  .bse-page h2,\n  .bse-page h3,\n  .bse-page p { margin: 0; }\n  .bse-page a { text-decoration: none; }\n  .bse-container { width: min(1120px, calc(100% - 64px)); margin-inline: auto; }\n  .bse-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    color: var(--bse-blue);\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: .06em;\n  }\n  .bse-eyebrow::before {\n    content: '';\n    width: 30px;\n    height: 1px;\n    background: currentColor;\n  }\n  .bse-display {\n    font-weight: 700;\n    letter-spacing: -.035em;\n    line-height: 1.12;\n  }\n  .seal-frame {\n    position: relative;\n    width: 360px;\n    height: 360px;\n    display: grid;\n    place-items: center;\n  }\n  .seal-frame::before,\n  .seal-frame::after,\n  .seal-orbit {\n    content: '';\n    position: absolute;\n    border: 1px solid rgba(215, 180, 106, .64);\n    border-radius: 999px;\n  }\n  .seal-frame::before { inset: 6px; }\n  .seal-frame::after { inset: 30px; border-color: rgba(255, 255, 255, .42); }\n  .seal-orbit { inset: 56px; border-color: rgba(23, 111, 229, .75); }\n  .seal-glint {\n    position: absolute;\n    inset: 18px;\n    border-radius: 999px;\n    background: conic-gradient(from 205deg, transparent 0deg, rgba(215,180,106,.7) 12deg, transparent 31deg, transparent 180deg, rgba(23,111,229,.45) 230deg, transparent 260deg);\n    mask: radial-gradient(circle, transparent 66%, #000 67%, #000 68%, transparent 69%);\n    opacity: .78;\n  }\n  .seal-image {\n    position: relative;\n    z-index: 2;\n    width: 218px;\n    height: 218px;\n    object-fit: contain;\n    filter: drop-shadow(0 18px 34px rgba(0,0,0,.24));\n  }\n  .thread-line {\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    right: 50%;\n    width: 1px;\n    background: linear-gradient(to bottom, transparent, rgba(23,111,229,.24) 8%, rgba(23,111,229,.24) 92%, transparent);\n  }\n  .thread-line::after {\n    content: '';\n    position: absolute;\n    top: 150px;\n    right: -5px;\n    width: 9px;\n    height: 9px;\n    border: 1px solid var(--bse-blue);\n    border-radius: 999px;\n    background: #fff;\n    box-shadow: 0 0 0 7px rgba(23,111,229,.08);\n  }\n  .history-line {\n    position: absolute;\n    top: 12px;\n    bottom: 12px;\n    right: 50%;\n    width: 1px;\n    background: linear-gradient(to bottom, transparent, var(--bse-blue) 8%, var(--bse-blue) 92%, transparent);\n  }\n  .history-node {\n    position: relative;\n    z-index: 1;\n    width: 18px;\n    height: 18px;\n    flex: 0 0 18px;\n    border: 4px solid #fff;\n    border-radius: 999px;\n    background: var(--bse-blue);\n    box-shadow: 0 0 0 1px var(--bse-blue), 0 0 0 8px rgba(23,111,229,.08);\n  }\n  .history-node.gold { background: var(--bse-gold); box-shadow: 0 0 0 1px var(--bse-gold), 0 0 0 8px rgba(215,180,106,.12); }\n  .metric-rule { position: relative; }\n  .metric-rule::before { content: ''; position: absolute; top: 5px; bottom: 5px; right: 0; width: 1px; background: var(--bse-line); }\n  .metric-rule:first-child::before { display: none; }\n  .goal-row { border-top: 1px solid var(--bse-line); padding: 22px 0; }\n  .goal-row:last-child { border-bottom: 1px solid var(--bse-line); }\n  .value-row + .value-row { border-right: 1px solid var(--bse-line); }\n  .quiet-grid {\n    background-image: linear-gradient(rgba(23,111,229,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(23,111,229,.04) 1px, transparent 1px);\n    background-size: 32px 32px;\n  }\n  .cta-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    min-height: 46px;\n    padding: 0 21px;\n    border-radius: 8px;\n    font-size: 15px;\n    font-weight: 700;\n  }\n  .cta-primary { color: var(--bse-navy); background: #fff; }\n  .cta-outline { color: #fff; border: 1px solid rgba(255,255,255,.45); }\n  .cta-outline:hover { background: rgba(255,255,255,.1); }\n  @keyframes sealBreath { 0%,100% { transform: scale(1); opacity: .72; } 50% { transform: scale(1.035); opacity: 1; } }\n  .seal-glint { animation: sealBreath 8s ease-in-out infinite; transform-origin: center; }\n  @media (max-width: 900px) {\n    .bse-container { width: min(100% - 36px, 680px); }\n    .seal-frame { width: 260px; height: 260px; }\n    .seal-image { width: 162px; height: 162px; }\n    .seal-frame::before { inset: 4px; }\n    .seal-frame::after { inset: 22px; }\n    .seal-orbit { inset: 42px; }\n    .thread-line { right: 22px; }\n    .history-line { right: 8px; }\n    .history-node { margin-right: 0; }\n    .value-row + .value-row { border-right: 0; border-top: 1px solid var(--bse-line); padding-top: 18px; }\n    .metric-rule::before { display: none; }\n    .metric-rule { border-top: 1px solid var(--bse-line); padding-top: 16px; }\n    .metric-rule:first-child { border-top: 0; padding-top: 0; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .seal-glint { animation: none; }\n  }\n</style>\n<div class=\"bse-page min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"relative bg-[var(--bse-navy)] text-white\" data-kid=\"1-1\" data-name=\"hero header section\">\n        <div class=\"absolute inset-0 opacity-25\" data-kid=\"1-1-1\" data-name=\"hero background image container\">\n            <img alt=\"\" class=\"h-full w-full object-cover\" data-kid=\"1-1-1-1\" data-name=\"hero background skyline image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-skyline.jpg\"/>\n            <div class=\"absolute inset-0 bg-[var(--bse-navy)]/85\" data-kid=\"1-1-1-2\" data-name=\"hero background overlay\">\n            </div>\n        </div>\n        <div class=\"relative z-10 bse-container\" data-kid=\"1-1-2\" data-name=\"hero inner content container\">\n            <div class=\"flex items-center justify-between border-b border-white/15 py-4 text-sm\" data-kid=\"1-1-2-1\" data-name=\"header navigation bar\">\n                <div class=\"flex items-center gap-6 text-white/70\" data-kid=\"1-1-2-1-1\" data-name=\"main navigation link group\">\n                    <a class=\"hover:text-white\" data-kid=\"1-1-2-1-1-1\" data-name=\"vision and mission link\" href=\"#vision\">\n                        الرؤية والرسالة\n                    </a>\n                    <a class=\"hover:text-white\" data-kid=\"1-1-2-1-1-2\" data-name=\"association goals link\" href=\"#goals\">\n                        أهداف الجمعية\n                    </a>\n                    <a class=\"hover:text-white\" data-kid=\"1-1-2-1-1-3\" data-name=\"contact us link\" href=\"#contact\">\n                        تواصل معنا\n                    </a>\n                </div>\n                <div class=\"flex items-center gap-3 text-white/70\" data-kid=\"1-1-2-1-2\" data-name=\"language selection group\">\n                    <span data-kid=\"1-1-2-1-2-1\" data-name=\"arabic language text\">\n                        العربية\n                    </span>\n                    <span class=\"h-4 w-px bg-white/25\" data-kid=\"1-1-2-1-2-2\" data-name=\"language separator line\">\n                    </span>\n                    <span class=\"font-sans text-xs\" data-kid=\"1-1-2-1-2-3\" data-name=\"english language text\">\n                        EN\n                    </span>\n                </div>\n            </div>\n            <div class=\"grid min-h-[470px] items-center gap-12 py-16 lg:grid-cols-[.9fr_1.35fr] lg:py-20\" data-kid=\"1-1-2-2\" data-name=\"hero content grid\" dir=\"ltr\">\n                <div class=\"flex justify-center lg:justify-start\" data-kid=\"1-1-2-2-1\" data-name=\"logo display container\">\n                    <div aria-label=\"شعار جمعية المهندسين البحرينية\" class=\"seal-frame\" data-kid=\"1-1-2-2-1-1\" data-name=\"seal decorative frame\">\n                        <div class=\"seal-orbit\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"decorative seal orbit\">\n                        </div>\n                        <div class=\"seal-glint\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"breathing seal glint effect\" data-reason=\"glint effect animated by infinite CSS keyframes\">\n                        </div>\n                        <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"seal-image\" data-kid=\"1-1-2-2-1-1-3\" data-name=\"association logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                    </div>\n                </div>\n                <div class=\"text-right\" data-kid=\"1-1-2-2-2\" data-name=\"hero main text container\" dir=\"rtl\">\n                    <div class=\"mb-5 inline-flex items-center gap-3 text-sm font-bold text-[#d7b46a]\" data-kid=\"1-1-2-2-2-1\" data-name=\"hero eyebrow category text\">\n                        <span class=\"h-px w-8 bg-[#d7b46a]\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"eyebrow decorative line\">\n                        </span>\n                        ملف الجمعية\n                    </div>\n                    <h1 class=\"bse-display max-w-3xl text-5xl text-white md:text-7xl\" data-kid=\"1-1-2-2-2-2\" data-name=\"main hero headline text\">\n                        من نحن\n                    </h1>\n                    <p class=\"mt-5 max-w-2xl text-xl leading-9 text-white/80 md:text-2xl\" data-kid=\"1-1-2-2-2-3\" data-name=\"hero subheadline description text\">\n                        جمعية المهندسين البحرينية — رائدة في دعم المهنة الهندسية منذ عام 1972\n                    </p>\n                    <div class=\"mt-8 flex flex-wrap justify-end gap-x-8 gap-y-3 text-sm text-white/65\" data-kid=\"1-1-2-2-2-4\" data-name=\"hero tag list group\">\n                        <span data-kid=\"1-1-2-2-2-4-1\" data-name=\"hero tag: voluntary professional association\">\n                            جمعية مهنية تطوعية\n                        </span>\n                        <span data-kid=\"1-1-2-2-2-4-2\" data-name=\"hero tag: diverse engineering specialties\">\n                            تجمع مختلف التخصصات\n                        </span>\n                        <span data-kid=\"1-1-2-2-2-4-3\" data-name=\"hero tag: kingdom of bahrain\">\n                            مملكة البحرين\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"relative\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div aria-hidden=\"true\" class=\"thread-line\" data-kid=\"1-2-1\" data-name=\"decorative timeline thread line\">\n        </div>\n        <section class=\"relative border-b border-[var(--bse-line)] bg-white py-20 md:py-24\" data-kid=\"1-2-2\" data-name=\"about section\">\n            <div class=\"bse-container grid items-start gap-12 lg:grid-cols-[1fr_.9fr]\" data-kid=\"1-2-2-1\" data-name=\"about content grid\" dir=\"ltr\">\n                <div class=\"text-right\" data-kid=\"1-2-2-1-1\" data-name=\"about text content column\" dir=\"rtl\">\n                    <span class=\"bse-eyebrow\" data-kid=\"1-2-2-1-1-1\" data-name=\"about eyebrow text\">\n                        التعريف\n                    </span>\n                    <h2 class=\"bse-display mt-5 max-w-xl text-4xl text-[var(--bse-navy)] md:text-5xl\" data-kid=\"1-2-2-1-1-2\" data-name=\"about section headline text\">\n                        نبني مساحة تجمع المهندس بالمعرفة والأثر\n                    </h2>\n                    <p class=\"mt-6 max-w-xl text-lg leading-9 text-[var(--bse-muted)]\" data-kid=\"1-2-2-1-1-3\" data-name=\"about description paragraph 1\">\n                        جمعية مهنية تطوعية تعنى بشؤون قطاع المهندسين في البحرين وترعى مصالحهم وتسعى لتطوير قدراتهم من خلال برامجها الفنية والاجتماعية.\n                    </p>\n                    <p class=\"mt-5 max-w-xl text-lg leading-9 text-[var(--bse-muted)]\" data-kid=\"1-2-2-1-1-4\" data-name=\"about description paragraph 2\">\n                        تعمل الجمعية على رفع مستوى المهنة، ودعم التنمية الوطنية، وتمثيل المهندسين محلياً ودولياً، مع الحفاظ على بيئة مهنية تشجع التعاون والتطوير المستمر.\n                    </p>\n                </div>\n                <aside class=\"quiet-grid border border-[var(--bse-line)] bg-[var(--bse-ice)] p-8 text-right md:p-10\" data-kid=\"1-2-2-1-2\" data-name=\"about aside info card\" dir=\"rtl\">\n                    <div class=\"flex items-start justify-between gap-6 border-b border-[var(--bse-line)] pb-7\" data-kid=\"1-2-2-1-2-1\" data-name=\"aside card header\">\n                        <div data-kid=\"1-2-2-1-2-1-1\" data-name=\"since date label container\">\n                            <p class=\"text-sm font-bold text-[var(--bse-blue)]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"since label text\">\n                                منذ\n                            </p>\n                            <p class=\"mt-1 font-sans text-6xl font-semibold tracking-[-.06em] text-[var(--bse-navy)]\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"establishment year number\">\n                                1972\n                            </p>\n                        </div>\n                        <div class=\"mt-1 h-12 w-12 rounded-full border border-[var(--bse-blue)]/35\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"decorative aside circle\">\n                        </div>\n                    </div>\n                    <p class=\"mt-7 text-xl font-semibold leading-9 text-[var(--bse-navy)]\" data-kid=\"1-2-2-1-2-2\" data-name=\"aside description text\">\n                        تأسست الجمعية في سنة 1972 لتكون صوتًا مهنيًا جامعًا للمهندسين في مملكة البحرين.\n                    </p>\n                    <div class=\"mt-8 flex items-center justify-between text-sm text-[var(--bse-muted)]\" data-kid=\"1-2-2-1-2-3\" data-name=\"aside identity footer\">\n                        <span data-kid=\"1-2-2-1-2-3-1\" data-name=\"identity label\">\n                            الهوية\n                        </span>\n                        <span class=\"font-sans tracking-widest text-[var(--bse-blue)]\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"identity code\">\n                            BSE / 01\n                        </span>\n                    </div>\n                </aside>\n            </div>\n        </section>\n        <section class=\"relative border-b border-[var(--bse-line)] bg-[var(--bse-ice)] py-16 md:py-20\" data-kid=\"1-2-3\" data-name=\"metrics stats section\">\n            <div class=\"bse-container\" data-kid=\"1-2-3-1\" data-name=\"metrics container\" dir=\"rtl\">\n                <div class=\"mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end\" data-kid=\"1-2-3-1-1\" data-name=\"metrics header group\">\n                    <div data-kid=\"1-2-3-1-1-1\" data-name=\"metrics header text container\">\n                        <span class=\"bse-eyebrow\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"metrics eyebrow text\">\n                            أثر متراكم\n                        </span>\n                        <h2 class=\"bse-display mt-4 text-3xl text-[var(--bse-navy)] md:text-4xl\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"metrics section headline text\">\n                            أرقامنا تتحدث\n                        </h2>\n                    </div>\n                    <p class=\"max-w-md text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-3-1-1-2\" data-name=\"metrics description text\">\n                        45+ عامًا من الخبرة والتميز في خدمة المهنة الهندسية.\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-2 gap-y-8 md:grid-cols-4\" data-kid=\"1-2-3-1-2\" data-name=\"metrics list\">\n                    <div class=\"metric-rule px-5 first:pr-0 md:px-8 md:first:pr-0\" data-kid=\"1-2-3-1-2-1\" data-name=\"metric: active members\">\n                        <p class=\"font-sans text-4xl font-semibold tracking-[-.05em] text-[var(--bse-blue)]\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"metric value: 5000+\">\n                            +5000\n                        </p>\n                        <p class=\"mt-2 text-base text-[var(--bse-muted)]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"metric label: members\">\n                            عضو نشط\n                        </p>\n                    </div>\n                    <div class=\"metric-rule px-5 md:px-8\" data-kid=\"1-2-3-1-2-2\" data-name=\"metric: strategic partners\">\n                        <p class=\"font-sans text-4xl font-semibold tracking-[-.05em] text-[var(--bse-blue)]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"metric value: 50+\">\n                            +50\n                        </p>\n                        <p class=\"mt-2 text-base text-[var(--bse-muted)]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"metric label: partners\">\n                            شريك استراتيجي\n                        </p>\n                    </div>\n                    <div class=\"metric-rule px-5 md:px-8\" data-kid=\"1-2-3-1-2-3\" data-name=\"metric: annual events\">\n                        <p class=\"font-sans text-4xl font-semibold tracking-[-.05em] text-[var(--bse-blue)]\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"metric value: 200+\">\n                            +200\n                        </p>\n                        <p class=\"mt-2 text-base text-[var(--bse-muted)]\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"metric label: events\">\n                            فعالية سنويًا\n                        </p>\n                    </div>\n                    <div class=\"metric-rule px-5 md:px-8\" data-kid=\"1-2-3-1-2-4\" data-name=\"metric: years of experience\">\n                        <p class=\"font-sans text-4xl font-semibold tracking-[-.05em] text-[var(--bse-blue)]\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"metric value: 45+\">\n                            45+\n                        </p>\n                        <p class=\"mt-2 text-base text-[var(--bse-muted)]\" data-kid=\"1-2-3-1-2-4-2\" data-name=\"metric label: experience\">\n                            سنة من الخبرة\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative bg-white py-20 md:py-28\" data-kid=\"1-2-4\" data-name=\"history timeline section\" id=\"history\">\n            <div class=\"bse-container\" data-kid=\"1-2-4-1\" data-name=\"timeline container\" dir=\"rtl\">\n                <div class=\"max-w-2xl\" data-kid=\"1-2-4-1-1\" data-name=\"timeline header\">\n                    <span class=\"bse-eyebrow\" data-kid=\"1-2-4-1-1-1\" data-name=\"timeline eyebrow text\">\n                        التاريخ\n                    </span>\n                    <h2 class=\"bse-display mt-4 text-4xl text-[var(--bse-navy)] md:text-5xl\" data-kid=\"1-2-4-1-1-2\" data-name=\"timeline headline text\">\n                        محطات تأسيس الجمعية\n                    </h2>\n                    <p class=\"mt-5 text-lg leading-9 text-[var(--bse-muted)]\" data-kid=\"1-2-4-1-1-3\" data-name=\"timeline description text\">\n                        مسار واضح من التأسيس إلى بناء مجتمع مهني أكثر تماسكًا وتأثيرًا.\n                    </p>\n                </div>\n                <div class=\"relative mt-14 space-y-0\" data-kid=\"1-2-4-1-2\" data-name=\"timeline content\">\n                    <div aria-hidden=\"true\" class=\"history-line\" data-kid=\"1-2-4-1-2-1\" data-name=\"timeline vertical line\">\n                    </div>\n                    <article class=\"relative grid grid-cols-[112px_28px_1fr] items-start gap-5 border-b border-[var(--bse-line)] py-8 first:pt-0\" data-kid=\"1-2-4-1-2-2\" data-name=\"timeline entry 1972\">\n                        <div class=\"text-right\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"entry year and label\">\n                            <p class=\"font-sans text-2xl font-semibold text-[var(--bse-blue)]\" data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"year text\">\n                                1972\n                            </p>\n                            <p class=\"mt-1 text-sm text-[var(--bse-muted)]\" data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"year subtitle\">\n                                البداية\n                            </p>\n                        </div>\n                        <div class=\"flex justify-center\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"node container\">\n                            <span class=\"history-node\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"timeline node\">\n                            </span>\n                        </div>\n                        <div class=\"max-w-2xl\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"entry body\">\n                            <h3 class=\"text-2xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-4-1-2-2-3-1\" data-name=\"entry title\">\n                                تأسيس الجمعية\n                            </h3>\n                            <p class=\"mt-3 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-4-1-2-2-3-2\" data-name=\"entry description\">\n                                تأسست جمعية المهندسين البحرينية في سنة 1972 لتجمع المهندسين وتدعم تطور المهنة في المملكة.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"relative grid grid-cols-[112px_28px_1fr] items-start gap-5 border-b border-[var(--bse-line)] py-8\" data-kid=\"1-2-4-1-2-3\" data-name=\"timeline entry official\">\n                        <div class=\"text-right\" data-kid=\"1-2-4-1-2-3-1\" data-name=\"entry date and label\">\n                            <p class=\"font-sans text-2xl font-semibold text-[var(--bse-blue)]\" data-kid=\"1-2-4-1-2-3-1-1\" data-name=\"date text\">\n                                01.07.1972\n                            </p>\n                            <p class=\"mt-1 text-sm text-[var(--bse-muted)]\" data-kid=\"1-2-4-1-2-3-1-2\" data-name=\"date subtitle\">\n                                الإشهار\n                            </p>\n                        </div>\n                        <div class=\"flex justify-center\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"node container\">\n                            <span class=\"history-node gold\" data-kid=\"1-2-4-1-2-3-2-1\" data-name=\"gold timeline node\">\n                            </span>\n                        </div>\n                        <div class=\"max-w-2xl\" data-kid=\"1-2-4-1-2-3-3\" data-name=\"entry body\">\n                            <h3 class=\"text-2xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-4-1-2-3-3-1\" data-name=\"entry title\">\n                                الإشهار الرسمي\n                            </h3>\n                            <p class=\"mt-3 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-4-1-2-3-3-2\" data-name=\"entry description\">\n                                تم إشهار الجمعية رسميًا في الجريدة الرسمية بتاريخ 1 يوليو 1972، لتبدأ مرحلة جديدة من العمل المؤسسي.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"relative grid grid-cols-[112px_28px_1fr] items-start gap-5 border-b border-[var(--bse-line)] py-8 last:border-b-0 last:pb-0\" data-kid=\"1-2-4-1-2-4\" data-name=\"timeline entry 1992\">\n                        <div class=\"text-right\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"entry year and label\">\n                            <p class=\"font-sans text-2xl font-semibold text-[var(--bse-blue)]\" data-kid=\"1-2-4-1-2-4-1-1\" data-name=\"year text\">\n                                1992\n                            </p>\n                            <p class=\"mt-1 text-sm text-[var(--bse-muted)]\" data-kid=\"1-2-4-1-2-4-1-2\" data-name=\"year subtitle\">\n                                التسجيل\n                            </p>\n                        </div>\n                        <div class=\"flex justify-center\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"node container\">\n                            <span class=\"history-node\" data-kid=\"1-2-4-1-2-4-2-1\" data-name=\"timeline node\">\n                            </span>\n                        </div>\n                        <div class=\"max-w-2xl\" data-kid=\"1-2-4-1-2-4-3\" data-name=\"entry body\">\n                            <h3 class=\"text-2xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-4-1-2-4-3-1\" data-name=\"entry title\">\n                                إعادة التسجيل\n                            </h3>\n                            <p class=\"mt-3 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-4-1-2-4-3-2\" data-name=\"entry description\">\n                                تم إعادة تسجيلها بتاريخ 15-3-92 تحت قيد م/ج/76 بمقتضى قانون الجمعيات والأندية الاجتماعية والثقافية.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative border-y border-[var(--bse-line)] bg-[var(--bse-ice)] py-20 md:py-24\" data-kid=\"1-2-5\" data-name=\"vision and mission section\" id=\"vision\">\n            <div class=\"bse-container\" data-kid=\"1-2-5-1\" data-name=\"vision container\" dir=\"rtl\">\n                <div class=\"mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end\" data-kid=\"1-2-5-1-1\" data-name=\"vision header\">\n                    <div data-kid=\"1-2-5-1-1-1\" data-name=\"vision eyebrow text\">\n                        <span class=\"bse-eyebrow\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"vision eyebrow text content\">\n                            اتجاهنا\n                        </span>\n                        <h2 class=\"bse-display mt-4 text-4xl text-[var(--bse-navy)] md:text-5xl\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"vision headline\">\n                            رؤيتنا ورسالتنا\n                        </h2>\n                    </div>\n                    <p class=\"max-w-md text-lg leading-9 text-[var(--bse-muted)]\" data-kid=\"1-2-5-1-1-2\" data-name=\"vision description text\">\n                        نحو مستقبل هندسي مشرق ومستدام، يبدأ من تمكين المهندس وينتهي بأثر يخدم المجتمع.\n                    </p>\n                </div>\n                <div class=\"grid gap-0 border-y border-[var(--bse-line)] md:grid-cols-2\" data-kid=\"1-2-5-1-2\" data-name=\"vision content grid\">\n                    <article class=\"border-b border-[var(--bse-line)] py-10 md:border-b-0 md:border-l md:pl-12 lg:pl-16\" data-kid=\"1-2-5-1-2-1\" data-name=\"vision card\">\n                        <p class=\"font-sans text-sm font-semibold tracking-widest text-[var(--bse-blue)]\" data-kid=\"1-2-5-1-2-1-1\" data-name=\"vision card index\">\n                            01 / VISION\n                        </p>\n                        <h3 class=\"mt-4 text-3xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-5-1-2-1-2\" data-name=\"vision card title\">\n                            رؤيتنا\n                        </h3>\n                        <p class=\"mt-5 text-lg leading-9 text-[var(--bse-muted)]\" data-kid=\"1-2-5-1-2-1-3\" data-name=\"vision card text\">\n                            تحقيق التميز والتفوق بصفتنا هيئة مهنية هندسية رائدة تسعى وتعمل لكسب الاعتراف والسمعة الطيبة على المستوى الإقليمي والعالمي.\n                        </p>\n                    </article>\n                    <article class=\"py-10 md:pr-12 lg:pr-16\" data-kid=\"1-2-5-1-2-2\" data-name=\"mission card\">\n                        <p class=\"font-sans text-sm font-semibold tracking-widest text-[var(--bse-blue)]\" data-kid=\"1-2-5-1-2-2-1\" data-name=\"mission card index\">\n                            02 / MISSION\n                        </p>\n                        <h3 class=\"mt-4 text-3xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-5-1-2-2-2\" data-name=\"mission card title\">\n                            رسالتنا\n                        </h3>\n                        <p class=\"mt-5 text-lg leading-9 text-[var(--bse-muted)]\" data-kid=\"1-2-5-1-2-2-3\" data-name=\"mission card text\">\n                            الجمعية الوطنية الرائدة التي تحتضن المهندسين من جميع التخصصات وتعمل على الارتقاء بالمستوى المهني والتقني والعلمي للمهندسين.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative bg-white py-20 md:py-28\" data-kid=\"1-2-6\" data-name=\"goals section\" id=\"goals\">\n            <div class=\"bse-container\" data-kid=\"1-2-6-1\" data-name=\"goals container\" dir=\"rtl\">\n                <div class=\"grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-20\" data-kid=\"1-2-6-1-1\" data-name=\"goals content\" dir=\"ltr\">\n                    <div class=\"text-right\" data-kid=\"1-2-6-1-1-1\" data-name=\"goals text column\" dir=\"rtl\">\n                        <span class=\"bse-eyebrow\" data-kid=\"1-2-6-1-1-1-1\" data-name=\"goals eyebrow\">\n                            الإطار الاستراتيجي\n                        </span>\n                        <h2 class=\"bse-display mt-4 text-4xl text-[var(--bse-navy)] md:text-5xl\" data-kid=\"1-2-6-1-1-1-2\" data-name=\"goals headline\">\n                            أهدافنا واستراتيجيتنا\n                        </h2>\n                        <p class=\"mt-6 border-r-2 border-[var(--bse-blue)] pr-5 text-lg leading-9 text-[var(--bse-muted)]\" data-kid=\"1-2-6-1-1-1-3\" data-name=\"goals summary\">\n                            نحو قطاع هندسي بحريني أكثر تأثيرًا وتنافسية؛ نربط تطوير المهندس بخدمة المجتمع، ونحوّل المعرفة والشراكات إلى أثر مهني مستدام.\n                        </p>\n                    </div>\n                    <div class=\"text-right\" data-kid=\"1-2-6-1-1-2\" data-name=\"goals list\" dir=\"rtl\">\n                        <div class=\"mb-2 flex items-center justify-between text-sm font-bold text-[var(--bse-muted)]\" data-kid=\"1-2-6-1-1-2-1\" data-name=\"goals list meta header\">\n                            <span data-kid=\"1-2-6-1-1-2-1-1\" data-name=\"goals label\">\n                                أهداف الجمعية\n                            </span>\n                            <span class=\"font-sans tracking-widest text-[var(--bse-blue)]\" data-kid=\"1-2-6-1-1-2-1-2\" data-name=\"goals count\">\n                                06 أهداف\n                            </span>\n                        </div>\n                        <div class=\"goal-row grid gap-4 md:grid-cols-[48px_1fr] md:items-start\" data-kid=\"1-2-6-1-1-2-2\" data-name=\"goal item 1\">\n                            <span class=\"font-sans text-lg font-semibold text-[var(--bse-blue)]\" data-kid=\"1-2-6-1-1-2-2-1\" data-name=\"goal index 01\">\n                                01\n                            </span>\n                            <div data-kid=\"1-2-6-1-1-2-2-2\" data-name=\"goal item body\">\n                                <h3 class=\"text-xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-6-1-1-2-2-2-1\" data-name=\"goal title\">\n                                    تطوير النهضة الصناعية والعمرانية\n                                </h3>\n                                <p class=\"mt-2 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-6-1-1-2-2-2-2\" data-name=\"goal description\">\n                                    المساهمة في تطوير النهضة الصناعية والعمرانية في مملكة البحرين.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"goal-row grid gap-4 md:grid-cols-[48px_1fr] md:items-start\" data-kid=\"1-2-6-1-1-2-3\" data-name=\"goal item 2\">\n                            <span class=\"font-sans text-lg font-semibold text-[var(--bse-blue)]\" data-kid=\"1-2-6-1-1-2-3-1\" data-name=\"goal index 02\">\n                                02\n                            </span>\n                            <div data-kid=\"1-2-6-1-1-2-3-2\" data-name=\"goal item body\">\n                                <h3 class=\"text-xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-6-1-1-2-3-2-1\" data-name=\"goal title\">\n                                    تنظيم مهنة الهندسة\n                                </h3>\n                                <p class=\"mt-2 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-6-1-1-2-3-2-2\" data-name=\"goal description\">\n                                    المساهمة في تنظيم قواعد مهنة الهندسة ورفع مستواها بالتعاون مع الجهات المختصة.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"goal-row grid gap-4 md:grid-cols-[48px_1fr] md:items-start\" data-kid=\"1-2-6-1-1-2-4\" data-name=\"goal item 3\">\n                            <span class=\"font-sans text-lg font-semibold text-[var(--bse-blue)]\" data-kid=\"1-2-6-1-1-2-4-1\" data-name=\"goal index 03\">\n                                03\n                            </span>\n                            <div data-kid=\"1-2-6-1-1-2-4-2\" data-name=\"goal item body\">\n                                <h3 class=\"text-xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-6-1-1-2-4-2-1\" data-name=\"goal title\">\n                                    حماية المصالح والحقوق المهنية\n                                </h3>\n                                <p class=\"mt-2 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-6-1-1-2-4-2-2\" data-name=\"goal description\">\n                                    التعبير عن المصالح والحقوق المهنية لأعضاء الجمعية.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"goal-row grid gap-4 md:grid-cols-[48px_1fr] md:items-start\" data-kid=\"1-2-6-1-1-2-5\" data-name=\"goal item 4\">\n                            <span class=\"font-sans text-lg font-semibold text-[var(--bse-blue)]\" data-kid=\"1-2-6-1-1-2-5-1\" data-name=\"goal index 04\">\n                                04\n                            </span>\n                            <div data-kid=\"1-2-6-1-1-2-5-2\" data-name=\"goal item body\">\n                                <h3 class=\"text-xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-6-1-1-2-5-2-1\" data-name=\"goal title\">\n                                    تعزيز روابط الزمالة\n                                </h3>\n                                <p class=\"mt-2 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-6-1-1-2-5-2-2\" data-name=\"goal description\">\n                                    توثيق روابط الود والزمالة بين أعضاء الجمعية.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"goal-row grid gap-4 md:grid-cols-[48px_1fr] md:items-start\" data-kid=\"1-2-6-1-1-2-6\" data-name=\"goal item 5\">\n                            <span class=\"font-sans text-lg font-semibold text-[var(--bse-blue)]\" data-kid=\"1-2-6-1-1-2-6-1\" data-name=\"goal index 05\">\n                                05\n                            </span>\n                            <div data-kid=\"1-2-6-1-1-2-6-2\" data-name=\"goal item body\">\n                                <h3 class=\"text-xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-6-1-1-2-6-2-1\" data-name=\"goal title\">\n                                    توسيع التعاون العلمي والفني\n                                </h3>\n                                <p class=\"mt-2 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-6-1-1-2-6-2-2\" data-name=\"goal description\">\n                                    توطيد التعاون بين مهندسي البحرين وزملائهم عربيًا ودوليًا.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"goal-row grid gap-4 md:grid-cols-[48px_1fr] md:items-start\" data-kid=\"1-2-6-1-1-2-7\" data-name=\"goal item 6\">\n                            <span class=\"font-sans text-lg font-semibold text-[var(--bse-blue)]\" data-kid=\"1-2-6-1-1-2-7-1\" data-name=\"goal index 06\">\n                                06\n                            </span>\n                            <div data-kid=\"1-2-6-1-1-2-7-2\" data-name=\"goal item body\">\n                                <h3 class=\"text-xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-6-1-1-2-7-2-1\" data-name=\"goal title\">\n                                    دعم الأبحاث الهندسية\n                                </h3>\n                                <p class=\"mt-2 text-base leading-8 text-[var(--bse-muted)]\" data-kid=\"1-2-6-1-1-2-7-2-2\" data-name=\"goal description\">\n                                    إجراء وتشجيع الأبحاث عبر النشر والمسابقات والمؤتمرات والمحاضرات والزيارات العلمية.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative border-t border-[var(--bse-line)] bg-[var(--bse-ice)] py-16 md:py-20\" data-kid=\"1-2-7\" data-name=\"values section\">\n            <div class=\"bse-container\" data-kid=\"1-2-7-1\" data-name=\"values container\" dir=\"rtl\">\n                <div class=\"mb-10 flex items-end justify-between gap-6\" data-kid=\"1-2-7-1-1\" data-name=\"values header\">\n                    <div data-kid=\"1-2-7-1-1-1\" data-name=\"values eyebrow\">\n                        <span class=\"bse-eyebrow\" data-kid=\"1-2-7-1-1-1-1\" data-name=\"values eyebrow text content\">\n                            مبادئنا\n                        </span>\n                        <h2 class=\"bse-display mt-4 text-3xl text-[var(--bse-navy)] md:text-4xl\" data-kid=\"1-2-7-1-1-1-2\" data-name=\"values headline\">\n                            قيم تقود العمل\n                        </h2>\n                    </div>\n                    <p class=\"hidden max-w-sm text-base leading-8 text-[var(--bse-muted)] md:block\" data-kid=\"1-2-7-1-1-2\" data-name=\"values description\">\n                        المبادئ التي توجهنا في كل ما نفعله لخدمة الأعضاء والمجتمع الهندسي.\n                    </p>\n                </div>\n                <div class=\"grid border-y border-[var(--bse-line)] md:grid-cols-4\" data-kid=\"1-2-7-1-2\" data-name=\"values grid\">\n                    <div class=\"value-row py-7 md:pl-7\" data-kid=\"1-2-7-1-2-1\" data-name=\"value: integrity\">\n                        <p class=\"text-2xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-7-1-2-1-1\" data-name=\"value title\">\n                            النزاهة\n                        </p>\n                        <p class=\"mt-3 text-base leading-7 text-[var(--bse-muted)]\" data-kid=\"1-2-7-1-2-1-2\" data-name=\"value description\">\n                            أخلاق مهنية وشفافية في كل تعامل.\n                        </p>\n                    </div>\n                    <div class=\"value-row py-7 md:px-7\" data-kid=\"1-2-7-1-2-2\" data-name=\"value: collaboration\">\n                        <p class=\"text-2xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-7-1-2-2-1\" data-name=\"value title\">\n                            التعاون\n                        </p>\n                        <p class=\"mt-3 text-base leading-7 text-[var(--bse-muted)]\" data-kid=\"1-2-7-1-2-2-2\" data-name=\"value description\">\n                            نعمل معًا لتحقيق أهداف مشتركة.\n                        </p>\n                    </div>\n                    <div class=\"value-row py-7 md:px-7\" data-kid=\"1-2-7-1-2-3\" data-name=\"value: excellence\">\n                        <p class=\"text-2xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-7-1-2-3-1\" data-name=\"value title\">\n                            التميز\n                        </p>\n                        <p class=\"mt-3 text-base leading-7 text-[var(--bse-muted)]\" data-kid=\"1-2-7-1-2-3-2\" data-name=\"value description\">\n                            نرفع جودة الخدمة والبرامج باستمرار.\n                        </p>\n                    </div>\n                    <div class=\"value-row py-7 md:pr-7\" data-kid=\"1-2-7-1-2-4\" data-name=\"value: service\">\n                        <p class=\"text-2xl font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-7-1-2-4-1\" data-name=\"value title\">\n                            الخدمة\n                        </p>\n                        <p class=\"mt-3 text-base leading-7 text-[var(--bse-muted)]\" data-kid=\"1-2-7-1-2-4-2\" data-name=\"value description\">\n                            نكرس أنفسنا لأعضاء الجمعية ومجتمعنا.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[var(--bse-navy)] py-20 text-white md:py-24\" data-kid=\"1-2-8\" data-name=\"contact section\" id=\"contact\">\n            <div class=\"absolute left-[-120px] top-[-130px] h-[360px] w-[360px] rounded-full border border-white/10\" data-kid=\"1-2-8-1\" data-name=\"decorative circle 1\">\n            </div>\n            <div class=\"absolute left-[-78px] top-[-88px] h-[275px] w-[275px] rounded-full border border-[#d7b46a]/35\" data-kid=\"1-2-8-2\" data-name=\"decorative circle 2\">\n            </div>\n            <div class=\"relative bse-container\" data-kid=\"1-2-8-3\" data-name=\"contact container\" dir=\"rtl\">\n                <div class=\"grid items-end gap-10 lg:grid-cols-[1fr_auto]\" data-kid=\"1-2-8-3-1\" data-name=\"contact content\">\n                    <div data-kid=\"1-2-8-3-1-1\" data-name=\"contact info group\">\n                        <span class=\"inline-flex items-center gap-3 text-sm font-bold text-[#d7b46a]\" data-kid=\"1-2-8-3-1-1-1\" data-name=\"contact eyebrow\">\n                            <span class=\"h-px w-8 bg-[#d7b46a]\" data-kid=\"1-2-8-3-1-1-1-1\" data-name=\"contact eyebrow line\">\n                            </span>\n                            تواصل معنا\n                        </span>\n                        <h2 class=\"bse-display mt-5 max-w-2xl text-4xl text-white md:text-5xl\" data-kid=\"1-2-8-3-1-1-2\" data-name=\"contact headline\">\n                            كن جزءًا من مجتمع المهندسين\n                        </h2>\n                        <p class=\"mt-5 max-w-2xl text-lg leading-9 text-white/70\" data-kid=\"1-2-8-3-1-1-3\" data-name=\"contact description\">\n                            أبواب الجمعية مفتوحة للأعضاء والجهات الراغبة في التعاون والشراكة، من الجفير في مملكة البحرين.\n                        </p>\n                        <div class=\"mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-white/70\" data-kid=\"1-2-8-3-1-1-4\" data-name=\"contact details list\">\n                            <span data-kid=\"1-2-8-3-1-1-4-1\" data-name=\"phone number\">\n                                +973 1772 7100\n                            </span>\n                            <span data-kid=\"1-2-8-3-1-1-4-2\" data-name=\"email address\">\n                                info@bse.bh\n                            </span>\n                            <span data-kid=\"1-2-8-3-1-1-4-3\" data-name=\"location address\">\n                                الجفير، البحرين\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-wrap gap-3 lg:justify-end\" data-kid=\"1-2-8-3-1-2\" data-name=\"contact action group\">\n                        <a class=\"cta-button cta-primary\" data-kid=\"1-2-8-3-1-2-1\" data-name=\"primary cta button\" href=\"#contact\">\n                            تواصل مع الجمعية\n                            <span aria-hidden=\"true\" data-kid=\"1-2-8-3-1-2-1-1\" data-name=\"cta icon\">\n                                ↗\n                            </span>\n                        </a>\n                        <a class=\"cta-button cta-outline\" data-kid=\"1-2-8-3-1-2-2\" data-name=\"secondary cta button\" href=\"#goals\">\n                            استكشف أهدافنا\n                            <span aria-hidden=\"true\" data-kid=\"1-2-8-3-1-2-2-1\" data-name=\"cta icon\">\n                                ←\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-white/10 bg-[#041127] py-8 text-white/70\" data-kid=\"1-3\" data-name=\"footer container\">\n        <div class=\"bse-container flex flex-col items-center justify-between gap-5 text-center text-sm md:flex-row md:text-right\" data-kid=\"1-3-1\" data-name=\"footer content container\" dir=\"rtl\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1\" data-name=\"footer logo group\">\n                <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"h-10 w-10 object-contain\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                <span class=\"font-semibold text-white\" data-kid=\"1-3-1-1-2\" data-name=\"footer association name\">\n                    جمعية المهندسين البحرينية\n                </span>\n                <span class=\"text-white/40\" data-kid=\"1-3-1-1-3\" data-name=\"footer establishment year\">\n                    منذ عام 1972\n                </span>\n            </div>\n            <div class=\"flex gap-6\" data-kid=\"1-3-1-2\" data-name=\"footer navigation links\">\n                <a class=\"hover:text-white\" data-kid=\"1-3-1-2-1\" data-name=\"footer history link\" href=\"#history\">\n                    تاريخنا\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-3-1-2-2\" data-name=\"footer vision link\" href=\"#vision\">\n                    رؤيتنا\n                </a>\n                <a class=\"hover:text-white\" data-kid=\"1-3-1-2-3\" data-name=\"footer contact link\" href=\"#contact\">\n                    تواصل\n                </a>\n            </div>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
      "created": "2026-09-05T08:24:15.939368+00:00",
