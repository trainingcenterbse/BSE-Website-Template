      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Tajawal:wght@400;500;600;700;800&display=swap');\n\n.bse-blueprint {\n  --navy: #071d3d;\n  --navy-2: #0c2c58;\n  --blue: #1d64d7;\n  --blue-bright: #2d83f3;\n  --sky: #eaf3ff;\n  --paper: #f7faff;\n  --ink: #172033;\n  --muted: #60718a;\n  --line: #d7e1ed;\n  --line-dark: rgba(235, 243, 255, 0.22);\n  --teal: #0b4b50;\n  --teal-soft: #78d2ca;\n  --white: #ffffff;\n  min-height: 100%;\n  margin: 0;\n  background: var(--paper);\n  color: var(--ink);\n  direction: rtl;\n  font-family: 'Tajawal', 'Cairo', 'Inter', Arial, sans-serif;\n  font-weight: 500;\n  line-height: 1.75;\n  overflow: hidden;\n}\n.bse-blueprint *,\n.bse-blueprint *::before,\n.bse-blueprint *::after { box-sizing: border-box; }\n.bse-blueprint h1,\n.bse-blueprint h2,\n.bse-blueprint h3,\n.bse-blueprint h4,\n.bse-blueprint p,\n.bse-blueprint ul,\n.bse-blueprint ol,\n.bse-blueprint figure { margin: 0; }\n.bse-blueprint a { color: inherit; text-decoration: none; }\n.bse-blueprint img { display: block; max-width: 100%; }\n.bse-blueprint button { font: inherit; }\n\n.bp-topbar {\n  position: absolute;\n  inset: 20px 0 auto;\n  z-index: 10;\n  width: min(1180px, calc(100% - 72px));\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 28px;\n  padding: 14px 18px 14px 22px;\n  color: var(--white);\n  border: 1px solid rgba(235,243,255,.18);\n  background: rgba(7,29,61,.72);\n  backdrop-filter: blur(14px);\n}\n.bp-brand { display: inline-flex; align-items: center; gap: 12px; min-width: 238px; }\n.bp-brand img { width: 42px; height: 42px; object-fit: contain; }\n.bp-brand-copy { display: grid; gap: 1px; line-height: 1.15; }\n.bp-brand-copy strong { font-size: 15px; font-weight: 800; letter-spacing: -.2px; }\n.bp-brand-copy span { color: rgba(235,243,255,.62); font-size: 10px; letter-spacing: .14em; direction: ltr; text-align: right; }\n.bp-nav { display: flex; align-items: center; justify-content: center; gap: 28px; color: rgba(235,243,255,.78); font-size: 13px; white-space: nowrap; }\n.bp-nav a { position: relative; padding: 5px 0; }\n.bp-nav a::after { content: ''; position: absolute; right: 0; bottom: -4px; width: 0; height: 1px; background: var(--teal-soft); transition: width .24s ease; }\n.bp-nav a:hover::after { width: 100%; }\n.bp-nav .is-active { color: var(--white); }\n.bp-nav .is-active::after { width: 22px; }\n.bp-header-action { display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(120,210,202,.45); color: var(--white); padding: 9px 14px; font-size: 12px; font-weight: 700; background: rgba(11,75,80,.54); white-space: nowrap; }\n.bp-header-action i { width: 6px; height: 6px; border-radius: 50%; background: var(--teal-soft); }\n\n.bp-hero { position: relative; min-height: 700px; color: var(--white); background: var(--navy); overflow: hidden; }\n.bp-hero-grid {\n  position: absolute; inset: 0;\n  opacity: .26;\n  background-image: linear-gradient(rgba(166,201,238,.14) 1px, transparent 1px), linear-gradient(90deg, rgba(166,201,238,.14) 1px, transparent 1px);\n  background-size: 54px 54px;\n  mask-image: linear-gradient(90deg, transparent 0%, rgba(0,0,0,.9) 48%, rgba(0,0,0,.45) 100%);\n}\n.bp-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(7,29,61,.2), rgba(7,29,61,.72) 53%, rgba(7,29,61,.97)); pointer-events: none; }\n.bp-hero-art { position: absolute; inset: 0 auto 0 0; width: 47%; overflow: hidden; }\n.bp-hero-art img { width: 100%; height: 100%; object-fit: cover; object-position: 54% center; opacity: .5; filter: saturate(.72) contrast(1.08); }\n.bp-hero-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(7,29,61,.08), rgba(7,29,61,.68)); }\n.bp-hero-content { position: relative; z-index: 2; width: min(1180px, calc(100% - 72px)); min-height: 700px; margin: 0 auto; padding: 160px 0 58px; display: grid; grid-template-columns: 1fr 1.18fr; align-items: center; gap: 64px; }\n.bp-hero-copy { grid-column: 2; max-width: 610px; justify-self: end; }\n.bp-kicker { display: inline-flex; align-items: center; gap: 11px; color: var(--teal-soft); text-transform: uppercase; letter-spacing: .18em; font-size: 11px; font-weight: 700; direction: ltr; }\n.bp-kicker::before { content: ''; width: 34px; height: 1px; background: var(--teal-soft); }\n.bp-hero h1 { margin-top: 22px; font-size: clamp(46px, 5vw, 78px); line-height: 1.05; font-weight: 800; letter-spacing: -.045em; max-width: 600px; }\n.bp-hero-lead { margin-top: 22px; max-width: 550px; color: rgba(235,243,255,.78); font-size: 18px; line-height: 2; }\n.bp-hero-rule { width: 92px; height: 2px; margin-top: 30px; background: var(--teal-soft); }\n.bp-hero-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 30px; color: rgba(235,243,255,.66); font-size: 12px; }\n.bp-hero-meta strong { color: var(--white); font-size: 14px; margin-left: 5px; }\n.bp-hero-seal { position: relative; grid-column: 1; grid-row: 1; justify-self: center; width: 320px; height: 320px; display: grid; place-items: center; }\n.bp-seal-ring { position: absolute; border: 1px solid rgba(235,243,255,.55); border-radius: 50%; }\n.bp-seal-ring.one { width: 286px; height: 286px; }\n.bp-seal-ring.two { width: 246px; height: 246px; border-color: rgba(120,210,202,.72); border-style: dashed; }\n.bp-seal-ring.breathing { width: 310px; height: 310px; border-color: rgba(120,210,202,.22); animation: bp-breathe 9s ease-in-out infinite; }\n.bp-seal-cross-x, .bp-seal-cross-y { position: absolute; background: rgba(235,243,255,.18); }\n.bp-seal-cross-x { width: 360px; height: 1px; }\n.bp-seal-cross-y { width: 1px; height: 360px; }\n.bp-seal-mark { position: relative; z-index: 2; width: 164px; height: 164px; padding: 10px; display: grid; place-items: center; background: rgba(247,250,255,.96); border: 6px solid rgba(235,243,255,.72); border-radius: 50%; box-shadow: 0 0 0 1px rgba(7,29,61,.5), 0 20px 70px rgba(0,0,0,.3); }\n.bp-seal-mark img { width: 100%; height: 100%; object-fit: contain; border-radius: 50%; }\n.bp-coordinate { position: absolute; z-index: 3; top: 12px; right: 14px; display: flex; align-items: center; gap: 7px; color: rgba(235,243,255,.7); direction: ltr; font-family: Inter, sans-serif; font-size: 9px; letter-spacing: .08em; }\n.bp-coordinate::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--teal-soft); box-shadow: 0 0 0 5px rgba(120,210,202,.12); animation: bp-point 4.5s ease-in-out infinite; }\n.bp-seal-caption { position: absolute; bottom: -8px; left: 50%; transform: translateX(-50%); color: rgba(235,243,255,.58); font-family: Inter, sans-serif; font-size: 10px; letter-spacing: .2em; direction: ltr; white-space: nowrap; }\n.bp-hero-bottom { position: absolute; z-index: 3; bottom: 22px; left: 0; right: 0; width: min(1180px, calc(100% - 72px)); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; color: rgba(235,243,255,.45); font-family: Inter, sans-serif; font-size: 10px; letter-spacing: .1em; direction: ltr; }\n.bp-hero-bottom span:last-child { direction: rtl; font-family: 'Tajawal', 'Cairo', sans-serif; letter-spacing: 0; }\n\n.bp-section { position: relative; width: min(1120px, calc(100% - 72px)); margin: 0 auto; padding: 112px 0; }\n.bp-intro { background: var(--paper); }\n.bp-intro::before { content: ''; position: absolute; top: 0; right: 0; width: 100%; height: 1px; background: var(--line); }\n.bp-intro-head { display: grid; grid-template-columns: 1.15fr .85fr; gap: 110px; align-items: end; }\n.bp-eyebrow { display: block; margin-bottom: 14px; color: var(--blue); font-family: Inter, 'Cairo', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; direction: ltr; }\n.bp-section h2 { color: var(--navy); font-size: clamp(33px, 3.6vw, 52px); line-height: 1.12; font-weight: 800; letter-spacing: -.04em; }\n.bp-intro-copy p { margin-top: 20px; max-width: 620px; color: var(--muted); font-size: 18px; line-height: 2.1; }\n.bp-index { border-right: 2px solid var(--blue); padding-right: 22px; display: grid; gap: 10px; color: var(--muted); font-size: 13px; }\n.bp-index a { display: flex; justify-content: space-between; gap: 14px; border-bottom: 1px solid var(--line); padding-bottom: 9px; }\n.bp-index a span:first-child { color: var(--blue); font-family: Inter, sans-serif; font-size: 10px; direction: ltr; }\n.bp-index a span:last-child { color: var(--ink); font-weight: 700; }\n.bp-metrics { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 72px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }\n.bp-metric { min-height: 150px; padding: 24px 24px 20px 16px; border-left: 1px solid var(--line); }\n.bp-metric:last-child { border-left: 0; }\n.bp-metric-value { color: var(--navy); font-family: Inter, 'Cairo', sans-serif; font-size: 34px; font-weight: 700; line-height: 1.1; direction: ltr; text-align: right; }\n.bp-metric-label { margin-top: 11px; color: var(--muted); font-size: 13px; }\n.bp-metric-note { margin-top: 6px; color: var(--blue); font-family: Inter, sans-serif; font-size: 9px; letter-spacing: .08em; direction: ltr; }\n\n.bp-history { width: 100%; background: var(--navy-2); color: var(--white); }\n.bp-history-inner { width: min(1120px, calc(100% - 72px)); margin: 0 auto; padding: 82px 0 92px; }\n.bp-history-top { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-bottom: 55px; }\n.bp-history h2 { color: var(--white); }\n.bp-history-intro { max-width: 310px; color: rgba(235,243,255,.62); font-size: 14px; line-height: 1.9; }\n.bp-timeline { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }\n.bp-timeline::before { content: ''; position: absolute; right: 8%; left: 8%; top: 17px; height: 1px; background: rgba(235,243,255,.26); }\n.bp-timeline-item { position: relative; z-index: 1; padding-left: 50px; }\n.bp-timeline-item:last-child { padding-left: 0; }\n.bp-timeline-dot { width: 35px; height: 35px; border: 1px solid var(--teal-soft); background: var(--navy-2); display: grid; place-items: center; border-radius: 50%; margin-bottom: 22px; }\n.bp-timeline-dot::after { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--teal-soft); }\n.bp-timeline-year { color: var(--teal-soft); font-family: Inter, sans-serif; font-size: 26px; font-weight: 700; line-height: 1; direction: ltr; }\n.bp-timeline-title { margin-top: 12px; color: var(--white); font-size: 17px; font-weight: 800; }\n.bp-timeline-copy { margin-top: 8px; max-width: 260px; color: rgba(235,243,255,.58); font-size: 13px; line-height: 1.85; }\n\n.bp-vision { background: var(--white); }\n.bp-vision-layout { display: grid; grid-template-columns: .78fr 1.22fr; gap: 82px; align-items: start; }\n.bp-vision-head { position: sticky; top: 28px; }\n.bp-vision-head p { margin-top: 18px; color: var(--muted); font-size: 15px; line-height: 2; max-width: 290px; }\n.bp-vision-line { width: 54px; height: 2px; background: var(--blue); margin-top: 30px; }\n.bp-compare { display: grid; gap: 18px; }\n.bp-compare-card { position: relative; padding: 32px 34px 32px 30px; border: 1px solid var(--line); background: var(--paper); }\n.bp-compare-card::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--blue); }\n.bp-compare-card:nth-child(2) { background: var(--navy); color: var(--white); border-color: var(--navy); }\n.bp-compare-card:nth-child(2)::before { background: var(--teal-soft); }\n.bp-card-index { display: flex; align-items: center; justify-content: space-between; color: var(--blue); font-family: Inter, sans-serif; font-size: 11px; font-weight: 700; direction: ltr; }\n.bp-compare-card:nth-child(2) .bp-card-index { color: var(--teal-soft); }\n.bp-compare-card h3 { margin-top: 25px; color: var(--navy); font-size: 28px; line-height: 1.2; font-weight: 800; }\n.bp-compare-card:nth-child(2) h3 { color: var(--white); }\n.bp-compare-card p { margin-top: 16px; color: var(--muted); font-size: 16px; line-height: 2; }\n.bp-compare-card:nth-child(2) p { color: rgba(235,243,255,.72); }\n.bp-card-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }\n.bp-card-tags span { border: 1px solid var(--line); padding: 5px 10px; color: var(--blue); font-size: 11px; }\n.bp-compare-card:nth-child(2) .bp-card-tags span { border-color: var(--line-dark); color: rgba(235,243,255,.76); }\n\n.bp-goals { background: var(--paper); border-top: 1px solid var(--line); }\n.bp-goals-head { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-bottom: 50px; }\n.bp-goals-head p { max-width: 410px; color: var(--muted); font-size: 15px; line-height: 2; }\n.bp-goals-layout { display: grid; grid-template-columns: 1.16fr .84fr; gap: 78px; align-items: start; }\n.bp-goal-list { list-style: none; padding: 0; border-top: 1px solid var(--line); }\n.bp-goal-row { display: grid; grid-template-columns: 50px 1fr 24px; gap: 20px; align-items: start; padding: 22px 0; border-bottom: 1px solid var(--line); }\n.bp-goal-no { color: var(--blue); font-family: Inter, sans-serif; font-size: 11px; font-weight: 700; direction: ltr; }\n.bp-goal-row h3 { color: var(--navy); font-size: 17px; line-height: 1.45; font-weight: 800; }\n.bp-goal-row p { margin-top: 5px; color: var(--muted); font-size: 13px; line-height: 1.8; }\n.bp-goal-mark { width: 14px; height: 14px; margin-top: 6px; border: 1px solid var(--blue); border-radius: 50%; position: relative; }\n.bp-goal-mark::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--blue); }\n.bp-pathways { padding: 30px; color: var(--white); background: var(--navy); min-height: 420px; }\n.bp-pathways-top { display: flex; align-items: start; justify-content: space-between; gap: 22px; padding-bottom: 24px; border-bottom: 1px solid var(--line-dark); }\n.bp-pathways small { color: var(--teal-soft); font-family: Inter, sans-serif; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; direction: ltr; }\n.bp-pathways h3 { margin-top: 7px; color: var(--white); font-size: 24px; line-height: 1.25; font-weight: 800; }\n.bp-pathways-code { color: rgba(235,243,255,.5); font-family: Inter, sans-serif; font-size: 10px; direction: ltr; }\n.bp-pathway-list { list-style: none; padding: 0; margin: 8px 0 0; }\n.bp-pathway-list li { display: grid; grid-template-columns: 32px 1fr; gap: 12px; padding: 17px 0; border-bottom: 1px solid var(--line-dark); color: rgba(235,243,255,.82); font-size: 14px; line-height: 1.7; }\n.bp-pathway-list li span { color: var(--teal-soft); font-family: Inter, sans-serif; font-size: 10px; direction: ltr; }\n.bp-pathways-foot { margin-top: 28px; color: rgba(235,243,255,.5); font-size: 12px; line-height: 1.8; }\n\n.bp-values { background: var(--white); border-top: 1px solid var(--line); }\n.bp-values-layout { display: grid; grid-template-columns: .72fr 1.28fr; gap: 100px; align-items: start; }\n.bp-values-intro p { margin-top: 18px; color: var(--muted); font-size: 15px; line-height: 2; }\n.bp-values-list { border-top: 1px solid var(--line); }\n.bp-value { display: grid; grid-template-columns: 54px 1fr; gap: 20px; align-items: start; padding: 22px 0; border-bottom: 1px solid var(--line); }\n.bp-value-index { color: var(--blue); font-family: Inter, sans-serif; font-size: 11px; direction: ltr; }\n.bp-value h3 { color: var(--navy); font-size: 19px; font-weight: 800; }\n.bp-value p { margin-top: 3px; color: var(--muted); font-size: 14px; }\n\n.bp-contact { background: var(--teal); color: var(--white); }\n.bp-contact-grid { display: grid; grid-template-columns: 1fr .95fr; gap: 100px; align-items: end; }\n.bp-contact .bp-eyebrow { color: var(--teal-soft); }\n.bp-contact h2 { color: var(--white); max-width: 520px; }\n.bp-contact-copy { margin-top: 22px; max-width: 475px; color: rgba(238,255,252,.7); font-size: 17px; line-height: 2; }\n.bp-contact-action { display: inline-flex; align-items: center; gap: 14px; margin-top: 30px; padding: 13px 18px; background: var(--white); color: var(--teal); font-size: 13px; font-weight: 800; }\n.bp-contact-action span { font-family: Inter, sans-serif; direction: ltr; }\n.bp-contact-panel { border-top: 1px solid rgba(238,255,252,.28); }\n.bp-contact-row { display: flex; align-items: start; justify-content: space-between; gap: 24px; padding: 17px 0; border-bottom: 1px solid rgba(238,255,252,.2); }\n.bp-contact-row dt { color: rgba(238,255,252,.52); font-size: 12px; }\n.bp-contact-row dd { color: var(--white); font-size: 14px; font-weight: 700; text-align: left; direction: ltr; }\n\n.bp-footer { background: var(--navy); color: rgba(235,243,255,.56); }\n.bp-footer-inner { width: min(1120px, calc(100% - 72px)); margin: 0 auto; padding: 28px 0; display: flex; align-items: center; justify-content: space-between; gap: 24px; font-size: 11px; }\n.bp-footer-brand { display: flex; align-items: center; gap: 10px; color: var(--white); font-weight: 700; }\n.bp-footer-brand img { width: 30px; height: 30px; object-fit: contain; }\n.bp-footer-links { display: flex; align-items: center; gap: 22px; }\n.bp-footer-code { font-family: Inter, sans-serif; direction: ltr; letter-spacing: .09em; font-size: 9px; }\n\n@keyframes bp-breathe { 0%, 100% { transform: scale(.98); opacity: .45; } 50% { transform: scale(1.04); opacity: .9; } }\n@keyframes bp-point { 0%, 100% { transform: scale(.8); opacity: .55; } 50% { transform: scale(1.3); opacity: 1; } }\n@media (prefers-reduced-motion: reduce) { .bp-seal-ring.breathing, .bp-coordinate::before { animation: none; } }\n@media (max-width: 980px) {\n  .bp-nav { gap: 16px; }\n  .bp-topbar, .bp-hero-content, .bp-hero-bottom, .bp-section, .bp-history-inner, .bp-footer-inner { width: min(100% - 44px, 760px); }\n  .bp-hero-content { grid-template-columns: 1fr; padding-top: 150px; }\n  .bp-hero-copy { grid-column: 1; justify-self: start; max-width: 610px; }\n  .bp-hero-seal { display: none; }\n  .bp-hero-art { width: 58%; opacity: .65; }\n  .bp-intro-head, .bp-vision-layout, .bp-goals-layout, .bp-values-layout, .bp-contact-grid { grid-template-columns: 1fr; gap: 42px; }\n  .bp-vision-head { position: static; }\n  .bp-vision-head p { max-width: 560px; }\n  .bp-metrics { grid-template-columns: repeat(2, 1fr); }\n  .bp-metric:nth-child(2) { border-left: 0; }\n  .bp-metric:nth-child(-n+2) { border-bottom: 1px solid var(--line); }\n}\n@media (max-width: 720px) {\n  .bp-topbar { inset: 12px 0 auto; width: calc(100% - 28px); padding: 10px 12px; }\n  .bp-brand { min-width: 0; }\n  .bp-brand-copy strong { font-size: 12px; }\n  .bp-brand-copy span, .bp-nav, .bp-header-action { display: none; }\n  .bp-hero { min-height: 630px; }\n  .bp-hero-content { width: calc(100% - 40px); min-height: 630px; padding: 128px 0 54px; }\n  .bp-hero-art { width: 100%; opacity: .36; }\n  .bp-hero::after { background: rgba(7,29,61,.74); }\n  .bp-hero h1 { font-size: 46px; }\n  .bp-hero-lead { font-size: 16px; line-height: 1.9; }\n  .bp-hero-bottom { width: calc(100% - 40px); bottom: 18px; }\n  .bp-section, .bp-history-inner, .bp-footer-inner { width: calc(100% - 40px); }\n  .bp-section { padding: 72px 0; }\n  .bp-intro-head { gap: 34px; }\n  .bp-section h2 { font-size: 35px; }\n  .bp-intro-copy p { font-size: 16px; }\n  .bp-metrics { margin-top: 48px; }\n  .bp-metric { min-height: 126px; padding: 18px 16px; }\n  .bp-metric-value { font-size: 28px; }\n  .bp-history-inner { padding: 64px 0 70px; }\n  .bp-history-top, .bp-goals-head { display: block; }\n  .bp-history-intro, .bp-goals-head p { margin-top: 18px; }\n  .bp-timeline { grid-template-columns: 1fr; gap: 28px; }\n  .bp-timeline::before { right: 17px; left: auto; top: 12px; bottom: 12px; width: 1px; height: auto; }\n  .bp-timeline-item, .bp-timeline-item:last-child { padding-left: 0; padding-right: 58px; }\n  .bp-timeline-dot { position: absolute; right: 0; top: 0; margin: 0; width: 35px; height: 35px; }\n  .bp-timeline-copy { max-width: 100%; }\n  .bp-compare-card { padding: 25px 24px; }\n  .bp-compare-card h3 { font-size: 24px; }\n  .bp-goals-layout { gap: 42px; }\n  .bp-goal-row { grid-template-columns: 38px 1fr 16px; gap: 12px; }\n  .bp-pathways { padding: 24px; }\n  .bp-contact-grid { gap: 44px; }\n  .bp-contact-row { display: block; }\n  .bp-contact-row dd { margin-top: 3px; text-align: right; direction: rtl; }\n  .bp-footer-inner { align-items: flex-start; flex-direction: column; }\n  .bp-footer-links { gap: 14px; flex-wrap: wrap; }\n}\n</style>\n<div class=\"bse-blueprint\" data-kid=\"1\" data-name=\"page layout container\">\n    <header aria-label=\"التنقل الرئيسي\" class=\"bp-topbar\" data-kid=\"1-1\" data-name=\"header main navigation bar\">\n        <a class=\"bp-brand\" data-kid=\"1-1-1\" data-name=\"brand identity logo and text link\" href=\"#hero\">\n            <img alt=\"شعار جمعية المهندسين البحرينية\" data-kid=\"1-1-1-1\" data-name=\"Bahrain Society of Engineers logo icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n            <span class=\"bp-brand-copy\" data-kid=\"1-1-1-2\" data-name=\"brand name text container\">\n                <strong data-kid=\"1-1-1-2-1\" data-name=\"Bahrain Society of Engineers primary title\">\n                    جمعية المهندسين البحرينية\n                </strong>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"Bahrain Society of Engineers subtitle\">\n                    BAHRAIN SOCIETY OF ENGINEERS\n                </span>\n            </span>\n        </a>\n        <nav class=\"bp-nav\" data-kid=\"1-1-2\" data-name=\"navigation menu links\">\n            <a data-kid=\"1-1-2-1\" data-name=\"overview navigation link\" href=\"#overview\">\n                التعريف\n            </a>\n            <a class=\"is-active\" data-kid=\"1-1-2-2\" data-name=\"history navigation link\" href=\"#history\">\n                من نحن\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"vision navigation link\" href=\"#vision\">\n                الرؤية والرسالة\n            </a>\n            <a data-kid=\"1-1-2-4\" data-name=\"goals navigation link\" href=\"#goals\">\n                الأهداف\n            </a>\n            <a data-kid=\"1-1-2-5\" data-name=\"contact navigation link\" href=\"#contact\">\n                تواصل معنا\n            </a>\n        </nav>\n        <a class=\"bp-header-action\" data-kid=\"1-1-3\" data-name=\"membership center call-to-action button\" href=\"#contact\">\n            <i data-kid=\"1-1-3-1\" data-name=\"membership center icon\">\n            </i>\n            مركز العضوية\n        </a>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content container\">\n        <section class=\"bp-hero\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"hero\">\n            <div aria-hidden=\"true\" class=\"bp-hero-grid\" data-kid=\"1-2-1-1\" data-name=\"decorative hero grid background\">\n            </div>\n            <figure class=\"bp-hero-art\" data-kid=\"1-2-1-2\" data-name=\"hero artistic background figure\">\n                <img alt=\"مشهد معماري لمدينة البحرين\" data-kid=\"1-2-1-2-1\" data-name=\"hero architecture image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-skyline.jpg\"/>\n            </figure>\n            <div class=\"bp-hero-content\" data-kid=\"1-2-1-3\" data-name=\"hero content layout container\">\n                <div class=\"bp-hero-copy\" data-kid=\"1-2-1-3-1\" data-name=\"hero text content container\">\n                    <span class=\"bp-kicker\" data-kid=\"1-2-1-3-1-1\" data-name=\"hero kicker label\">\n                        ABOUT THE SOCIETY\n                    </span>\n                    <h1 data-kid=\"1-2-1-3-1-2\" data-name=\"hero headline\">\n                        هندسةٌ\n                        <br data-kid=\"1-2-1-3-1-2-1\" data-name=\"hero headline line break\"/>\n                        تُراكم الأثر\n                    </h1>\n                    <p class=\"bp-hero-lead\" data-kid=\"1-2-1-3-1-3\" data-name=\"hero subheadline\">\n                        جمعية مهنية تطوعية تعنى بشؤون قطاع المهندسين في البحرين، وترعى مصالحهم، وتطوّر قدراتهم لخدمة المهنة والمجتمع منذ عام 1972.\n                    </p>\n                    <div aria-hidden=\"true\" class=\"bp-hero-rule\" data-kid=\"1-2-1-3-1-4\" data-name=\"hero decorative rule\">\n                    </div>\n                    <div class=\"bp-hero-meta\" data-kid=\"1-2-1-3-1-5\" data-name=\"hero metadata container\">\n                        <span data-kid=\"1-2-1-3-1-5-1\" data-name=\"foundation year metadata item\">\n                            <strong data-kid=\"1-2-1-3-1-5-1-1\" data-name=\"foundation year value\">\n                                1972\n                            </strong>\n                            تاريخ التأسيس\n                        </span>\n                        <span data-kid=\"1-2-1-3-1-5-2\" data-name=\"about us metadata item\">\n                            <strong data-kid=\"1-2-1-3-1-5-2-1\" data-name=\"about us count\">\n                                01\n                            </strong>\n                            من نحن\n                        </span>\n                        <span data-kid=\"1-2-1-3-1-5-3\" data-name=\"years of impact metadata item\">\n                            <strong data-kid=\"1-2-1-3-1-5-3-1\" data-name=\"years of impact count\">\n                                54\n                            </strong>\n                            عامًا من الأثر\n                        </span>\n                    </div>\n                </div>\n                <div aria-label=\"الختم الدائري لجمعية المهندسين البحرينية\" class=\"bp-hero-seal\" data-kid=\"1-2-1-3-2\" data-name=\"hero circular seal graphic\">\n                    <div aria-hidden=\"true\" class=\"bp-seal-cross-x\" data-kid=\"1-2-1-3-2-1\" data-name=\"seal cross x axis\">\n                    </div>\n                    <div aria-hidden=\"true\" class=\"bp-seal-cross-y\" data-kid=\"1-2-1-3-2-2\" data-name=\"seal cross y axis\">\n                    </div>\n                    <div aria-hidden=\"true\" class=\"bp-seal-ring breathing\" data-kid=\"1-2-1-3-2-3\" data-name=\"seal breathing ring\">\n                    </div>\n                    <div aria-hidden=\"true\" class=\"bp-seal-ring one\" data-kid=\"1-2-1-3-2-4\" data-name=\"seal inner ring\">\n                    </div>\n                    <div aria-hidden=\"true\" class=\"bp-seal-ring two\" data-kid=\"1-2-1-3-2-5\" data-name=\"seal dashed ring\">\n                    </div>\n                    <div class=\"bp-coordinate\" data-kid=\"1-2-1-3-2-6\" data-name=\"seal coordinate display\">\n                        26°13'N / 50°35'E\n                    </div>\n                    <div class=\"bp-seal-mark\" data-kid=\"1-2-1-3-2-7\" data-name=\"seal mark container\">\n                        <img alt=\"شعار جمعية المهندسين البحرينية\" data-kid=\"1-2-1-3-2-7-1\" data-name=\"seal logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                    </div>\n                    <span class=\"bp-seal-caption\" data-kid=\"1-2-1-3-2-8\" data-name=\"seal caption\">\n                        BSE / EST. 1972\n                    </span>\n                </div>\n            </div>\n            <div class=\"bp-hero-bottom\" data-kid=\"1-2-1-4\" data-name=\"hero footer bar\">\n                <span data-kid=\"1-2-1-4-1\" data-name=\"hero mission statement\">\n                    ENGINEERING • SERVICE • COMMUNITY\n                </span>\n                <span data-kid=\"1-2-1-4-2\" data-name=\"hero section identifier\">\n                    ملف الجمعية / 01\n                </span>\n            </div>\n        </section>\n        <section class=\"bp-section bp-intro\" data-kid=\"1-2-2\" data-name=\"overview section\" id=\"overview\">\n            <div class=\"bp-intro-head\" data-kid=\"1-2-2-1\" data-name=\"overview layout head\">\n                <div class=\"bp-intro-copy\" data-kid=\"1-2-2-1-1\" data-name=\"overview description copy\">\n                    <span class=\"bp-eyebrow\" data-kid=\"1-2-2-1-1-1\" data-name=\"overview eyebrow label\">\n                        01 / التعريف\n                    </span>\n                    <h2 data-kid=\"1-2-2-1-1-2\" data-name=\"overview headline\">\n                        نصنع مساحة\n                        <br data-kid=\"1-2-2-1-1-2-1\" data-name=\"overview headline break\"/>\n                        ينمو فيها المهندس.\n                    </h2>\n                    <p data-kid=\"1-2-2-1-1-3\" data-name=\"overview description text\">\n                        تجمع الجمعية مهندسي مملكة البحرين من مختلف التخصصات، وتعمل على رفع مستوى المهنة، ودعم التنمية الوطنية، وتمثيل المهندسين محليًا ودوليًا من خلال المعرفة والشراكات والعمل المهني.\n                    </p>\n                </div>\n                <nav aria-label=\"فهرس الصفحة\" class=\"bp-index\" data-kid=\"1-2-2-1-2\" data-name=\"overview page index navigation\">\n                    <a data-kid=\"1-2-2-1-2-1\" data-name=\"overview index link\" href=\"#overview\">\n                        <span data-kid=\"1-2-2-1-2-1-1\" data-name=\"overview index label number\">\n                            01\n                        </span>\n                        <span data-kid=\"1-2-2-1-2-1-2\" data-name=\"overview index link text\">\n                            التعريف\n                        </span>\n                    </a>\n                    <a data-kid=\"1-2-2-1-2-2\" data-name=\"history index link\" href=\"#history\">\n                        <span data-kid=\"1-2-2-1-2-2-1\" data-name=\"history index label number\">\n                            02\n                        </span>\n                        <span data-kid=\"1-2-2-1-2-2-2\" data-name=\"history index link text\">\n                            المسيرة\n                        </span>\n                    </a>\n                    <a data-kid=\"1-2-2-1-2-3\" data-name=\"vision index link\" href=\"#vision\">\n                        <span data-kid=\"1-2-2-1-2-3-1\" data-name=\"vision index label number\">\n                            03\n                        </span>\n                        <span data-kid=\"1-2-2-1-2-3-2\" data-name=\"vision index link text\">\n                            الرؤية والرسالة\n                        </span>\n                    </a>\n                    <a data-kid=\"1-2-2-1-2-4\" data-name=\"goals index link\" href=\"#goals\">\n                        <span data-kid=\"1-2-2-1-2-4-1\" data-name=\"goals index label number\">\n                            04\n                        </span>\n                        <span data-kid=\"1-2-2-1-2-4-2\" data-name=\"goals index link text\">\n                            الأهداف الاستراتيجية\n                        </span>\n                    </a>\n                    <a data-kid=\"1-2-2-1-2-5\" data-name=\"values index link\" href=\"#values\">\n                        <span data-kid=\"1-2-2-1-2-5-1\" data-name=\"values index label number\">\n                            05\n                        </span>\n                        <span data-kid=\"1-2-2-1-2-5-2\" data-name=\"values index link text\">\n                            القيم\n                        </span>\n                    </a>\n                </nav>\n            </div>\n            <div aria-label=\"مؤشرات الجمعية\" class=\"bp-metrics\" data-kid=\"1-2-2-2\" data-name=\"metrics grid container\">\n                <div class=\"bp-metric\" data-kid=\"1-2-2-2-1\" data-name=\"members metric item\">\n                    <div class=\"bp-metric-value\" data-kid=\"1-2-2-2-1-1\" data-name=\"members count\">\n                        +5000\n                    </div>\n                    <div class=\"bp-metric-label\" data-kid=\"1-2-2-2-1-2\" data-name=\"members label\">\n                        عضو في المجتمع الهندسي\n                    </div>\n                    <div class=\"bp-metric-note\" data-kid=\"1-2-2-2-1-3\" data-name=\"members note\">\n                        MEMBERS\n                    </div>\n                </div>\n                <div class=\"bp-metric\" data-kid=\"1-2-2-2-2\" data-name=\"partners metric item\">\n                    <div class=\"bp-metric-value\" data-kid=\"1-2-2-2-2-1\" data-name=\"partners count\">\n                        +50\n                    </div>\n                    <div class=\"bp-metric-label\" data-kid=\"1-2-2-2-2-2\" data-name=\"partners label\">\n                        شريكًا استراتيجيًا\n                    </div>\n                    <div class=\"bp-metric-note\" data-kid=\"1-2-2-2-2-3\" data-name=\"partners note\">\n                        PARTNERS\n                    </div>\n                </div>\n                <div class=\"bp-metric\" data-kid=\"1-2-2-2-3\" data-name=\"programmes metric item\">\n                    <div class=\"bp-metric-value\" data-kid=\"1-2-2-2-3-1\" data-name=\"programmes count\">\n                        +200\n                    </div>\n                    <div class=\"bp-metric-label\" data-kid=\"1-2-2-2-3-2\" data-name=\"programmes label\">\n                        فعالية وبرنامج سنوي\n                    </div>\n                    <div class=\"bp-metric-note\" data-kid=\"1-2-2-2-3-3\" data-name=\"programmes note\">\n                        PROGRAMMES\n                    </div>\n                </div>\n                <div class=\"bp-metric\" data-kid=\"1-2-2-2-4\" data-name=\"established year metric item\">\n                    <div class=\"bp-metric-value\" data-kid=\"1-2-2-2-4-1\" data-name=\"established year count\">\n                        1972\n                    </div>\n                    <div class=\"bp-metric-label\" data-kid=\"1-2-2-2-4-2\" data-name=\"established year label\">\n                        عام تأسيس الجمعية\n                    </div>\n                    <div class=\"bp-metric-note\" data-kid=\"1-2-2-2-4-3\" data-name=\"established year note\">\n                        ESTABLISHED\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bp-history\" data-kid=\"1-2-3\" data-name=\"history section\" id=\"history\">\n            <div class=\"bp-history-inner\" data-kid=\"1-2-3-1\" data-name=\"history inner layout\">\n                <div class=\"bp-history-top\" data-kid=\"1-2-3-1-1\" data-name=\"history top layout\">\n                    <div data-kid=\"1-2-3-1-1-1\" data-name=\"history header container\">\n                        <span class=\"bp-eyebrow\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"history eyebrow label\">\n                            02 / المسيرة\n                        </span>\n                        <h2 data-kid=\"1-2-3-1-1-1-2\" data-name=\"history section headline\">\n                            ثلاث محطات\n                            <br data-kid=\"1-2-3-1-1-1-2-1\" data-name=\"history headline break\"/>\n                            تبني ذاكرة المهنة.\n                        </h2>\n                    </div>\n                    <p class=\"bp-history-intro\" data-kid=\"1-2-3-1-1-2\" data-name=\"history intro description\">\n                        من التأسيس إلى العمل المؤسسي المستمر، تتطور الجمعية مع احتياجات المهندس والقطاع الهندسي في مملكة البحرين.\n                    </p>\n                </div>\n                <div class=\"bp-timeline\" data-kid=\"1-2-3-1-2\" data-name=\"history timeline list\">\n                    <article class=\"bp-timeline-item\" data-kid=\"1-2-3-1-2-1\" data-name=\"timeline item 1\">\n                        <div class=\"bp-timeline-dot\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"timeline dot\">\n                        </div>\n                        <div class=\"bp-timeline-year\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"timeline year 1\">\n                            1972\n                        </div>\n                        <h3 class=\"bp-timeline-title\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"timeline title 1\">\n                            تأسيس الجمعية\n                        </h3>\n                        <p class=\"bp-timeline-copy\" data-kid=\"1-2-3-1-2-1-4\" data-name=\"timeline description 1\">\n                            انطلاقة جمعية المهندسين البحرينية كجمعية مهنية تطوعية تخدم قطاع المهندسين.\n                        </p>\n                    </article>\n                    <article class=\"bp-timeline-item\" data-kid=\"1-2-3-1-2-2\" data-name=\"timeline item 2\">\n                        <div class=\"bp-timeline-dot\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"timeline dot\">\n                        </div>\n                        <div class=\"bp-timeline-year\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"timeline year 2\">\n                            1992\n                        </div>\n                        <h3 class=\"bp-timeline-title\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"timeline title 2\">\n                            إعادة التسجيل\n                        </h3>\n                        <p class=\"bp-timeline-copy\" data-kid=\"1-2-3-1-2-2-4\" data-name=\"timeline description 2\">\n                            إعادة التسجيل بتاريخ 15-3-1992 تحت قيد م/ج/76 وفق قانون الجمعيات والأندية.\n                        </p>\n                    </article>\n                    <article class=\"bp-timeline-item\" data-kid=\"1-2-3-1-2-3\" data-name=\"timeline item 3\">\n                        <div class=\"bp-timeline-dot\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"timeline dot\">\n                        </div>\n                        <div class=\"bp-timeline-year\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"timeline year 3\">\n                            اليوم\n                        </div>\n                        <h3 class=\"bp-timeline-title\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"timeline title 3\">\n                            أثر مهني مستمر\n                        </h3>\n                        <p class=\"bp-timeline-copy\" data-kid=\"1-2-3-1-2-3-4\" data-name=\"timeline description 3\">\n                            برامج فنية واجتماعية وشراكات توسّع أثر المهندس في المجتمع محليًا وإقليميًا.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bp-section bp-vision\" data-kid=\"1-2-4\" data-name=\"vision and mission section\" id=\"vision\">\n            <div class=\"bp-vision-layout\" data-kid=\"1-2-4-1\" data-name=\"vision section layout\">\n                <div class=\"bp-vision-head\" data-kid=\"1-2-4-1-1\" data-name=\"vision section head\">\n                    <span class=\"bp-eyebrow\" data-kid=\"1-2-4-1-1-1\" data-name=\"vision eyebrow label\">\n                        03 / الرؤية والرسالة\n                    </span>\n                    <h2 data-kid=\"1-2-4-1-1-2\" data-name=\"vision section headline\">\n                        اتجاه واضح.\n                        <br data-kid=\"1-2-4-1-1-2-1\" data-name=\"vision headline break\"/>\n                        وعمل قابل للقياس.\n                    </h2>\n                    <p data-kid=\"1-2-4-1-1-3\" data-name=\"vision section intro text\">\n                        نحو قطاع هندسي بحريني أكثر تأثيرًا وتنافسية؛ نربط تطوير المهندس بخدمة المجتمع، ونحوّل المعرفة والشراكات إلى أثر مهني مستدام.\n                    </p>\n                    <div class=\"bp-vision-line\" data-kid=\"1-2-4-1-1-4\" data-name=\"vision section rule\">\n                    </div>\n                </div>\n                <div class=\"bp-compare\" data-kid=\"1-2-4-1-2\" data-name=\"vision comparison cards container\">\n                    <article class=\"bp-compare-card\" data-kid=\"1-2-4-1-2-1\" data-name=\"vision card\">\n                        <div class=\"bp-card-index\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"vision card header\">\n                            <span data-kid=\"1-2-4-1-2-1-1-1\" data-name=\"vision index label\">\n                                01 — VISION\n                            </span>\n                            <span data-kid=\"1-2-4-1-2-1-1-2\" data-name=\"vision index title\">\n                                الرؤية\n                            </span>\n                        </div>\n                        <h3 data-kid=\"1-2-4-1-2-1-2\" data-name=\"vision card title\">\n                            التميز والتفوق\n                            <br data-kid=\"1-2-4-1-2-1-2-1\" data-name=\"vision card title break\"/>\n                            باعتراف إقليمي وعالمي.\n                        </h3>\n                        <p data-kid=\"1-2-4-1-2-1-3\" data-name=\"vision card body\">\n                            تحقيق التميز والتفوق بصفتنا هيئة مهنية هندسية رائدة تسعى وتعمل لكسب الاعتراف والسمعة الطيبة على المستوى الإقليمي والعالمي.\n                        </p>\n                        <div class=\"bp-card-tags\" data-kid=\"1-2-4-1-2-1-4\" data-name=\"vision card tags\">\n                            <span data-kid=\"1-2-4-1-2-1-4-1\" data-name=\"vision tag 1\">\n                                تميز\n                            </span>\n                            <span data-kid=\"1-2-4-1-2-1-4-2\" data-name=\"vision tag 2\">\n                                ريادة\n                            </span>\n                            <span data-kid=\"1-2-4-1-2-1-4-3\" data-name=\"vision tag 3\">\n                                اعتراف عالمي\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"bp-compare-card\" data-kid=\"1-2-4-1-2-2\" data-name=\"mission card\">\n                        <div class=\"bp-card-index\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"mission card header\">\n                            <span data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"mission index label\">\n                                02 — MISSION\n                            </span>\n                            <span data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"mission index title\">\n                                الرسالة\n                            </span>\n                        </div>\n                        <h3 data-kid=\"1-2-4-1-2-2-2\" data-name=\"mission card title\">\n                            احتضان كل تخصص\n                            <br data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"mission card title break\"/>\n                            والارتقاء بكل مهندس.\n                        </h3>\n                        <p data-kid=\"1-2-4-1-2-2-3\" data-name=\"mission card body\">\n                            الجمعية الوطنية التي تحتضن المهندسين من جميع التخصصات وتعمل على الارتقاء بالمستوى المهني والتقني والعلمي للمهندسين.\n                        </p>\n                        <div class=\"bp-card-tags\" data-kid=\"1-2-4-1-2-2-4\" data-name=\"mission card tags\">\n                            <span data-kid=\"1-2-4-1-2-2-4-1\" data-name=\"mission tag 1\">\n                                احتضان\n                            </span>\n                            <span data-kid=\"1-2-4-1-2-2-4-2\" data-name=\"mission tag 2\">\n                                تطوير\n                            </span>\n                            <span data-kid=\"1-2-4-1-2-2-4-3\" data-name=\"mission tag 3\">\n                                تمكين\n                            </span>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bp-section bp-goals\" data-kid=\"1-2-5\" data-name=\"strategic goals section\" id=\"goals\">\n            <div class=\"bp-goals-head\" data-kid=\"1-2-5-1\" data-name=\"goals header layout\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"goals title group\">\n                    <span class=\"bp-eyebrow\" data-kid=\"1-2-5-1-1-1\" data-name=\"goals eyebrow label\">\n                        04 / الإطار الاستراتيجي\n                    </span>\n                    <h2 data-kid=\"1-2-5-1-1-2\" data-name=\"goals section headline\">\n                        أهداف تتحول\n                        <br data-kid=\"1-2-5-1-1-2-1\" data-name=\"goals headline break\"/>\n                        إلى ممارسة.\n                    </h2>\n                </div>\n                <p data-kid=\"1-2-5-1-2\" data-name=\"goals intro description\">\n                    ستة مسارات عملية تحفظ دور الجمعية في تطوير المهنة، وحماية مصالح أعضائها، وربط المعرفة بالنهضة الوطنية.\n                </p>\n            </div>\n            <div class=\"bp-goals-layout\" data-kid=\"1-2-5-2\" data-name=\"goals grid layout\">\n                <ol class=\"bp-goal-list\" data-kid=\"1-2-5-2-1\" data-name=\"goals list container\">\n                    <li class=\"bp-goal-row\" data-kid=\"1-2-5-2-1-1\" data-name=\"goal item 1\">\n                        <span class=\"bp-goal-no\" data-kid=\"1-2-5-2-1-1-1\" data-name=\"goal item number 1\">\n                            01\n                        </span>\n                        <div data-kid=\"1-2-5-2-1-1-2\" data-name=\"goal item body 1\">\n                            <h3 data-kid=\"1-2-5-2-1-1-2-1\" data-name=\"goal item title 1\">\n                                تطوير النهضة الصناعية والعمرانية\n                            </h3>\n                            <p data-kid=\"1-2-5-2-1-1-2-2\" data-name=\"goal item description 1\">\n                                المساهمة في تطوير النهضة الصناعية والعمرانية في مملكة البحرين.\n                            </p>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"bp-goal-mark\" data-kid=\"1-2-5-2-1-1-3\" data-name=\"goal item mark 1\">\n                        </span>\n                    </li>\n                    <li class=\"bp-goal-row\" data-kid=\"1-2-5-2-1-2\" data-name=\"goal item 2\">\n                        <span class=\"bp-goal-no\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"goal item number 2\">\n                            02\n                        </span>\n                        <div data-kid=\"1-2-5-2-1-2-2\" data-name=\"goal item body 2\">\n                            <h3 data-kid=\"1-2-5-2-1-2-2-1\" data-name=\"goal item title 2\">\n                                تنظيم مهنة الهندسة\n                            </h3>\n                            <p data-kid=\"1-2-5-2-1-2-2-2\" data-name=\"goal item description 2\">\n                                المساهمة في تنظيم قواعد مهنة الهندسة ورفع مستواها بالتعاون مع الجهات المختصة.\n                            </p>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"bp-goal-mark\" data-kid=\"1-2-5-2-1-2-3\" data-name=\"goal item mark 2\">\n                        </span>\n                    </li>\n                    <li class=\"bp-goal-row\" data-kid=\"1-2-5-2-1-3\" data-name=\"goal item 3\">\n                        <span class=\"bp-goal-no\" data-kid=\"1-2-5-2-1-3-1\" data-name=\"goal item number 3\">\n                            03\n                        </span>\n                        <div data-kid=\"1-2-5-2-1-3-2\" data-name=\"goal item body 3\">\n                            <h3 data-kid=\"1-2-5-2-1-3-2-1\" data-name=\"goal item title 3\">\n                                حماية المصالح والحقوق المهنية\n                            </h3>\n                            <p data-kid=\"1-2-5-2-1-3-2-2\" data-name=\"goal item description 3\">\n                                التعبير عن المصالح والحقوق المهنية لأعضاء الجمعية.\n                            </p>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"bp-goal-mark\" data-kid=\"1-2-5-2-1-3-3\" data-name=\"goal item mark 3\">\n                        </span>\n                    </li>\n                    <li class=\"bp-goal-row\" data-kid=\"1-2-5-2-1-4\" data-name=\"goal item 4\">\n                        <span class=\"bp-goal-no\" data-kid=\"1-2-5-2-1-4-1\" data-name=\"goal item number 4\">\n                            04\n                        </span>\n                        <div data-kid=\"1-2-5-2-1-4-2\" data-name=\"goal item body 4\">\n                            <h3 data-kid=\"1-2-5-2-1-4-2-1\" data-name=\"goal item title 4\">\n                                تعزيز روابط الزمالة\n                            </h3>\n                            <p data-kid=\"1-2-5-2-1-4-2-2\" data-name=\"goal item description 4\">\n                                توثيق روابط الود والزمالة بين أعضاء الجمعية.\n                            </p>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"bp-goal-mark\" data-kid=\"1-2-5-2-1-4-3\" data-name=\"goal item mark 4\">\n                        </span>\n                    </li>\n                    <li class=\"bp-goal-row\" data-kid=\"1-2-5-2-1-5\" data-name=\"goal item 5\">\n                        <span class=\"bp-goal-no\" data-kid=\"1-2-5-2-1-5-1\" data-name=\"goal item number 5\">\n                            05\n                        </span>\n                        <div data-kid=\"1-2-5-2-1-5-2\" data-name=\"goal item body 5\">\n                            <h3 data-kid=\"1-2-5-2-1-5-2-1\" data-name=\"goal item title 5\">\n                                توسيع التعاون العلمي والفني\n                            </h3>\n                            <p data-kid=\"1-2-5-2-1-5-2-2\" data-name=\"goal item description 5\">\n                                توطيد التعاون بين مهندسي البحرين وزملائهم عربيًا ودوليًا.\n                            </p>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"bp-goal-mark\" data-kid=\"1-2-5-2-1-5-3\" data-name=\"goal item mark 5\">\n                        </span>\n                    </li>\n                    <li class=\"bp-goal-row\" data-kid=\"1-2-5-2-1-6\" data-name=\"goal item 6\">\n                        <span class=\"bp-goal-no\" data-kid=\"1-2-5-2-1-6-1\" data-name=\"goal item number 6\">\n                            06\n                        </span>\n                        <div data-kid=\"1-2-5-2-1-6-2\" data-name=\"goal item body 6\">\n                            <h3 data-kid=\"1-2-5-2-1-6-2-1\" data-name=\"goal item title 6\">\n                                دعم الأبحاث الهندسية\n                            </h3>\n                            <p data-kid=\"1-2-5-2-1-6-2-2\" data-name=\"goal item description 6\">\n                                إجراء وتشجيع الأبحاث عبر النشر والمسابقات والمؤتمرات والمحاضرات والزيارات العلمية.\n                            </p>\n                        </div>\n                        <span aria-hidden=\"true\" class=\"bp-goal-mark\" data-kid=\"1-2-5-2-1-6-3\" data-name=\"goal item mark 6\">\n                        </span>\n                    </li>\n                </ol>\n                <aside class=\"bp-pathways\" data-kid=\"1-2-5-2-2\" data-name=\"pathways aside container\">\n                    <div class=\"bp-pathways-top\" data-kid=\"1-2-5-2-2-1\" data-name=\"pathways header\">\n                        <div data-kid=\"1-2-5-2-2-1-1\" data-name=\"pathways title group\">\n                            <small data-kid=\"1-2-5-2-2-1-1-1\" data-name=\"pathways small label\">\n                                STRATEGIC PATHWAYS\n                            </small>\n                            <h3 data-kid=\"1-2-5-2-2-1-1-2\" data-name=\"pathways main headline\">\n                                مسارات العمل\n                            </h3>\n                        </div>\n                        <span class=\"bp-pathways-code\" data-kid=\"1-2-5-2-2-1-2\" data-name=\"pathways code label\">\n                            BSE / 06\n                        </span>\n                    </div>\n                    <ul class=\"bp-pathway-list\" data-kid=\"1-2-5-2-2-2\" data-name=\"pathways list container\">\n                        <li data-kid=\"1-2-5-2-2-2-1\" data-name=\"pathways list item 1\">\n                            <span data-kid=\"1-2-5-2-2-2-1-1\" data-name=\"pathways list item number 1\">\n                                01\n                            </span>\n                            <p data-kid=\"1-2-5-2-2-2-1-2\" data-name=\"pathways list item title 1\">\n                                المعرفة والتطوير المهني\n                            </p>\n                        </li>\n                        <li data-kid=\"1-2-5-2-2-2-2\" data-name=\"pathways list item 2\">\n                            <span data-kid=\"1-2-5-2-2-2-2-1\" data-name=\"pathways list item number 2\">\n                                02\n                            </span>\n                            <p data-kid=\"1-2-5-2-2-2-2-2\" data-name=\"pathways list item title 2\">\n                                الشراكات والتمثيل المؤسسي\n                            </p>\n                        </li>\n                        <li data-kid=\"1-2-5-2-2-2-3\" data-name=\"pathways list item 3\">\n                            <span data-kid=\"1-2-5-2-2-2-3-1\" data-name=\"pathways list item number 3\">\n                                03\n                            </span>\n                            <p data-kid=\"1-2-5-2-2-2-3-2\" data-name=\"pathways list item title 3\">\n                                المجتمع والعضوية\n                            </p>\n                        </li>\n                        <li data-kid=\"1-2-5-2-2-2-4\" data-name=\"pathways list item 4\">\n                            <span data-kid=\"1-2-5-2-2-2-4-1\" data-name=\"pathways list item number 4\">\n                                04\n                            </span>\n                            <p data-kid=\"1-2-5-2-2-2-4-2\" data-name=\"pathways list item title 4\">\n                                الابتكار والاستدامة\n                            </p>\n                        </li>\n                    </ul>\n                    <p class=\"bp-pathways-foot\" data-kid=\"1-2-5-2-2-3\" data-name=\"pathways footer text\">\n                        كل مسار يربط هدفًا واضحًا بخدمة ملموسة للمهندس والمجتمع.\n                    </p>\n                </aside>\n            </div>\n        </section>\n        <section class=\"bp-section bp-values\" data-kid=\"1-2-6\" data-name=\"values section\" id=\"values\">\n            <div class=\"bp-values-layout\" data-kid=\"1-2-6-1\" data-name=\"values layout container\">\n                <div class=\"bp-values-intro\" data-kid=\"1-2-6-1-1\" data-name=\"values intro container\">\n                    <span class=\"bp-eyebrow\" data-kid=\"1-2-6-1-1-1\" data-name=\"values eyebrow label\">\n                        05 / القيم\n                    </span>\n                    <h2 data-kid=\"1-2-6-1-1-2\" data-name=\"values section headline\">\n                        مبادئ قصيرة.\n                        <br data-kid=\"1-2-6-1-1-2-1\" data-name=\"values headline break\"/>\n                        أثر طويل.\n                    </h2>\n                    <p data-kid=\"1-2-6-1-1-3\" data-name=\"values description text\">\n                        القيم التي توجه قراراتنا، وتحدد الطريقة التي نخدم بها أعضاء الجمعية والمجتمع الهندسي.\n                    </p>\n                </div>\n                <div class=\"bp-values-list\" data-kid=\"1-2-6-1-2\" data-name=\"values list container\">\n                    <div class=\"bp-value\" data-kid=\"1-2-6-1-2-1\" data-name=\"value item 1\">\n                        <span class=\"bp-value-index\" data-kid=\"1-2-6-1-2-1-1\" data-name=\"value index 1\">\n                            01\n                        </span>\n                        <div data-kid=\"1-2-6-1-2-1-2\" data-name=\"value body 1\">\n                            <h3 data-kid=\"1-2-6-1-2-1-2-1\" data-name=\"value title 1\">\n                                النزاهة\n                            </h3>\n                            <p data-kid=\"1-2-6-1-2-1-2-2\" data-name=\"value description 1\">\n                                الالتزام بأعلى معايير الأخلاق المهنية والشفافية.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bp-value\" data-kid=\"1-2-6-1-2-2\" data-name=\"value item 2\">\n                        <span class=\"bp-value-index\" data-kid=\"1-2-6-1-2-2-1\" data-name=\"value index 2\">\n                            02\n                        </span>\n                        <div data-kid=\"1-2-6-1-2-2-2\" data-name=\"value body 2\">\n                            <h3 data-kid=\"1-2-6-1-2-2-2-1\" data-name=\"value title 2\">\n                                التعاون\n                            </h3>\n                            <p data-kid=\"1-2-6-1-2-2-2-2\" data-name=\"value description 2\">\n                                العمل معًا كفريق واحد لتحقيق أهدافنا المشتركة.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bp-value\" data-kid=\"1-2-6-1-2-3\" data-name=\"value item 3\">\n                        <span class=\"bp-value-index\" data-kid=\"1-2-6-1-2-3-1\" data-name=\"value index 3\">\n                            03\n                        </span>\n                        <div data-kid=\"1-2-6-1-2-3-2\" data-name=\"value body 3\">\n                            <h3 data-kid=\"1-2-6-1-2-3-2-1\" data-name=\"value title 3\">\n                                التميز\n                            </h3>\n                            <p data-kid=\"1-2-6-1-2-3-2-2\" data-name=\"value description 3\">\n                                السعي الدائم لتقديم أفضل الخدمات والبرامج الممكنة.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bp-value\" data-kid=\"1-2-6-1-2-4\" data-name=\"value item 4\">\n                        <span class=\"bp-value-index\" data-kid=\"1-2-6-1-2-4-1\" data-name=\"value index 4\">\n                            04\n                        </span>\n                        <div data-kid=\"1-2-6-1-2-4-2\" data-name=\"value body 4\">\n                            <h3 data-kid=\"1-2-6-1-2-4-2-1\" data-name=\"value title 4\">\n                                الخدمة\n                            </h3>\n                            <p data-kid=\"1-2-6-1-2-4-2-2\" data-name=\"value description 4\">\n                                تكريس العمل لخدمة أعضائنا ومجتمعنا المهني.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bp-section bp-contact\" data-kid=\"1-2-7\" data-name=\"contact section\" id=\"contact\">\n            <div class=\"bp-contact-grid\" data-kid=\"1-2-7-1\" data-name=\"contact grid layout\">\n                <div data-kid=\"1-2-7-1-1\" data-name=\"contact header copy\">\n                    <span class=\"bp-eyebrow\" data-kid=\"1-2-7-1-1-1\" data-name=\"contact eyebrow label\">\n                        06 / تواصل معنا\n                    </span>\n                    <h2 data-kid=\"1-2-7-1-1-2\" data-name=\"contact headline\">\n                        لنحوّل المعرفة\n                        <br data-kid=\"1-2-7-1-1-2-1\" data-name=\"contact headline break\"/>\n                        إلى أثر مشترك.\n                    </h2>\n                    <p class=\"bp-contact-copy\" data-kid=\"1-2-7-1-1-3\" data-name=\"contact description text\">\n                        أبواب الجمعية مفتوحة للأعضاء والجهات الراغبة في التعاون والشراكة وبناء مستقبل هندسي أكثر تأثيرًا في مملكة البحرين.\n                    </p>\n                    <a class=\"bp-contact-action\" data-kid=\"1-2-7-1-1-4\" data-name=\"contact call-to-action button\" href=\"#contact\">\n                        ابدأ محادثة\n                        <span data-kid=\"1-2-7-1-1-4-1\" data-name=\"contact call-to-action arrow\">\n                            →\n                        </span>\n                    </a>\n                </div>\n                <dl class=\"bp-contact-panel\" data-kid=\"1-2-7-1-2\" data-name=\"contact info list\">\n                    <div class=\"bp-contact-row\" data-kid=\"1-2-7-1-2-1\" data-name=\"address info row\">\n                        <dt data-kid=\"1-2-7-1-2-1-1\" data-name=\"address label\">\n                            العنوان\n                        </dt>\n                        <dd data-kid=\"1-2-7-1-2-1-2\" data-name=\"address value\">\n                            مبنى الجمعية، الجفير، المنامة\n                        </dd>\n                    </div>\n                    <div class=\"bp-contact-row\" data-kid=\"1-2-7-1-2-2\" data-name=\"phone info row\">\n                        <dt data-kid=\"1-2-7-1-2-2-1\" data-name=\"phone label\">\n                            الهاتف\n                        </dt>\n                        <dd data-kid=\"1-2-7-1-2-2-2\" data-name=\"phone value\">\n                            +973 1772 7100\n                        </dd>\n                    </div>\n                    <div class=\"bp-contact-row\" data-kid=\"1-2-7-1-2-3\" data-name=\"email info row\">\n                        <dt data-kid=\"1-2-7-1-2-3-1\" data-name=\"email label\">\n                            البريد\n                        </dt>\n                        <dd data-kid=\"1-2-7-1-2-3-2\" data-name=\"email value\">\n                            info@bse.bh\n                        </dd>\n                    </div>\n                    <div class=\"bp-contact-row\" data-kid=\"1-2-7-1-2-4\" data-name=\"work hours info row\">\n                        <dt data-kid=\"1-2-7-1-2-4-1\" data-name=\"work hours label\">\n                            ساعات العمل\n                        </dt>\n                        <dd data-kid=\"1-2-7-1-2-4-2\" data-name=\"work hours value\">\n                            الأحد — الخميس / 08:00 — 16:00\n                        </dd>\n                    </div>\n                </dl>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bp-footer\" data-kid=\"1-3\" data-name=\"page footer bar\">\n        <div class=\"bp-footer-inner\" data-kid=\"1-3-1\" data-name=\"footer inner container\">\n            <div class=\"bp-footer-brand\" data-kid=\"1-3-1-1\" data-name=\"footer brand container\">\n                <img alt=\"\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                <span data-kid=\"1-3-1-1-2\" data-name=\"footer brand name\">\n                    جمعية المهندسين البحرينية\n                </span>\n            </div>\n            <div class=\"bp-footer-links\" data-kid=\"1-3-1-2\" data-name=\"footer navigation links\">\n                <a data-kid=\"1-3-1-2-1\" data-name=\"footer overview link\" href=\"#overview\">\n                    من نحن\n                </a>\n                <a data-kid=\"1-3-1-2-2\" data-name=\"footer goals link\" href=\"#goals\">\n                    الأهداف\n                </a>\n                <a data-kid=\"1-3-1-2-3\" data-name=\"footer contact link\" href=\"#contact\">\n                    تواصل\n                </a>\n            </div>\n            <span class=\"bp-footer-code\" data-kid=\"1-3-1-3\" data-name=\"footer copyright code\">\n                © BSE / 1972—2026\n            </span>\n        </div>\n    </footer>\n</div>\n",
