    "var_a0187200cadb": {
      "type": "variant",
      "label": "من نحن — Institutional Story",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6900,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');\n\n  :root {\n    --bse-navy: #0a1d43;\n    --bse-navy-deep: #06132f;\n    --bse-blue: #1268d8;\n    --bse-blue-soft: #dcecff;\n    --bse-canvas: #f3f8fe;\n    --bse-ink: #19253a;\n    --bse-muted: #63728b;\n    --bse-line: #dce6f2;\n    --bse-teal: #0b3a47;\n  }\n\n  @keyframes seal-pulse {\n    0%, 100% { transform: scale(1); opacity: .22; }\n    50% { transform: scale(1.045); opacity: .42; }\n  }\n\n  @keyframes content-reveal {\n    from { opacity: 0; transform: translateY(14px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  .ring-pulse { animation: seal-pulse 8s ease-in-out infinite; transform-origin: center; }\n  .reveal { animation: content-reveal .72s cubic-bezier(.2,0,0,1) both; }\n  .font-ar { font-family: 'Cairo', 'Tajawal', 'Inter', sans-serif; }\n  .font-ui { font-family: 'Inter', 'Cairo', sans-serif; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .ring-pulse, .reveal { animation: none !important; }\n  }\n</style>\n<div class=\"min-h-screen bg-[var(--bse-canvas)] text-[var(--bse-ink)] font-ar antialiased\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\">\n    <div class=\"h-1 bg-[var(--bse-blue)]\" data-kid=\"1-1\" data-name=\"top accent bar\">\n    </div>\n    <header class=\"relative z-20 border-b border-[var(--bse-line)] bg-white/95\" data-kid=\"1-2\" data-name=\"header navigation container\">\n        <nav aria-label=\"التنقل الرئيسي\" class=\"mx-auto flex h-[78px] max-w-[1160px] items-center justify-between gap-8 px-8\" data-kid=\"1-2-1\" data-name=\"main navigation bar\">\n            <a aria-label=\"جمعية المهندسين البحرينية\" class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-2-1-1\" data-name=\"association logo link\" href=\"#top\">\n                <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"h-12 w-12 rounded-full object-cover\" data-kid=\"1-2-1-1-1\" data-name=\"association logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                <span class=\"leading-tight\" data-kid=\"1-2-1-1-2\" data-name=\"association name container\">\n                    <span class=\"block text-[13px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"association name primary text\">\n                        جمعية المهندسين\n                    </span>\n                    <span class=\"block text-[13px] font-bold text-[var(--bse-blue)]\" data-kid=\"1-2-1-1-2-2\" data-name=\"association name secondary text\">\n                        البحرينية\n                    </span>\n                </span>\n            </a>\n            <div class=\"hidden items-center gap-8 text-[14px] font-semibold text-[var(--bse-muted)] lg:flex\" data-kid=\"1-2-1-2\" data-name=\"navigation menu links\">\n                <a class=\"text-[var(--bse-navy)]\" data-kid=\"1-2-1-2-1\" data-name=\"about us navigation link\" href=\"#story\">\n                    من نحن\n                </a>\n                <a class=\"hover:text-[var(--bse-blue)]\" data-kid=\"1-2-1-2-2\" data-name=\"history navigation link\" href=\"#history\">\n                    تاريخ الجمعية\n                </a>\n                <a class=\"hover:text-[var(--bse-blue)]\" data-kid=\"1-2-1-2-3\" data-name=\"vision navigation link\" href=\"#vision\">\n                    رؤيتنا ورسالتنا\n                </a>\n                <a class=\"hover:text-[var(--bse-blue)]\" data-kid=\"1-2-1-2-4\" data-name=\"objectives navigation link\" href=\"#objectives\">\n                    أهدافنا\n                </a>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-3\" data-name=\"utility navigation container\">\n                <a class=\"rounded-lg bg-[var(--bse-blue)] px-5 py-3 text-[13px] font-bold text-white shadow-sm\" data-kid=\"1-2-1-3-1\" data-name=\"apply for membership call-to-action button\" href=\"#contact\">\n                    اطلب العضوية\n                </a>\n                <span class=\"font-ui text-[12px] font-semibold text-[var(--bse-muted)]\" data-kid=\"1-2-1-3-2\" data-name=\"language toggle text\">\n                    EN\n                </span>\n            </div>\n        </nav>\n    </header>\n    <main data-kid=\"1-3\" data-name=\"main content area\" id=\"top\">\n        <section class=\"relative isolate min-h-[500px] overflow-hidden bg-[var(--bse-navy)] text-white\" data-kid=\"1-3-1\" data-name=\"hero section\">\n            <img alt=\"أفق مملكة البحرين\" class=\"absolute inset-y-0 left-0 h-full w-[56%] object-cover opacity-45\" data-kid=\"1-3-1-1\" data-name=\"hero skyline background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/hero-skyline.jpg\"/>\n            <div class=\"absolute inset-0 bg-[linear-gradient(90deg,rgba(6,19,47,.18)_0%,rgba(10,29,67,.70)_47%,rgba(10,29,67,.98)_100%)]\" data-kid=\"1-3-1-2\" data-name=\"hero gradient overlay\">\n            </div>\n            <div class=\"absolute inset-0 bg-[radial-gradient(circle_at_16%_48%,rgba(18,104,216,.34),transparent_34%)]\" data-kid=\"1-3-1-3\" data-name=\"hero radial light effect\">\n            </div>\n            <div class=\"pointer-events-none absolute left-[2%] top-1/2 h-[450px] w-[450px] -translate-y-1/2 rounded-full border border-white/10\" data-kid=\"1-3-1-4\" data-name=\"large decorative ring\">\n            </div>\n            <div class=\"ring-pulse pointer-events-none absolute left-[4.5%] top-1/2 h-[390px] w-[390px] -translate-y-1/2 rounded-full border border-[var(--bse-blue-soft)]/40\" data-kid=\"1-3-1-5\" data-name=\"pulsing decorative ring\">\n            </div>\n            <div class=\"pointer-events-none absolute left-[11%] top-1/2 h-[270px] w-[270px] -translate-y-1/2 rounded-full border border-white/20\" data-kid=\"1-3-1-6\" data-name=\"medium decorative ring\">\n            </div>\n            <div class=\"pointer-events-none absolute left-[18%] top-1/2 h-[120px] w-[120px] -translate-y-1/2 rounded-full border border-white/15\" data-kid=\"1-3-1-7\" data-name=\"small decorative ring\">\n            </div>\n            <div class=\"relative z-10 mx-auto grid min-h-[500px] max-w-[1160px] items-center gap-12 px-8 py-20 lg:grid-cols-[1.08fr_.92fr]\" data-kid=\"1-3-1-8\" data-name=\"hero content grid\">\n                <div class=\"reveal max-w-[650px]\" data-kid=\"1-3-1-8-1\" data-name=\"hero text content container\" style=\"animation-delay:.08s\">\n                    <div class=\"mb-5 flex items-center gap-3 text-[12px] font-bold text-[var(--bse-blue-soft)]\" data-kid=\"1-3-1-8-1-1\" data-name=\"hero breadcrumb container\">\n                        <span class=\"h-px w-10 bg-[var(--bse-blue-soft)]\" data-kid=\"1-3-1-8-1-1-1\" data-name=\"hero breadcrumb line\">\n                        </span>\n                        جمعية المهندسين البحرينية · منذ عام 1972\n                    </div>\n                    <h1 class=\"max-w-[620px] text-[48px] font-semibold leading-[1.08] tracking-[-1px] text-white md:text-[62px]\" data-kid=\"1-3-1-8-1-2\" data-name=\"hero main headline\">\n                        من نحن\n                    </h1>\n                    <p class=\"mt-6 max-w-[610px] text-[20px] font-medium leading-[1.8] text-white/90\" data-kid=\"1-3-1-8-1-3\" data-name=\"hero subheadline\">\n                        جمعية المهندسين البحرينية — رائدة في دعم المهنة الهندسية منذ عام 1972\n                    </p>\n                    <p class=\"mt-5 max-w-[600px] text-[16px] leading-[1.95] text-white/70\" data-kid=\"1-3-1-8-1-4\" data-name=\"hero body text\">\n                        جمعية مهنية تطوعية تعنى بشؤون قطاع المهندسين في البحرين وترعى مصالحهم وتسعى لتطوير قدراتهم من خلال برامجها الفنية والاجتماعية.\n                    </p>\n                    <div class=\"mt-8 flex flex-wrap items-center gap-3\" data-kid=\"1-3-1-8-1-5\" data-name=\"hero button container\">\n                        <a class=\"rounded-lg bg-white px-5 py-3 text-[14px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-1-8-1-5-1\" data-name=\"discover our story button\" href=\"#story\">\n                            اكتشف قصتنا\n                        </a>\n                        <a class=\"rounded-lg border border-white/30 px-5 py-3 text-[14px] font-bold text-white\" data-kid=\"1-3-1-8-1-5-2\" data-name=\"contact us button\" href=\"#contact\">\n                            تواصل مع الجمعية\n                        </a>\n                    </div>\n                    <div class=\"mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 text-[13px] text-white/65\" data-kid=\"1-3-1-8-1-6\" data-name=\"hero metadata container\">\n                        <span data-kid=\"1-3-1-8-1-6-1\" data-name=\"hero location text\">\n                            مملكة البحرين\n                        </span>\n                        <span class=\"h-1 w-1 rounded-full bg-white/40\" data-kid=\"1-3-1-8-1-6-2\" data-name=\"hero separator dot\">\n                        </span>\n                        <span data-kid=\"1-3-1-8-1-6-3\" data-name=\"hero community text\">\n                            مجتمع مهني متنوع\n                        </span>\n                        <span class=\"h-1 w-1 rounded-full bg-white/40\" data-kid=\"1-3-1-8-1-6-4\" data-name=\"hero separator dot\">\n                        </span>\n                        <span data-kid=\"1-3-1-8-1-6-5\" data-name=\"hero sustainability text\">\n                            نحو أثر مستدام\n                        </span>\n                    </div>\n                </div>\n                <div aria-label=\"الختم الرسمي للجمعية\" class=\"relative hidden min-h-[360px] lg:block\" data-kid=\"1-3-1-8-2\" data-name=\"hero decorative seal container\">\n                    <div class=\"absolute left-1/2 top-1/2 flex h-[230px] w-[230px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-white/[.04]\" data-kid=\"1-3-1-8-2-1\" data-name=\"seal inner border ring\">\n                        <div class=\"flex h-[190px] w-[190px] items-center justify-center rounded-full border border-white/25 bg-[var(--bse-navy)]/55\" data-kid=\"1-3-1-8-2-1-1\" data-name=\"seal image container\">\n                            <img alt=\"الختم الرسمي لجمعية المهندسين البحرينية\" class=\"h-[142px] w-[142px] rounded-full object-cover\" data-kid=\"1-3-1-8-2-1-1-1\" data-name=\"seal logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                        </div>\n                    </div>\n                    <div class=\"absolute bottom-4 left-1/2 -translate-x-1/2 font-ui text-[11px] tracking-[.22em] text-white/55\" data-kid=\"1-3-1-8-2-2\" data-name=\"seal subtext\">\n                        BAHRAIN SOCIETY OF ENGINEERS\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-white py-24\" data-kid=\"1-3-2\" data-name=\"about section\" id=\"story\">\n            <div class=\"mx-auto grid max-w-[1160px] items-center gap-16 px-8 lg:grid-cols-[.72fr_1.28fr]\" data-kid=\"1-3-2-1\" data-name=\"about content grid\">\n                <div class=\"reveal relative order-2 lg:order-1\" data-kid=\"1-3-2-1-1\" data-name=\"about image container\" style=\"animation-delay:.14s\">\n                    <div class=\"relative flex min-h-[370px] items-center justify-center overflow-hidden rounded-xl border border-[var(--bse-line)] bg-[var(--bse-canvas)] p-12\" data-kid=\"1-3-2-1-1-1\" data-name=\"about decorative background\">\n                        <div class=\"absolute h-[310px] w-[310px] rounded-full border border-[var(--bse-blue)]/15\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"about decorative outer ring\">\n                        </div>\n                        <div class=\"absolute h-[245px] w-[245px] rounded-full border border-[var(--bse-blue)]/25\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"about decorative middle ring\">\n                        </div>\n                        <div class=\"absolute h-[185px] w-[185px] rounded-full border border-[var(--bse-blue)]/35\" data-kid=\"1-3-2-1-1-1-3\" data-name=\"about decorative inner ring\">\n                        </div>\n                        <div class=\"relative flex flex-col items-center\" data-kid=\"1-3-2-1-1-1-4\" data-name=\"about logo container\">\n                            <img alt=\"الشعار الرسمي للجمعية\" class=\"h-[150px] w-[150px] rounded-full object-cover shadow-[0_12px_28px_rgba(10,29,67,.16)]\" data-kid=\"1-3-2-1-1-1-4-1\" data-name=\"about logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                            <span class=\"mt-6 font-ui text-[11px] font-semibold tracking-[.18em] text-[var(--bse-muted)]\" data-kid=\"1-3-2-1-1-1-4-2\" data-name=\"about established year text\">\n                                EST. 1972\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"absolute -bottom-5 right-8 rounded-lg border border-[var(--bse-line)] bg-white px-5 py-3 shadow-[0_8px_24px_rgba(10,29,67,.08)]\" data-kid=\"1-3-2-1-1-2\" data-name=\"about identity badge\">\n                        <span class=\"block text-[11px] text-[var(--bse-muted)]\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"about identity label\">\n                            هوية الجمعية\n                        </span>\n                        <span class=\"mt-1 block text-[15px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"about identity values\">\n                            مهنية · تطوعية · تطوير\n                        </span>\n                    </div>\n                </div>\n                <div class=\"reveal order-1 lg:order-2\" data-kid=\"1-3-2-1-2\" data-name=\"about text content container\" style=\"animation-delay:.04s\">\n                    <div class=\"mb-4 flex items-center gap-3 text-[12px] font-bold text-[var(--bse-blue)]\" data-kid=\"1-3-2-1-2-1\" data-name=\"about section label container\">\n                        <span class=\"h-px w-10 bg-[var(--bse-blue)]\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"about section label line\">\n                        </span>\n                        التعريف بالجمعية\n                    </div>\n                    <h2 class=\"max-w-[620px] text-[38px] font-semibold leading-[1.2] tracking-[-.6px] text-[var(--bse-navy)] md:text-[48px]\" data-kid=\"1-3-2-1-2-2\" data-name=\"about headline\">\n                        نبني مجتمعًا هندسيًا أكثر تأثيرًا\n                    </h2>\n                    <p class=\"mt-7 max-w-[650px] text-[18px] leading-[2] text-[var(--bse-muted)]\" data-kid=\"1-3-2-1-2-3\" data-name=\"about first paragraph\">\n                        جمعية مهنية تطوعية تعنى بشؤون قطاع المهندسين في البحرين وترعى مصالحهم وتسعى لتطوير قدراتهم من خلال برامجها الفنية والاجتماعية.\n                    </p>\n                    <p class=\"mt-5 max-w-[620px] text-[16px] leading-[2] text-[var(--bse-muted)]\" data-kid=\"1-3-2-1-2-4\" data-name=\"about second paragraph\">\n                        نجمع المهندسين من مختلف التخصصات، ونحوّل المعرفة والشراكات والبرامج المهنية إلى أثر ملموس يخدم المهنة والمجتمع في مملكة البحرين.\n                    </p>\n                    <div class=\"mt-8 flex items-center gap-4 border-t border-[var(--bse-line)] pt-6\" data-kid=\"1-3-2-1-2-5\" data-name=\"about founding year stat container\">\n                        <span class=\"font-ui text-[28px] font-semibold text-[var(--bse-blue)]\" data-kid=\"1-3-2-1-2-5-1\" data-name=\"founding year number\">\n                            1972\n                        </span>\n                        <span class=\"h-8 w-px bg-[var(--bse-line)]\" data-kid=\"1-3-2-1-2-5-2\" data-name=\"about stat divider\">\n                        </span>\n                        <span class=\"text-[14px] leading-7 text-[var(--bse-muted)]\" data-kid=\"1-3-2-1-2-5-3\" data-name=\"about founding description text\">\n                            عام تأسيس جمعية المهندسين البحرينية وبداية مسيرة مهنية مستمرة.\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-y border-[var(--bse-line)] bg-[var(--bse-canvas)] py-10\" data-kid=\"1-3-3\" data-name=\"statistics section\">\n            <div class=\"mx-auto grid max-w-[1160px] grid-cols-2 gap-y-8 px-8 md:grid-cols-4 md:gap-0\" data-kid=\"1-3-3-1\" data-name=\"statistics grid container\">\n                <div class=\"border-[var(--bse-line)] px-6 text-center md:border-s first:ps-0\" data-kid=\"1-3-3-1-1\" data-name=\"members stat container\">\n                    <div class=\"font-ui text-[42px] font-semibold leading-none text-[var(--bse-navy)]\" data-kid=\"1-3-3-1-1-1\" data-name=\"members count\">\n                        +5000\n                    </div>\n                    <div class=\"mt-3 text-[14px] text-[var(--bse-muted)]\" data-kid=\"1-3-3-1-1-2\" data-name=\"members label\">\n                        عضو في المجتمع الهندسي\n                    </div>\n                </div>\n                <div class=\"border-[var(--bse-line)] px-6 text-center md:border-s\" data-kid=\"1-3-3-1-2\" data-name=\"partners stat container\">\n                    <div class=\"font-ui text-[42px] font-semibold leading-none text-[var(--bse-navy)]\" data-kid=\"1-3-3-1-2-1\" data-name=\"partners count\">\n                        +50\n                    </div>\n                    <div class=\"mt-3 text-[14px] text-[var(--bse-muted)]\" data-kid=\"1-3-3-1-2-2\" data-name=\"partners label\">\n                        شريك استراتيجي\n                    </div>\n                </div>\n                <div class=\"border-[var(--bse-line)] px-6 text-center md:border-s\" data-kid=\"1-3-3-1-3\" data-name=\"programs stat container\">\n                    <div class=\"font-ui text-[42px] font-semibold leading-none text-[var(--bse-navy)]\" data-kid=\"1-3-3-1-3-1\" data-name=\"programs count\">\n                        +200\n                    </div>\n                    <div class=\"mt-3 text-[14px] text-[var(--bse-muted)]\" data-kid=\"1-3-3-1-3-2\" data-name=\"programs label\">\n                        فعالية وبرنامج\n                    </div>\n                </div>\n                <div class=\"px-6 text-center md:pe-0\" data-kid=\"1-3-3-1-4\" data-name=\"experience stat container\">\n                    <div class=\"font-ui text-[42px] font-semibold leading-none text-[var(--bse-navy)]\" data-kid=\"1-3-3-1-4-1\" data-name=\"experience count\">\n                        45+\n                    </div>\n                    <div class=\"mt-3 text-[14px] text-[var(--bse-muted)]\" data-kid=\"1-3-3-1-4-2\" data-name=\"experience label\">\n                        سنة من الخبرة\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-white py-24\" data-kid=\"1-3-4\" data-name=\"history section\" id=\"history\">\n            <div class=\"mx-auto max-w-[1160px] px-8\" data-kid=\"1-3-4-1\" data-name=\"history content wrapper\">\n                <div class=\"flex flex-col justify-between gap-5 border-b border-[var(--bse-line)] pb-8 md:flex-row md:items-end\" data-kid=\"1-3-4-1-1\" data-name=\"history header container\">\n                    <div data-kid=\"1-3-4-1-1-1\" data-name=\"history section title container\">\n                        <div class=\"mb-4 flex items-center gap-3 text-[12px] font-bold text-[var(--bse-blue)]\" data-kid=\"1-3-4-1-1-1-1\" data-name=\"history section line container\">\n                            <span class=\"h-px w-10 bg-[var(--bse-blue)]\" data-kid=\"1-3-4-1-1-1-1-1\">\n                            </span>\n                            محطات رئيسية\n                        </div>\n                        <h2 class=\"text-[38px] font-semibold leading-tight text-[var(--bse-navy)] md:text-[46px]\" data-kid=\"1-3-4-1-1-1-2\" data-name=\"history headline\">\n                            تاريخ يتقدم مع المهنة\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[360px] text-[15px] leading-[1.9] text-[var(--bse-muted)]\" data-kid=\"1-3-4-1-1-2\" data-name=\"history description\">\n                        رحلة تأسيس الجمعية وتطورها عبر الزمن، من الانطلاقة الأولى إلى مجتمع هندسي أكثر ترابطًا وتأثيرًا.\n                    </p>\n                </div>\n                <div class=\"relative mt-14 grid gap-10 md:grid-cols-3 md:gap-8\" data-kid=\"1-3-4-1-2\" data-name=\"history timeline grid\">\n                    <div class=\"pointer-events-none absolute right-[16.66%] left-[16.66%] top-[-22px] hidden h-px bg-[var(--bse-line)] md:block\" data-kid=\"1-3-4-1-2-1\" data-name=\"timeline connecting line\">\n                    </div>\n                    <article class=\"relative border-t-2 border-[var(--bse-blue)] pt-6\" data-kid=\"1-3-4-1-2-2\" data-name=\"history founding entry\">\n                        <div class=\"mb-6 flex items-center justify-between\" data-kid=\"1-3-4-1-2-2-1\" data-name=\"history entry header container\">\n                            <span class=\"font-ui text-[40px] font-semibold leading-none text-[var(--bse-blue)]\" data-kid=\"1-3-4-1-2-2-1-1\" data-name=\"history founding year\">\n                                1972\n                            </span>\n                            <span class=\"h-3 w-3 rounded-full bg-[var(--bse-blue)] ring-8 ring-[var(--bse-blue)]/10\" data-kid=\"1-3-4-1-2-2-1-2\" data-name=\"history timeline node\">\n                            </span>\n                        </div>\n                        <h3 class=\"text-[21px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-4-1-2-2-2\" data-name=\"history founding title\">\n                            تأسيس الجمعية\n                        </h3>\n                        <p class=\"mt-3 text-[15px] leading-[1.9] text-[var(--bse-muted)]\" data-kid=\"1-3-4-1-2-2-3\" data-name=\"history founding description\">\n                            تأسست جمعية المهندسين البحرينية في سنة 1972، لتكون مساحة مهنية تجمع مهندسي المملكة.\n                        </p>\n                    </article>\n                    <article class=\"relative border-t-2 border-[var(--bse-navy)] pt-6\" data-kid=\"1-3-4-1-2-3\" data-name=\"history registration entry\">\n                        <div class=\"mb-6 flex items-center justify-between\" data-kid=\"1-3-4-1-2-3-1\" data-name=\"history registration header container\">\n                            <span class=\"font-ui text-[40px] font-semibold leading-none text-[var(--bse-navy)]\" data-kid=\"1-3-4-1-2-3-1-1\" data-name=\"history registration year\">\n                                1992\n                            </span>\n                            <span class=\"h-3 w-3 rounded-full bg-[var(--bse-navy)] ring-8 ring-[var(--bse-navy)]/10\" data-kid=\"1-3-4-1-2-3-1-2\" data-name=\"history timeline node\">\n                            </span>\n                        </div>\n                        <h3 class=\"text-[21px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-4-1-2-3-2\" data-name=\"history registration title\">\n                            إعادة التسجيل\n                        </h3>\n                        <p class=\"mt-3 text-[15px] leading-[1.9] text-[var(--bse-muted)]\" data-kid=\"1-3-4-1-2-3-3\" data-name=\"history registration description\">\n                            تمت إعادة تسجيل الجمعية بتاريخ 15-3-92 تحت قيد م/ج/76 وفق قانون الجمعيات والأندية الاجتماعية والثقافية.\n                        </p>\n                    </article>\n                    <article class=\"relative border-t-2 border-[var(--bse-blue)] pt-6\" data-kid=\"1-3-4-1-2-4\" data-name=\"history current entry\">\n                        <div class=\"mb-6 flex items-center justify-between\" data-kid=\"1-3-4-1-2-4-1\" data-name=\"history current entry header container\">\n                            <span class=\"text-[40px] font-semibold leading-none text-[var(--bse-blue)]\" data-kid=\"1-3-4-1-2-4-1-1\" data-name=\"history current label\">\n                                اليوم\n                            </span>\n                            <span class=\"h-3 w-3 rounded-full bg-[var(--bse-blue)] ring-8 ring-[var(--bse-blue)]/10\" data-kid=\"1-3-4-1-2-4-1-2\" data-name=\"history timeline node\">\n                            </span>\n                        </div>\n                        <h3 class=\"text-[21px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-4-1-2-4-2\" data-name=\"history current title\">\n                            مسيرة مستمرة\n                        </h3>\n                        <p class=\"mt-3 text-[15px] leading-[1.9] text-[var(--bse-muted)]\" data-kid=\"1-3-4-1-2-4-3\" data-name=\"history current description\">\n                            تواصل الجمعية تطوير المهنة، ورعاية مصالح أعضائها، وبناء الشراكات التي تعزز أثر الهندسة في البحرين.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[var(--bse-navy)] py-24 text-white\" data-kid=\"1-3-5\" data-name=\"vision section\" id=\"vision\">\n            <div class=\"pointer-events-none absolute -left-32 top-1/2 h-[520px] w-[520px] -translate-y-1/2 rounded-full border border-white/10\" data-kid=\"1-3-5-1\" data-name=\"vision decorative ring\">\n            </div>\n            <div class=\"pointer-events-none absolute -left-6 top-1/2 h-[330px] w-[330px] -translate-y-1/2 rounded-full border border-[var(--bse-blue)]/30\" data-kid=\"1-3-5-2\" data-name=\"vision decorative ring\">\n            </div>\n            <div class=\"relative mx-auto max-w-[1160px] px-8\" data-kid=\"1-3-5-3\" data-name=\"vision content container\">\n                <div class=\"mb-12 max-w-[660px]\" data-kid=\"1-3-5-3-1\" data-name=\"vision header container\">\n                    <div class=\"mb-4 flex items-center gap-3 text-[12px] font-bold text-[var(--bse-blue-soft)]\" data-kid=\"1-3-5-3-1-1\" data-name=\"vision label container\">\n                        <span class=\"h-px w-10 bg-[var(--bse-blue-soft)]\" data-kid=\"1-3-5-3-1-1-1\" data-name=\"vision line\">\n                        </span>\n                        رؤيتنا ورسالتنا\n                    </div>\n                    <h2 class=\"text-[38px] font-semibold leading-tight md:text-[46px]\" data-kid=\"1-3-5-3-1-2\" data-name=\"vision headline\">\n                        نحو مستقبل هندسي مشرق ومستدام\n                    </h2>\n                </div>\n                <div class=\"grid gap-5 md:grid-cols-2\" data-kid=\"1-3-5-3-2\" data-name=\"vision grid\">\n                    <article class=\"rounded-lg border border-white/15 bg-white/[.05] p-8\" data-kid=\"1-3-5-3-2-1\" data-name=\"vision card\">\n                        <div class=\"mb-8 flex items-center justify-between\" data-kid=\"1-3-5-3-2-1-1\" data-name=\"vision card header\">\n                            <span class=\"font-ui text-[14px] font-semibold text-[var(--bse-blue-soft)]\" data-kid=\"1-3-5-3-2-1-1-1\" data-name=\"vision card index\">\n                                01\n                            </span>\n                            <span class=\"h-2 w-2 rounded-full bg-[var(--bse-blue-soft)]\" data-kid=\"1-3-5-3-2-1-1-2\" data-name=\"vision card node\">\n                            </span>\n                        </div>\n                        <h3 class=\"text-[27px] font-semibold\" data-kid=\"1-3-5-3-2-1-2\" data-name=\"vision title\">\n                            رؤيتنا\n                        </h3>\n                        <p class=\"mt-5 text-[16px] leading-[2] text-white/75\" data-kid=\"1-3-5-3-2-1-3\" data-name=\"vision description\">\n                            تحقيق التميز والتفوق بصفتنا هيئة مهنية هندسية رائدة تسعى وتعمل لكسب الاعتراف والسمعة الطيبة على المستوى الإقليمي والعالمي.\n                        </p>\n                    </article>\n                    <article class=\"rounded-lg border border-white/15 bg-white/[.05] p-8\" data-kid=\"1-3-5-3-2-2\" data-name=\"mission card\">\n                        <div class=\"mb-8 flex items-center justify-between\" data-kid=\"1-3-5-3-2-2-1\" data-name=\"mission card header\">\n                            <span class=\"font-ui text-[14px] font-semibold text-[var(--bse-blue-soft)]\" data-kid=\"1-3-5-3-2-2-1-1\" data-name=\"mission card index\">\n                                02\n                            </span>\n                            <span class=\"h-2 w-2 rounded-full bg-[var(--bse-blue-soft)]\" data-kid=\"1-3-5-3-2-2-1-2\" data-name=\"mission card node\">\n                            </span>\n                        </div>\n                        <h3 class=\"text-[27px] font-semibold\" data-kid=\"1-3-5-3-2-2-2\" data-name=\"mission title\">\n                            رسالتنا\n                        </h3>\n                        <p class=\"mt-5 text-[16px] leading-[2] text-white/75\" data-kid=\"1-3-5-3-2-2-3\" data-name=\"mission description\">\n                            الجمعية الوطنية الرائدة التي تحتضن المهندسين من جميع التخصصات وتعمل على الارتقاء بالمستوى المهني والتقني والعلمي للمهندسين.\n                        </p>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[var(--bse-canvas)] py-24\" data-kid=\"1-3-6\" data-name=\"objectives section\" id=\"objectives\">\n            <div class=\"mx-auto grid max-w-[1160px] gap-14 px-8 lg:grid-cols-[.72fr_1.28fr]\" data-kid=\"1-3-6-1\" data-name=\"objectives content grid\">\n                <div data-kid=\"1-3-6-1-1\" data-name=\"objectives header container\">\n                    <div class=\"mb-4 flex items-center gap-3 text-[12px] font-bold text-[var(--bse-blue)]\" data-kid=\"1-3-6-1-1-1\" data-name=\"objectives label container\">\n                        <span class=\"h-px w-10 bg-[var(--bse-blue)]\" data-kid=\"1-3-6-1-1-1-1\" data-name=\"objectives line\">\n                        </span>\n                        الإطار الاستراتيجي\n                    </div>\n                    <h2 class=\"text-[38px] font-semibold leading-[1.2] text-[var(--bse-navy)] md:text-[48px]\" data-kid=\"1-3-6-1-1-2\" data-name=\"objectives headline\">\n                        أهدافنا واستراتيجيتنا\n                    </h2>\n                    <p class=\"mt-6 max-w-[380px] text-[17px] leading-[2] text-[var(--bse-muted)]\" data-kid=\"1-3-6-1-1-3\" data-name=\"objectives description\">\n                        نحو قطاع هندسي بحريني أكثر تأثيرًا وتنافسية؛ نربط تطوير المهندس بخدمة المجتمع، ونحوّل المعرفة والشراكات إلى أثر مهني مستدام.\n                    </p>\n                    <div class=\"mt-10 border-s-2 border-[var(--bse-blue)] ps-5 text-[13px] font-bold leading-8 text-[var(--bse-muted)]\" data-kid=\"1-3-6-1-1-4\" data-name=\"objectives summary\">\n                        ستة مسارات عملية\n                        <br data-kid=\"1-3-6-1-1-4-1\" data-name=\"objectives line break\"/>\n                        تدعم المهنة والمجتمع\n                    </div>\n                </div>\n                <div class=\"border-t border-[var(--bse-line)]\" data-kid=\"1-3-6-1-2\" data-name=\"objectives list\">\n                    <article class=\"grid grid-cols-[54px_1fr] gap-5 border-b border-[var(--bse-line)] py-6\" data-kid=\"1-3-6-1-2-1\" data-name=\"objective one entry\">\n                        <span class=\"font-ui text-[14px] font-semibold text-[var(--bse-blue)]\" data-kid=\"1-3-6-1-2-1-1\" data-name=\"objective one index\">\n                            01\n                        </span>\n                        <div data-kid=\"1-3-6-1-2-1-2\" data-name=\"objective one text content\">\n                            <h3 class=\"text-[18px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-6-1-2-1-2-1\" data-name=\"objective one title\">\n                                تطوير النهضة الصناعية والعمرانية\n                            </h3>\n                            <p class=\"mt-2 text-[14px] leading-8 text-[var(--bse-muted)]\" data-kid=\"1-3-6-1-2-1-2-2\" data-name=\"objective one description\">\n                                المساهمة في تطوير النهضة الصناعية والعمرانية في مملكة البحرين.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"grid grid-cols-[54px_1fr] gap-5 border-b border-[var(--bse-line)] py-6\" data-kid=\"1-3-6-1-2-2\" data-name=\"objective two entry\">\n                        <span class=\"font-ui text-[14px] font-semibold text-[var(--bse-blue)]\" data-kid=\"1-3-6-1-2-2-1\" data-name=\"objective two index\">\n                            02\n                        </span>\n                        <div data-kid=\"1-3-6-1-2-2-2\" data-name=\"objective two text content\">\n                            <h3 class=\"text-[18px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-6-1-2-2-2-1\" data-name=\"objective two title\">\n                                تنظيم مهنة الهندسة\n                            </h3>\n                            <p class=\"mt-2 text-[14px] leading-8 text-[var(--bse-muted)]\" data-kid=\"1-3-6-1-2-2-2-2\" data-name=\"objective two description\">\n                                المساهمة في تنظيم قواعد مهنة الهندسة ورفع مستواها بالتعاون مع الجهات المختصة.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"grid grid-cols-[54px_1fr] gap-5 border-b border-[var(--bse-line)] py-6\" data-kid=\"1-3-6-1-2-3\" data-name=\"objective three entry\">\n                        <span class=\"font-ui text-[14px] font-semibold text-[var(--bse-blue)]\" data-kid=\"1-3-6-1-2-3-1\" data-name=\"objective three index\">\n                            03\n                        </span>\n                        <div data-kid=\"1-3-6-1-2-3-2\" data-name=\"objective three text content\">\n                            <h3 class=\"text-[18px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-6-1-2-3-2-1\" data-name=\"objective three title\">\n                                حماية المصالح والحقوق المهنية\n                            </h3>\n                            <p class=\"mt-2 text-[14px] leading-8 text-[var(--bse-muted)]\" data-kid=\"1-3-6-1-2-3-2-2\" data-name=\"objective three description\">\n                                التعبير عن المصالح والحقوق المهنية لأعضاء الجمعية.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"grid grid-cols-[54px_1fr] gap-5 border-b border-[var(--bse-line)] py-6\" data-kid=\"1-3-6-1-2-4\" data-name=\"objective four entry\">\n                        <span class=\"font-ui text-[14px] font-semibold text-[var(--bse-blue)]\" data-kid=\"1-3-6-1-2-4-1\" data-name=\"objective four index\">\n                            04\n                        </span>\n                        <div data-kid=\"1-3-6-1-2-4-2\" data-name=\"objective four text content\">\n                            <h3 class=\"text-[18px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-6-1-2-4-2-1\" data-name=\"objective four title\">\n                                تعزيز روابط الزمالة\n                            </h3>\n                            <p class=\"mt-2 text-[14px] leading-8 text-[var(--bse-muted)]\" data-kid=\"1-3-6-1-2-4-2-2\" data-name=\"objective four description\">\n                                توثيق روابط الود والزمالة بين أعضاء الجمعية.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"grid grid-cols-[54px_1fr] gap-5 border-b border-[var(--bse-line)] py-6\" data-kid=\"1-3-6-1-2-5\" data-name=\"objective five entry\">\n                        <span class=\"font-ui text-[14px] font-semibold text-[var(--bse-blue)]\" data-kid=\"1-3-6-1-2-5-1\" data-name=\"objective five index\">\n                            05\n                        </span>\n                        <div data-kid=\"1-3-6-1-2-5-2\" data-name=\"objective five text content\">\n                            <h3 class=\"text-[18px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-6-1-2-5-2-1\" data-name=\"objective five title\">\n                                توسيع التعاون العلمي والفني\n                            </h3>\n                            <p class=\"mt-2 text-[14px] leading-8 text-[var(--bse-muted)]\" data-kid=\"1-3-6-1-2-5-2-2\" data-name=\"objective five description\">\n                                توطيد التعاون بين مهندسي البحرين وزملائهم عربيًا ودوليًا.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"grid grid-cols-[54px_1fr] gap-5 border-b border-[var(--bse-line)] py-6\" data-kid=\"1-3-6-1-2-6\" data-name=\"objective six entry\">\n                        <span class=\"font-ui text-[14px] font-semibold text-[var(--bse-blue)]\" data-kid=\"1-3-6-1-2-6-1\" data-name=\"objective six index\">\n                            06\n                        </span>\n                        <div data-kid=\"1-3-6-1-2-6-2\" data-name=\"objective six text content\">\n                            <h3 class=\"text-[18px] font-bold text-[var(--bse-navy)]\" data-kid=\"1-3-6-1-2-6-2-1\" data-name=\"objective six title\">\n                                دعم الأبحاث الهندسية\n                            </h3>\n                            <p class=\"mt-2 text-[14px] leading-8 text-[var(--bse-muted)]\" data-kid=\"1-3-6-1-2-6-2-2\" data-name=\"objective six description\">\n                                إجراء وتشجيع الأبحاث عبر النشر والمسابقات والمؤتمرات والمحاضرات والزيارات العلمية.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[var(--bse-teal)] py-20 text-white\" data-kid=\"1-3-7\" data-name=\"contact section\" id=\"contact\">\n            <div class=\"pointer-events-none absolute -right-28 top-1/2 h-[470px] w-[470px] -translate-y-1/2 rounded-full border border-white/10\" data-kid=\"1-3-7-1\" data-name=\"contact decorative ring\">\n            </div>\n            <div class=\"pointer-events-none absolute -right-4 top-1/2 h-[290px] w-[290px] -translate-y-1/2 rounded-full border border-white/15\" data-kid=\"1-3-7-2\" data-name=\"contact decorative ring\">\n            </div>\n            <div class=\"relative mx-auto grid max-w-[1160px] items-end gap-12 px-8 lg:grid-cols-[1.35fr_.65fr]\" data-kid=\"1-3-7-3\" data-name=\"contact content container\">\n                <div data-kid=\"1-3-7-3-1\" data-name=\"contact text content container\">\n                    <div class=\"mb-4 flex items-center gap-3 text-[12px] font-bold text-[var(--bse-blue-soft)]\" data-kid=\"1-3-7-3-1-1\" data-name=\"contact label container\">\n                        <span class=\"h-px w-10 bg-[var(--bse-blue-soft)]\" data-kid=\"1-3-7-3-1-1-1\" data-name=\"contact label line\">\n                        </span>\n                        كن جزءًا من المسيرة\n                    </div>\n                    <h2 class=\"max-w-[640px] text-[38px] font-semibold leading-[1.18] md:text-[48px]\" data-kid=\"1-3-7-3-1-2\" data-name=\"contact headline\">\n                        انضم إلى مجتمع المهندسين\n                    </h2>\n                    <p class=\"mt-5 max-w-[610px] text-[16px] leading-[2] text-white/75\" data-kid=\"1-3-7-3-1-3\" data-name=\"contact description\">\n                        عضوية الجمعية تمنحك حضور الفعاليات، وخصومات الدورات، والوصول إلى شبكة مهنية واسعة داخل البحرين وخارجها.\n                    </p>\n                    <div class=\"mt-8 flex flex-wrap gap-3\" data-kid=\"1-3-7-3-1-4\" data-name=\"contact buttons container\">\n                        <a class=\"rounded-lg bg-white px-5 py-3 text-[14px] font-bold text-[var(--bse-teal)]\" data-kid=\"1-3-7-3-1-4-1\" data-name=\"contact membership button\" href=\"#contact\">\n                            اطلب العضوية\n                        </a>\n                        <a class=\"rounded-lg border border-white/30 px-5 py-3 text-[14px] font-bold text-white\" data-kid=\"1-3-7-3-1-4-2\" data-name=\"contact us button\" href=\"#contact-details\">\n                            تواصل معنا\n                        </a>\n                    </div>\n                </div>\n                <div class=\"border-t border-white/20 pt-6 text-[14px] text-white/75 lg:border-s lg:border-t-0 lg:ps-8\" data-kid=\"1-3-7-3-2\" data-name=\"contact information container\" id=\"contact-details\">\n                    <p class=\"font-bold text-white\" data-kid=\"1-3-7-3-2-1\" data-name=\"association title\">\n                        مبنى جمعية المهندسين البحرينية\n                    </p>\n                    <p class=\"mt-2\" data-kid=\"1-3-7-3-2-2\" data-name=\"address description\">\n                        الجفير، المنامة، مملكة البحرين\n                    </p>\n                    <p class=\"mt-5 font-ui\" data-kid=\"1-3-7-3-2-3\" data-name=\"phone number\">\n                        +973 1772 7100\n                    </p>\n                    <p class=\"mt-2 font-ui\" data-kid=\"1-3-7-3-2-4\" data-name=\"email address\">\n                        info@bse.bh\n                    </p>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[var(--bse-navy-deep)] py-10 text-white\" data-kid=\"1-4\" data-name=\"footer section\">\n        <div class=\"mx-auto flex max-w-[1160px] flex-col items-center justify-between gap-5 px-8 text-center md:flex-row md:text-right\" data-kid=\"1-4-1\" data-name=\"footer content container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-4-1-1\" data-name=\"footer logo container\">\n                <img alt=\"شعار جمعية المهندسين البحرينية\" class=\"h-10 w-10 rounded-full object-cover\" data-kid=\"1-4-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/src/assets/bse-logo.png\"/>\n                <div data-kid=\"1-4-1-1-2\" data-name=\"footer brand name container\">\n                    <p class=\"text-[13px] font-bold\" data-kid=\"1-4-1-1-2-1\" data-name=\"footer brand name\">\n                        جمعية المهندسين البحرينية\n                    </p>\n                    <p class=\"mt-1 text-[11px] text-white/50\" data-kid=\"1-4-1-1-2-2\" data-name=\"footer brand year\">\n                        منذ عام 1972\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[12px] text-white/55\" data-kid=\"1-4-1-2\" data-name=\"footer navigation menu\">\n                <a data-kid=\"1-4-1-2-1\" data-name=\"footer link one\" href=\"#story\">\n                    من نحن\n                </a>\n                <a data-kid=\"1-4-1-2-2\" data-name=\"footer link two\" href=\"#history\">\n                    تاريخ الجمعية\n                </a>\n                <a data-kid=\"1-4-1-2-3\" data-name=\"footer link three\" href=\"#objectives\">\n                    أهدافنا\n                </a>\n                <a data-kid=\"1-4-1-2-4\" data-name=\"footer link four\" href=\"#contact\">\n                    تواصل معنا\n                </a>\n            </div>\n            <p class=\"font-ui text-[11px] text-white/40\" data-kid=\"1-4-1-3\" data-name=\"footer copyright text\">\n                © Bahrain Society of Engineers\n            </p>\n        </div>\n    </footer>\n</div>\n",
