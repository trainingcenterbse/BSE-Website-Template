     <div data-kid=\"1-3-2-2-4-1\" data-name=\"statistic item one\">\n                        <p class=\"text-2xl font-bold text-[#1b1938]\" data-kid=\"1-3-2-2-4-1-1\" data-name=\"statistic value\">\n                            +5000\n                        </p>\n                        <p class=\"mt-1 text-xs text-[#73706d]\" data-kid=\"1-3-2-2-4-1-2\" data-name=\"statistic label\">\n                            عضو\n                        </p>\n                    </div>\n                    <div data-kid=\"1-3-2-2-4-2\" data-name=\"statistic item two\">\n                        <p class=\"text-2xl font-bold text-[#1b1938]\" data-kid=\"1-3-2-2-4-2-1\" data-name=\"statistic value\">\n                            +50\n                        </p>\n                        <p class=\"mt-1 text-xs text-[#73706d]\" data-kid=\"1-3-2-2-4-2-2\" data-name=\"statistic label\">\n                            شريك\n                        </p>\n                    </div>\n                    <div data-kid=\"1-3-2-2-4-3\" data-name=\"statistic item three\">\n                        <p class=\"text-2xl font-bold text-[#1b1938]\" data-kid=\"1-3-2-2-4-3-1\" data-name=\"statistic value\">\n                            +200\n                        </p>\n                        <p class=\"mt-1 text-xs text-[#73706d]\" data-kid=\"1-3-2-2-4-3-2\" data-name=\"statistic label\">\n                            فعالية\n                        </p>\n                    </div>\n                    <div data-kid=\"1-3-2-2-4-4\" data-name=\"statistic item four\">\n                        <p class=\"text-2xl font-bold text-[#1b1938]\" data-kid=\"1-3-2-2-4-4-1\" data-name=\"statistic value\">\n                            1972\n                        </p>\n                        <p class=\"mt-1 text-xs text-[#73706d]\" data-kid=\"1-3-2-2-4-4-2\" data-name=\"statistic label\">\n                            عام التأسيس\n                        </p>\n                    </div>\n                </div>\n