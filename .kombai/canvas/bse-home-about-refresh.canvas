2-2-2-1-1\" data-name=\"media category label\">\n                                    رأي · 8 دقائق\n                                </span>\n                                <h3 class=\"mt-2 text-lg font-bold\" data-kid=\"1-3-6-1-2-2-2-1-2\" data-name=\"media link title\">\n                                    الذكاء الاصطناعي في إدارة الأصول\n                                </h3>\n                                <p class=\"mt-2 text-sm leading-6 text-white/65\" data-kid=\"1-3-6-1-2-2-2-1-3\" data-name=\"media link description\">\n                                    كيف تتحول البيانات إلى قرارات هندسية أدق.\n                                </p>\n                            </div>\n                            <span class=\"text-xl text-[#a9c6ff]\" data-kid=\"1-3-6-1-2-2-2-2\" data-name=\"media link arrow\">\n                                ←\n                            </span>\n                        </a>\n                        <a class=\"flex items-start justify-between gap-6 py-6 text-white no-underline\" data-kid=\"1-3-6-1-2-2-3\" data-name=\"media link three\" href=\"#media\">\n                            <div data-kid=\"1-3-6-1-2-2-3-1\" data-name=\"media link text container\">\n                                <span class=\"text-xs font-bold text-[#a9c6ff]\" data-kid=\"1-3-6-1-2-2-3-1-1\" data-name=\"media category label\">\n                                    تقرير · 5 دقائق\n                                </span>\n                                <h3 class=\"mt-2 text-lg font-bold\" data-kid=\"1-3-6-1-2-2-3-1-2\" data-name=\"media link title\">\n                                    سوق العمل الهندسي في البحرين\n                                </h3>\n                                <p class=\"mt-2 text-sm leading-6 text-white/65\" data-kid=\"1-3-6-1-2-2-3-1-3\" data-name=\"media link description\">\n                                    مؤشرات وفرص للمهندس في المرحلة القادمة.\n                                </p>\n                            </div>\n                            <span class=\"text-xl text-[#a9c6ff]\" data-kid=\"1-3-6-1-2-2-3-2\" data-name=\"media link arrow\">\n                                ←\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"relative overflow-hidden bg-[#1a5bd7] text-white\" data-kid=\"1-3-7\" data-name=\"membership section\" id=\"membership\">\n            <div class=\"absolute -left-16 -top-16 h-72 w-72 rounded-full border border-white/20\" data-kid=\"1-3-7-1\" data-name=\"membership background ring one\">\n            </div>\n            <div class=\"absolute -left-4 -top-4 h-48 w-48 rounded-full border border-white/15\" data-kid=\"1-3-7-2\" data-name=\"membership background ring two\">\n            </div>\n            <div class=\"relative mx-auto flex max-w-[1160px] flex-col items-start justify-between gap-8 px-8 py-16 lg:flex-row lg:items-center lg:py-20\" data-kid=\"1-3-7-3\" data-name=\"membership content container\">\n                <div data-kid=\"1-3-7-3-1\" data-name=\"membership text column\">\n                    <p class=\"text-sm font-bold text-white/70\" data-kid=\"1-3-7-3-1-1\" data-name=\"membership section label\">\n                        05 / عضوية الجمعية\n                    </p>\n                    <h2 class=\"display mt-4 max-w-2xl text-4xl font-bold\" data-kid=\"1-3-7-3-1-2\" data-name=\"membership section title\">\n                        كن جزءًا من مجتمع\n                        <br data-kid=\"1-3-7-3-1-2-1\" data-name=\"membership title break\"/>\n                        يصنع مستقبل البحرين\n                    </h2>\n                    <p class=\"mt-4 max-w-xl text-base leading-8 text-white/80\" data-kid=\"1-3-7-3-1-3\" data-name=\"membership description\">\n                        احصل على حضور الفعاليات، وخصومات الدورات، وشبكة مهنية تمتد داخل البحرين وخارجها.\n                    </p>\n                </div>\n           